/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/gwas Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Example process resources for a large cohort
----------------------------------------------------------------------------------------
    A starting point, not a profile. Copy it, set the numbers to your cluster and pass it
    with `-c large_cohort.config` beside your institutional profile. See "Large cohorts"
    in docs/usage.md for which routes are feasible at biobank scale.

    The figures in the comments come from a scaling study measured on synthetic cohorts of up to
    75,000 samples; every figure for a larger cohort is an extrapolation.
----------------------------------------------------------------------------------------
*/

process {

    // The largest node you can use. Dense-matrix memory is computed from the sample count with a
    // 30 % margin, so at biobank scale it can ask for more than any node has; the limit trims every
    // request to what the node offers instead of leaving the task unschedulable.
    resourceLimits = [
        cpus: 64,
        memory: 900.GB,
        time: 14.d,
    ]

    // Dense REML time grows roughly as N^3: GCTA REML took 24 minutes at 25,000 samples and
    // extrapolates to about a day at 100,000. The labels give these steps 16 hours; a subsample near
    // the memory limit needs days. Memory is left to the pipeline's own N-based requests.
    withName: 'GCTA_MAKEGRMPART|GCTA_REML|GCTA_REMLLDMS|GCTA_BIVARIATEREML|GCTA_BIVARIATEREMLLDMS|LDAK_CALCKINS|LDAK_REML|LDAK_HE|LDAK_PCGC|LDAK_ADJUSTGRM|MPH_MAKEGRM|MPH_REML' {
        time = { 7.d * task.attempt }
    }

    // fastGWA memory grows with samples times variants: about 5-6 GB at 400,000-500,000 samples and
    // 0.5M array variants, but 94-117 GB at 10M imputed variants (extrapolated). Raise it only for an
    // imputed-scale run; supply the sparse GRM through `gcta.sparse_grm` either way.
    withName: 'GCTA_FASTGWA' {
        memory = { 128.GB * task.attempt }
    }
}
