/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

params {
    modules_testdata_base_path   = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    // Identical to the pipeline default. The test-datasets branch segment belongs here, in the base
    // path, and `conf/test.config` appends only the path within that branch. Setting a different
    // branch-qualified value here while `conf/test.config` also prepended the branch produced a URL
    // with the branch segment twice, which resolved only by evaluation order.
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/gwas/'
}

process {
    // LDAK-KVIK estimates stochastic model components. Keep every nf-test content snapshot stable;
    // production runs remain unseeded unless a researcher supplies this native option themselves.
    withName: 'LDAK_KVIKSTEP1|LDAK_KVIKSTEP2' {
        ext.args = [
            '--mpheno 1',
            '--random-seed 7',
        ].join(' ').trim()
    }

    // LDAK-PCGC estimates standard errors using a stochastic step. Use the same test-only seed
    // policy as KVIK so broad output snapshots are reproducible; production remains unseeded.
    withName: '.*:LDAK_PCGC' {
        ext.args = [
            '--mpheno 1',
            '--random-seed 7',
        ].join(' ').trim()
    }

    // LDAK-HE also uses a stochastic jackknife for standard errors. Pin it for content snapshots;
    // the production configuration remains unseeded.
    withName: '.*:LDAK_HE' {
        ext.args = [
            '--mpheno 1',
            '--random-seed 7',
        ].join(' ').trim()
    }

    // The compact fixture is too small to estimate all four LDMS variance components under GCTA's
    // non-negative constraint. Relax it for the static `example_cohort` analyses that exercise the
    // documented default topology, while preserving any explicit structured `reml_no_constrain` option
    // used by other fixture cohorts. Production runs receive only the structured option from
    // `conf/modules/gcta.config`.
    withName: '.*:GRM_HERITABILITY_GCTA:GCTA_REMLLDMS' {
        ext.args = {
            [
                '--mpheno 1',
                meta.cohort == 'example_cohort' || meta.method_options.gcta.reml_no_constrain ? '--reml-no-constrain' : '',
                meta.is_binary && meta.population_prevalence != null ? "--prevalence ${meta.population_prevalence}" : '',
            ].join(' ').trim()
        }
    }
}

aws.client.anonymous = true
