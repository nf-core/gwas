/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

params {
    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    // Identical to the pipeline default. The test-datasets branch segment belongs here, in the base
    // path, and `conf/test.config` appends only the path within that branch. Setting a different
    // branch-qualified value here while `conf/test.config` also prepended the branch produced a URL
    // with the branch segment twice, which resolved only by evaluation order.
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/gwas/'
}

process {
    // Focused tests may replace the atom-owned immutable runtime through LDSC_TEST_CONTAINER; the default
    // remains the same immutable production manifest.
    withName: 'LDSC_MUNGESUMSTATS|LDSC_H2|LDSC_RG' {
        container = System.getenv('LDSC_TEST_CONTAINER') ?: 'ghcr.io/lyh970817/gwas/ldsc:3.0.2-cbiit-6c67395@sha256:77fbb697c16a559c3fe75204b1e7ab6a0202afcf10b8a8629bcc98592b0e412b'
    }

    // LDAK-KVIK estimates stochastic model components. Keep every nf-test content snapshot stable;
    // production runs remain unseeded unless a researcher supplies this native option themselves.
    withName: 'LDAK_KVIKSTEP1|LDAK_KVIKSTEP2' {
        ext.args = [
            '--mpheno 1',
            '--random-seed 7',
        ].join(' ').trim()
    }

    // LDAK-PCGC resamples its jackknife, so its standard error moves between two otherwise identical
    // unseeded runs while its point estimate does not. Measured on the pinned image in the pipeline's own
    // invocation shape: three unseeded runs gave Her_All 0.299287 every time with SE 0.383315, 0.387150 and
    // 0.383889. Three runs at `--random-seed 7` were byte-identical, and seeds 7 and 8 differed. The seed is
    // therefore load-bearing for any content snapshot of this process; production remains unseeded.
    withName: '.*:LDAK_PCGC' {
        ext.args = [
            '--mpheno 1',
            '--random-seed 7',
        ].join(' ').trim()
    }

    // LDAK-HE behaves the same way, and was measured the same way: after `--adjust-grm`, three unseeded runs
    // held Her_All at 0.116356 while the SE moved across 0.181481, 0.181371 and 0.181956, and three seeded
    // runs were byte-identical. Note the log line reads "leave-one-sample-out jackknifing", which describes
    // the block scheme rather than promising determinism -- do not read it as a reason to drop this seed.
    withName: '.*:LDAK_HE' {
        ext.args = [
            '--mpheno 1',
            '--random-seed 7',
        ].join(' ').trim()
    }

    // Focused tests may replace the atom-owned immutable runtime.
    withName: METASOFT_RE2 {
        container = System.getenv('METASOFT_TEST_CONTAINER') ?: 'ghcr.io/lyh970817/gwas/metasoft@sha256:13c0275d393111daf53ba8e6bfa787627eec6facc7c3b8e4879784497745f073'
    }

    // Focused tests may replace the atom-owned immutable runtime through MPH_TEST_CONTAINER; the default
    // remains the same immutable production manifest. Only the runtime is overridden here: the thread count
    // moves an MPH estimate in its sixth to seventh significant digit, so it is left to the profile's own
    // resource limits rather than pinned to a value a production run would not use.
    withName: 'MPH_MAKEGRM|MPH_REML' {
        container = System.getenv('MPH_TEST_CONTAINER') ?: 'ghcr.io/lyh970817/gwas/mph@sha256:c471ae7132e961bf401dd3db177d4c0c1c6cfdf0fc8306db1dcaac5b85a6c3e7'
    }

    // Focused tests may replace the atom-owned immutable runtime; the default remains the same immutable
    // production manifest.
    withName: 'LDAK_SUMHER|LDAK_SUMCORS' {
        container = System.getenv('LDAK_TEST_CONTAINER') ?: 'ghcr.io/lyh970817/gwas/ldak@sha256:a0699bb7637ef2ba20c37fc6ef46b9533c78e68a022d770478a2fbb938e10a00'
        cpus = 2
        memory = 2.GB
    }

    // The compact fixture is too small to estimate all four LDMS variance components under GCTA's
    // non-negative constraint. Relax it for the static `example_cohort` analyses that exercise the
    // documented default topology, while preserving any explicit structured `reml_no_constrain` option
    // used by other fixture cohorts. Production runs receive only the structured option from
    // `conf/modules/gcta.config`.
    withName: '.*:GRM_HERITABILITY_GCTA:GCTA_REMLLDMS' {
        ext.args = {
            [
                '--mpheno 1',
                meta.cohort == 'example_cohort' || meta.method_options.gcta.reml_no_constrain ? '--reml-no-constrain' : '',
                meta.is_binary && meta.population_prevalence != null ? "--prevalence ${meta.population_prevalence}" : '',
            ].join(' ').trim()
        }
    }
}

aws.client.anonymous = true

// Every test case is a separate `nextflow run`, and the pipeline enables `timeline`, `report`, `trace` and
// `dag` outside any profile, so `-profile` cannot escape them: each case renders all four into an `outdir`
// no assertion reads. The three renderers are turned off here. `trace` is deliberately left alone — nf-test
// passes its own `-with-trace <meta>/trace.csv` on every launch and parses that file to back
// `workflow.trace`, which `tests/heritability_ldak_fast_estimators.nf.test` asserts against.
timeline.enabled = false
report.enabled = false
dag.enabled = false
