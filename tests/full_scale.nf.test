nextflow_pipeline {

    name "Test full-scale profile"
    script "../main.nf"
    profile "test_full"
    tag "pipeline"
    tag "full_scale"

    // The profile owns its complete fixture-backed samplesheet; only the output directory is a
    // per-test concern. This is the same configuration boundary a researcher invokes directly.
    test("-profile test_full exercises every release route on the multi-chromosome fixture") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            def association = new File("${params.outdir}/association")
            def heritability = new File("${params.outdir}/heritability/individual")
            def summary_statistics = new File("${params.outdir}/summary_statistics")
            def versions = new File("${params.outdir}/pipeline_info/nf_core_gwas_software_mqc_versions.yml")
            def multiqc_report = new File("${params.outdir}/multiqc/multiqc_report.html")
            def stable_name_association = getAllFilesFromDir(
                association.toString(),
                relative: true,
                includeDir: true,
            ).findAll { path -> path.toString() }
            def stable_name_heritability = getAllFilesFromDir(
                heritability.toString(),
                relative: true,
                includeDir: true,
            ).findAll { path -> path.toString() }
            def stable_name_summary_statistics = getAllFilesFromDir(
                summary_statistics.toString(),
                relative: true,
                includeDir: true,
            ).findAll { path -> path.toString() }
            def stable_path_association = getAllFilesFromDir(
                association.toString(),
                ignoreFile: 'tests/.nftignore',
            )
            def stable_path_heritability = getAllFilesFromDir(
                heritability.toString(),
                ignoreFile: 'tests/.nftignore',
            )
            def stable_path_summary_statistics = getAllFilesFromDir(
                summary_statistics.toString(),
                ignoreFile: 'tests/.nftignore',
            )
            def input_pvar = null
            new File(new File(outputDir.toString()).parentFile, 'work').eachFileRecurse { entry ->
                if (input_pvar == null && entry.isFile() && entry.name == 'example_all.pvar') {
                    input_pvar = entry
                }
            }
            def chromosomes = input_pvar
                .readLines()
                .findAll { line -> line && !line.startsWith('#') }
                .collect { line -> line.tokenize().first() }
                .toSet()
            assertAll(
                { assert workflow.success },
                { assert chromosomes == (1..22).collect { chromosome -> chromosome.toString() }.toSet() },
                { assert association.list().toList().sort() == ['gcta_fastgwa', 'ldak_kvik', 'plink2', 'regenie'] },
                { assert heritability.list().toList().sort() == ['gcta_greml', 'gcta_greml_ldms', 'ldak_he', 'ldak_pcgc', 'ldak_reml'] },
                { assert TRACE.count(workflow, 'PLINK2_GLM') == 2 },
                { assert TRACE.count(workflow, 'REGENIE_STEP2') == 1 },
                { assert TRACE.count(workflow, 'GCTA_FASTGWA') == 1 },
                { assert TRACE.count(workflow, 'LDAK_KVIKSTEP2') == 1 },
                { assert TRACE.count(workflow, 'GWASLAB_HARMONIZE') == 5 },
                { assert TRACE.count(workflow, 'GCTA_REML') == 1 },
                { assert TRACE.count(workflow, 'GCTA_REMLLDMS') == 1 },
                { assert TRACE.count(workflow, 'LDAK_REML') == 1 },
                { assert TRACE.count(workflow, 'LDAK_HE') == 1 },
                { assert TRACE.count(workflow, 'LDAK_PCGC') == 1 },
                { assert multiqc_report.text.contains('Association testing was performed with PLINK 2 (Chang <em>et al.</em>, 2015), REGENIE (Mbatchou <em>et al.</em>, 2021), GCTA fastGWA (Jiang <em>et al.</em>, 2019), and LDAK-KVIK (Hof and Speed, 2025).') },
                { assert multiqc_report.text.contains('SNP-based heritability was estimated with GCTA GREML (Yang <em>et al.</em>, 2011), GCTA GREML-LDMS (Yang <em>et al.</em>, 2015), and LDAK (Speed <em>et al.</em>, 2012).') },
                { assert multiqc_report.text.count('https://doi.org/10.1038/ng.3390') == 1 },
                { assert multiqc_report.text.count('https://doi.org/10.1038/s41588-019-0530-8') == 1 },
                { assert multiqc_report.text.count('https://doi.org/10.1016/j.ajhg.2012.10.010') == 1 },
                { assert !new File("${params.outdir}/genotypes").exists() },
                { assert !new File("${params.outdir}/phenotypes").exists() },
                { assert !new File("${params.outdir}/quality_control/relatedness_matrices").exists() },
                { assert snapshot(removeNextflowVersion(versions.toString())).match('versions') },
                { assert snapshot(stable_name_association, stable_path_association).match('association') },
                { assert snapshot(stable_name_heritability, stable_path_heritability).match('heritability') },
                { assert snapshot(stable_name_summary_statistics, stable_path_summary_statistics).match('summary_statistics') },
            )
        }
    }
}
