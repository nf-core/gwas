nextflow_pipeline {

    name "Test linked cohort and analysis manifests"
    script "../main.nf"
    tag "pipeline"
    tag "input"
    tag "relational"
    tag "plink2"

    test("linked analyses preserve identity through PLINK 2 native and harmonised outputs") {

        when {
            params {
                outdir = "$outputDir"
                cohort_manifest = RELATIONAL.cohorts(projectDir, outputDir, "plink2_trait_semantics")
                analysis_manifest = RELATIONAL.analyses(projectDir, outputDir, "plink2_trait_semantics", { rows ->
                    def binary = RELATIONAL.analysis(projectDir, 'example_pgen_bt')
                    def quantitativeWithoutCovariates = new LinkedHashMap(rows[0])
                    quantitativeWithoutCovariates.analysis_id = 'example_pgen_qt_no_covariates'
                    quantitativeWithoutCovariates.quant_covariates = ''
                    quantitativeWithoutCovariates.cat_covariates = ''
                    def binaryWithoutCovariates = new LinkedHashMap(binary)
                    binaryWithoutCovariates.analysis_id = 'example_pgen_bt_no_covariates'
                    binaryWithoutCovariates.quant_covariates = ''
                    binaryWithoutCovariates.cat_covariates = ''
                    rows.addAll([binary, quantitativeWithoutCovariates, binaryWithoutCovariates])
                })
            }
        }

        then {
            def analysisIds = [
                'example_pgen_bt',
                'example_pgen_bt_no_covariates',
                'example_pgen_qt',
                'example_pgen_qt_no_covariates',
            ]
            def plink2 = new File("${params.outdir}/association/plink2")
            def harmonised = new File("${params.outdir}/summary_statistics")
            def versions = new File("${params.outdir}/pipeline_info/nf_core_gwas_software_mqc_versions.yml")
            def stable_name_association = getAllFilesFromDir(
                "${params.outdir}/association",
                relative: true,
                includeDir: true,
            ).findAll { path -> path.toString() }
            def stable_path_association = getAllFilesFromDir(
                "${params.outdir}/association",
                ignoreFile: 'tests/.nftignore',
            )
            assertAll(
                { assert workflow.success },
                { assert TRACE.tags(workflow, 'NORMALISE_PHENOTYPES').sort() == analysisIds },
                { assert TRACE.count(workflow, 'NORMALISE_PHENOTYPES') == analysisIds.size() },
                { assert TRACE.count(workflow, 'PLINK2_GLM') == analysisIds.size() },
                { assert TRACE.tags(workflow, 'GWASLAB_HARMONIZE').sort() == analysisIds.collect { id -> "${id}--plink2" }.sort() },
                { assert plink2.list().toList().sort() == analysisIds },
                { assert harmonised.list().toList().sort() == analysisIds.collect { id -> "${id}--plink2" }.sort() },
                { assert analysisIds.every { id -> new File(harmonised, "${id}--plink2/${id}--plink2.canonical.tsv.gz").exists() } },
                { assert snapshot(stable_name_association, stable_path_association).match('association') },
                { assert snapshot(removeNextflowVersion(versions.toString())).match('versions') },
            )
        }
    }

    def invalidAnalysisScenarios = [
        [
            name: "binary analysis without a case source code",
            fixture: "binary_without_case",
            source: "example_pgen_bt",
            mutate: { row -> row.case_value = '' },
            field: "field 'case_value'",
            message: "must declare the value used for cases",
        ],
        [
            name: "binary analysis without a control source code",
            fixture: "binary_without_control",
            source: "example_pgen_bt",
            mutate: { row -> row.control_value = '' },
            field: "field 'control_value'",
            message: "must declare the value used for controls",
        ],
        [
            name: "binary analysis with identical case and control source codes",
            fixture: "binary_identical_codes",
            source: "example_pgen_bt",
            mutate: { row -> row.case_value = row.control_value },
            field: "fields 'case_value', 'control_value'",
            message: "must be distinct",
        ],
        [
            name: "quantitative analysis with a case source code",
            fixture: "quantitative_with_case",
            mutate: { row -> row.case_value = '2' },
            field: "field 'case_value'",
            message: "no meaning on a quantitative trait",
        ],
        [
            name: "quantitative analysis with a control source code",
            fixture: "quantitative_with_control",
            mutate: { row -> row.control_value = '1' },
            field: "field 'control_value'",
            message: "no meaning on a quantitative trait",
        ],
        [
            name: "quantitative analysis with population prevalence",
            fixture: "quantitative_with_prevalence",
            mutate: { row -> row.population_prevalence = '0.3' },
            field: "field 'population_prevalence'",
            message: "no meaning on a quantitative trait",
        ],
        [
            name: "analysis selecting no method",
            fixture: "analysis_without_method",
            mutate: { row ->
                row.association_methods = ''
                row.heritability_methods = ''
            },
            field: "fields 'association_methods', 'heritability_methods'",
            message: "row selects no method",
        ],
        [
            name: "analysis selecting an unknown association method",
            fixture: "unknown_association_method",
            mutate: { row -> row.association_methods = 'plink3' },
            field: "field 'association_methods'",
            message: "unknown method 'plink3'",
            accepted: "accepted values are 'plink2', 'regenie', 'gcta_fastgwa', 'ldak_kvik'",
        ],
        [
            name: "analysis selecting an unknown heritability method",
            fixture: "unknown_heritability_method",
            mutate: { row ->
                row.association_methods = ''
                row.heritability_methods = 'greml3'
            },
            field: "field 'heritability_methods'",
            message: "unknown method 'greml3'",
            accepted: "accepted values are 'gcta_greml', 'gcta_greml_ldms', 'ldak_reml', 'ldak_he', 'ldak_pcgc'",
        ],
        [
            name: "analysis repeating an association method",
            fixture: "duplicate_association_method",
            mutate: { row -> row.association_methods = 'plink2,plink2' },
            field: "field 'association_methods'",
            message: "method 'plink2' listed more than once",
        ],
        [
            name: "analysis repeating a heritability method",
            fixture: "duplicate_heritability_method",
            mutate: { row ->
                row.association_methods = ''
                row.heritability_methods = 'gcta_greml,gcta_greml'
            },
            field: "field 'heritability_methods'",
            message: "method 'gcta_greml' listed more than once",
        ],
        [
            name: "PCGC analysis without required population prevalence",
            fixture: "pcgc_without_prevalence",
            source: "example_pgen_bt",
            mutate: { row -> row.heritability_methods = 'ldak_pcgc' },
            field: "field 'population_prevalence'",
            message: "'ldak_pcgc' always estimates on the liability scale and requires a population prevalence",
        ],
        [
            name: "binary PLINK 2 analysis with unconsumed population prevalence",
            fixture: "plink2_with_prevalence",
            source: "example_pgen_bt",
            mutate: { row -> row.population_prevalence = '0.3' },
            field: "field 'population_prevalence'",
            message: "none of the selected estimators consumes it",
        ],
    ]

    invalidAnalysisScenarios.each { scenario ->
        test(scenario.name) {

            when {
                params {
                    outdir = "$outputDir"
                    cohort_manifest = RELATIONAL.cohorts(projectDir, outputDir, scenario.fixture)
                    analysis_manifest = RELATIONAL.analyses(projectDir, outputDir, scenario.fixture, { rows ->
                        rows.clear()
                        rows << RELATIONAL.analysis(projectDir, scenario.source ?: 'example_pgen_qt')
                        scenario.mutate(rows[0])
                    })
                }
            }

            then {
                def report = VALIDATION.report(outputDir, workflow.stdout)
                assertAll(
                    { assert !workflow.success },
                    { assert report.contains(params.analysis_manifest.toString()) },
                    { assert report.contains("row 2 (analysis_id '${scenario.source ?: 'example_pgen_qt'}')") },
                    { assert report.contains(scenario.field) },
                    { assert report.contains(scenario.message) },
                    { assert !scenario.accepted || report.contains(scenario.accepted) },
                    { assert TRACE.count(workflow, 'NORMALISE_PHENOTYPES') == 0 },
                )
            }
        }
    }

    test("sample prevalence is rejected for a quantitative analysis") {

        when {
            params {
                outdir = "$outputDir"
                cohort_manifest = RELATIONAL.cohorts(projectDir, outputDir, "quantitative_sample_prevalence")
                analysis_manifest = RELATIONAL.analyses(projectDir, outputDir, "quantitative_sample_prevalence", { rows ->
                    rows[0].sample_prevalence = 0.4
                })
            }
        }

        then {
            def report = VALIDATION.report(outputDir, workflow.stdout)
            assertAll(
                { assert !workflow.success },
                { assert report.contains(params.analysis_manifest.toString()) },
                { assert report.contains("row 2 (analysis_id 'example_pgen_qt')") },
                { assert report.contains("field 'sample_prevalence'") },
                { assert report.contains('sample prevalence has no meaning on a quantitative trait') },
                { assert TRACE.count(workflow, 'NORMALISE_PHENOTYPES') == 0 },
            )
        }
    }

    test("an analysis naming an undefined cohort fails before task submission") {

        when {
            params {
                outdir = "$outputDir"
                cohort_manifest = RELATIONAL.cohorts(projectDir, outputDir, "undefined_cohort")
                analysis_manifest = RELATIONAL.analyses(projectDir, outputDir, "undefined_cohort", { rows ->
                    rows[0].cohort_id = 'missing_cohort'
                })
            }
        }

        then {
            def report = VALIDATION.report(outputDir, workflow.stdout)
            assertAll(
                { assert !workflow.success },
                { assert report.contains(params.analysis_manifest.toString()) },
                { assert report.contains("row 2 (analysis_id 'example_pgen_qt')") },
                { assert report.contains("field 'cohort_id'") },
                { assert report.contains("undefined cohort_id 'missing_cohort'") },
                { assert TRACE.count(workflow, 'NORMALISE_PHENOTYPES') == 0 },
            )
        }
    }

    test("an identical duplicate cohort definition fails before task submission") {

        when {
            params {
                outdir = "$outputDir"
                cohort_manifest = RELATIONAL.cohorts(projectDir, outputDir, "duplicate_cohort", { rows ->
                    rows << new LinkedHashMap(rows[0])
                })
                analysis_manifest = RELATIONAL.analyses(projectDir, outputDir, "duplicate_cohort")
            }
        }

        then {
            def report = VALIDATION.report(outputDir, workflow.stdout)
            assertAll(
                { assert !workflow.success },
                { assert report.contains(params.cohort_manifest.toString()) },
                { assert report.contains("row 3 (cohort_id 'example_pgen')") },
                { assert report.contains("field 'cohort_id'") },
                { assert report.contains("duplicate cohort_id 'example_pgen'") },
                { assert report.contains('identical definition on row 2') },
                { assert TRACE.count(workflow, 'NORMALISE_PHENOTYPES') == 0 },
            )
        }
    }

    test("a duplicate analysis identity fails before task submission") {

        when {
            params {
                outdir = "$outputDir"
                cohort_manifest = RELATIONAL.cohorts(projectDir, outputDir, "duplicate_analysis")
                analysis_manifest = RELATIONAL.analyses(projectDir, outputDir, "duplicate_analysis", { rows ->
                    def duplicate = new LinkedHashMap(rows[0])
                    duplicate.trait_id = 'QT2'
                    rows << duplicate
                })
            }
        }

        then {
            def report = VALIDATION.report(outputDir, workflow.stdout)
            assertAll(
                { assert !workflow.success },
                { assert report.contains(params.analysis_manifest.toString()) },
                { assert report.contains("row 3 (analysis_id 'example_pgen_qt')") },
                { assert report.contains("field 'analysis_id'") },
                { assert report.contains("duplicate analysis_id 'example_pgen_qt', already declared on row 2") },
                { assert TRACE.count(workflow, 'NORMALISE_PHENOTYPES') == 0 },
            )
        }
    }

    test("a cohort manifest without an analysis manifest is rejected") {
        tag "manifest_pairing"

        when {
            params {
                outdir = "$outputDir"
                cohort_manifest = RELATIONAL.cohorts(projectDir, outputDir, "cohort_only")
                analysis_manifest = null
            }
        }

        then {
            def report = VALIDATION.report(outputDir, workflow.stdout)
            assertAll(
                { assert !workflow.success },
                { assert report.contains('--analysis_manifest is missing; linked manifests require both') },
                { assert TRACE.count(workflow, 'NORMALISE_PHENOTYPES') == 0 },
            )
        }
    }

    test("an analysis manifest without a cohort manifest is rejected") {
        tag "manifest_pairing"

        when {
            params {
                outdir = "$outputDir"
                analysis_manifest = RELATIONAL.analyses(projectDir, outputDir, "analysis_only")
                cohort_manifest = null
            }
        }

        then {
            def report = VALIDATION.report(outputDir, workflow.stdout)
            assertAll(
                { assert !workflow.success },
                { assert report.contains('--analysis_manifest') },
                { assert report.contains('--cohort_manifest is missing; linked manifests require both') },
                { assert TRACE.count(workflow, 'NORMALISE_PHENOTYPES') == 0 },
            )
        }
    }

}
