nextflow_pipeline {

    name "Test LDAK HE and PCGC heritability routes"
    script "../main.nf"
    tag "pipeline"
    tag "heritability"
    tag "ldak"

    def commands = { outputDir ->
        def scripts = []
        new File(new File(outputDir.toString()).parentFile, 'work').eachFileRecurse { entry ->
            if (entry.isFile() && entry.name == '.command.sh') {
                scripts << entry.text
            }
        }
        return scripts
    }

    def inputs = { output_dir, project_dir ->
        def analyses = RELATIONAL.analyses(project_dir, output_dir, 'ldak_estimators', { rows ->
            rows[0].analysis_id = 'ldak_he_plain'
            rows[0].quant_covariates = ''
            rows[0].cat_covariates = ''
            rows[0].association_methods = ''
            rows[0].heritability_methods = 'ldak_he'
            def adjusted = RELATIONAL.analysis(project_dir, 'example_pgen_bt')
            adjusted.analysis_id = 'ldak_all_covariates'
            adjusted.association_methods = ''
            adjusted.heritability_methods = 'ldak_reml,ldak_he,ldak_pcgc'
            adjusted.population_prevalence = '0.3'
            rows << adjusted
        })
        return [
            cohort: RELATIONAL.cohorts(project_dir, output_dir, 'ldak_estimators'),
            analysis: analyses,
            options: RELATIONAL.methodOptions(output_dir, 'ldak_estimators', [
                ldak_he_plain: [ldak: [model: 'human_default', power: -0.25, relatedness_filter: false]],
                ldak_all_covariates: [ldak: [model: 'human_default', power: -0.25, relatedness_filter: false]],
            ]),
        ]
    }

    test("LDAK estimators publish independently and adjust matrices only for covariate-bearing analyses") {

        config "../conf/test_ldak_estimators.config"
        tag "ldak_estimators"

        when {
            params {
                outdir = "$outputDir"
                def linked = inputs(outputDir, projectDir)
                cohort_manifest = linked.cohort
                analysis_manifest = linked.analysis
                method_options = linked.options
                save_relatedness_matrices = true
            }
        }

        then {
            def individual = new File("${params.outdir}/heritability/individual")
            def hePlain = new File(individual, 'ldak_he/ldak_he_plain/ldak_he_plain.ldak_he.he')
            def heAdjusted = new File(individual, 'ldak_he/ldak_all_covariates/ldak_all_covariates.ldak_he.he')
            def pcgc = new File(individual, 'ldak_pcgc/ldak_all_covariates/ldak_all_covariates.ldak_pcgc.pcgc')
            def reml = new File(individual, 'ldak_reml/ldak_all_covariates/ldak_all_covariates.ldak_reml.reml')
            def matrices = new File("${params.outdir}/quality_control/relatedness_matrices")
            def matrixArtifacts = matrices.listFiles().toList()
            def adjustedArtifacts = matrixArtifacts.findAll { artifact ->
                artifact.listFiles().any { file -> file.name.endsWith('.grm.root') }
            }
            def versions = new File("${params.outdir}/pipeline_info/nf_core_gwas_software_mqc_versions.yml")
            assertAll(
                { assert workflow.success },
                { assert TRACE.count(workflow, 'LDAK_CALCKINS') == 1 },
                { assert TRACE.count(workflow, 'LDAK_ADJUSTGRM') == 1 },
                { assert TRACE.count(workflow, 'LDAK_HE') == 2 },
                { assert TRACE.count(workflow, 'LDAK_PCGC') == 1 },
                { assert TRACE.count(workflow, 'LDAK_REML') == 1 },
                { assert individual.list().toList().sort() == ['ldak_he', 'ldak_pcgc', 'ldak_reml'] },
                { assert hePlain.isFile() },
                { assert heAdjusted.isFile() },
                { assert pcgc.isFile() },
                { assert reml.isFile() },
                // One base and one adjusted child publish once each, independent of the HE/PCGC fan-out.
                { assert matrixArtifacts.size() == 2 },
                { assert adjustedArtifacts.size() == 1 },
                { assert adjustedArtifacts.first().list().toList().count { name -> name.endsWith('.grm.root') } == 1 },
            )
            def runCommands = commands(params.outdir)
            def adjustmentCommands = runCommands.findAll { command -> command.contains('ldak6 --adjust-grm') }
            def adjustedEstimatorCommands = runCommands.findAll { command ->
                (command.contains('ldak6 --he') || command.contains('ldak6 --pcgc')) &&
                    command.contains('--grm "ldak_adjusted.')
            }
            def stableName = getAllFilesFromDir(
                individual.toString(),
                relative: true,
                includeDir: true,
            ).findAll { path -> path.toString() }
            def stablePath = getAllFilesFromDir(
                individual.toString(),
                ignoreFile: 'tests/.nftignore',
            )
            assertAll(
                { assert adjustmentCommands.size() == 1 },
                { assert adjustmentCommands.every { command -> command.contains('--covar "ldak_all_covariates.adjustcovar"') } },
                { assert adjustmentCommands.every { command -> !command.contains('--factors ') } },
                { assert adjustedEstimatorCommands.size() == 2 },
                { assert adjustedEstimatorCommands.every { command -> command.contains('--covar "ldak_all_covariates.adjustcovar"') } },
                { assert adjustedEstimatorCommands.every { command -> !command.contains('--factors ') } },
                { assert snapshot(removeNextflowVersion(versions.toString())).match('versions') },
                { assert snapshot(stableName, stablePath).match('heritability') },
            )
        }
    }

    test("adjustment-child identity controls resume without rebuilding its LDAK parent") {

        config "../conf/test_ldak_estimators.config"
        tag "ldak_adjustment_resume"

        when {
            params {
                outdir = "$outputDir"
                cohort_manifest = RELATIONAL.cohorts(projectDir, outputDir, 'ldak_adjustment_resume')
                analysis_manifest = RELATIONAL.analyses(projectDir, outputDir, 'ldak_adjustment_resume', { rows ->
                    rows.clear()
                    def analysis = RELATIONAL.analysis(projectDir, 'example_pgen_bt')
                    analysis.analysis_id = 'adjustment_resume'
                    analysis.association_methods = ''
                    analysis.heritability_methods = 'ldak_he,ldak_pcgc'
                    analysis.population_prevalence = '0.3'
                    rows << analysis
                })
            }
        }

        then {
            def unchangedTrace = RESUME.rerun(outputDir, [:])
            def fixtureRoot = new File(FIXTURES.base(projectDir).toString())
            def originalCovariates = new File(fixtureRoot, 'results/fixtures/pheno_cov/example.qcovar')
            def changedCovariates = RELATIONAL.resource(
                outputDir,
                'adjustment-resume-changed.qcovar',
                originalCovariates.text.replaceFirst('S001\\tS001\\t30\\t', 'S001\tS001\t31\t'),
            )
            def changedManifest = RELATIONAL.analyses(projectDir, outputDir, 'ldak_adjustment_resume_changed', { rows ->
                rows.clear()
                def analysis = RELATIONAL.analysis(projectDir, 'example_pgen_bt')
                analysis.analysis_id = 'adjustment_resume'
                analysis.association_methods = ''
                analysis.heritability_methods = 'ldak_he,ldak_pcgc'
                analysis.population_prevalence = '0.3'
                analysis.quant_covariates = changedCovariates
                rows << analysis
            })
            def changedTrace = RESUME.rerun(outputDir, [analysis_manifest: changedManifest])
            def individual = new File(params.outdir.toString(), 'heritability/individual')
            assertAll(
                { assert workflow.success },
                { assert RESUME.statuses(unchangedTrace, 'LDAK_CALCKINS') == ['CACHED'] },
                { assert RESUME.statuses(unchangedTrace, 'LDAK_ADJUSTGRM') == ['CACHED'] },
                { assert RESUME.statuses(unchangedTrace, 'LDAK_HE') == ['CACHED'] },
                { assert RESUME.statuses(unchangedTrace, 'LDAK_PCGC') == ['CACHED'] },
                { assert RESUME.statuses(changedTrace, 'LDAK_CALCKINS') == ['CACHED'] },
                { assert RESUME.statuses(changedTrace, 'LDAK_ADJUSTGRM') == ['COMPLETED'] },
                { assert RESUME.statuses(changedTrace, 'LDAK_HE') == ['COMPLETED'] },
                { assert RESUME.statuses(changedTrace, 'LDAK_PCGC') == ['COMPLETED'] },
                { assert RESUME.tasks(changedTrace, 'LDAK_ADJUSTGRM').size() == 1 },
                { assert RESUME.tasks(changedTrace, 'LDAK_HE').size() == 1 },
                { assert RESUME.tasks(changedTrace, 'LDAK_PCGC').size() == 1 },
                { assert new File(individual, 'ldak_he/adjustment_resume/adjustment_resume.ldak_he.he').isFile() },
                { assert new File(individual, 'ldak_pcgc/adjustment_resume/adjustment_resume.ldak_pcgc.pcgc').isFile() },
            )
        }
    }
}
