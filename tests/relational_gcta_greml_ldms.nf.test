nextflow_pipeline {

    name "Test relational GCTA GREML-LDMS method configuration"
    script "../main.nf"
    tag "pipeline"
    tag "relational"
    tag "heritability"
    tag "gcta"
    tag "gcta_greml_ldms"

    test("linked quantitative and binary analyses use compact LDMS settings and retain trait identity") {
        when {
            params {
                outdir = "$outputDir"
                cohort_manifest = RELATIONAL.cohorts(projectDir, outputDir, 'gcta_greml_ldms_defaults')
                analysis_manifest = RELATIONAL.analyses(projectDir, outputDir, 'gcta_greml_ldms_defaults', { rows ->
                    def binary = RELATIONAL.analysis(projectDir, 'example_pgen_bt')
                    binary.population_prevalence = 0.1
                    rows << binary
                    rows.each { row ->
                        row.association_methods = ''
                        row.heritability_methods = 'gcta_greml_ldms'
                    }
                })
                // Production LDMS defaults define many variance components. The compact execution fixture
                // uses one populated all-MAF stratum here; focused LDMS coverage below proves multi-stratum
                // construction separately without asking REML to fit nine components from 200 samples.
                method_options = RELATIONAL.methodOptions(outputDir, 'gcta_greml_ldms_defaults', [
                    example_pgen_qt: [gcta: [
                        ld_score_region_kb: 50,
                        ld_bins: 1,
                        ldms_maf_edges: [0, 0.5],
                    ]],
                    example_pgen_bt: [gcta: [
                        ld_score_region_kb: 50,
                        ld_bins: 1,
                        ldms_maf_edges: [0, 0.5],
                    ]],
                ])
                gcta_grm_parts = 1
            }
        }

        then {
            def root = new File("${params.outdir}/heritability/individual/gcta_greml_ldms")
            def binary = new File(root, 'example_pgen_bt/example_pgen_bt.gcta_greml_ldms.hsq').text
            def quantitative = new File(root, 'example_pgen_qt/example_pgen_qt.gcta_greml_ldms.hsq').text
            def stableNameHeritability = getAllFilesFromDir(
                root.toString(),
                relative: true,
                includeDir: true,
            ).findAll { path -> path.toString() }
            def stablePathHeritability = getAllFilesFromDir(
                root.toString(),
                ignoreFile: 'tests/.nftignore',
            )
            def versions = new File("${params.outdir}/pipeline_info/nf_core_gwas_software_mqc_versions.yml")
            assertAll(
                { assert workflow.success },
                { assert TRACE.count(workflow, 'GCTA_CALCULATELDSCORES') == 1 },
                { assert TRACE.count(workflow, 'CUSTOM_GCTASTRATIFYLDSCORES') == 1 },
                { assert TRACE.tags(workflow, 'GCTA_REMLLDMS').sort() == ['example_pgen_bt_example_pgen_bt', 'example_pgen_qt_example_pgen_qt'] },
                { assert binary.contains('/Vp_L') },
                { assert !quantitative.contains('/Vp_L') },
                { assert snapshot(stableNameHeritability, stablePathHeritability).match('heritability') },
                { assert snapshot(removeNextflowVersion(versions.toString())).match('versions') },
            )
        }
    }

    test("per-analysis LDMS settings reuse only scientifically equivalent matrix families") {
        when {
            params {
                outdir = "$outputDir"
                cohort_manifest = RELATIONAL.cohorts(projectDir, outputDir, 'gcta_greml_ldms_overrides')
                analysis_manifest = RELATIONAL.analyses(projectDir, outputDir, 'gcta_greml_ldms_overrides', { rows ->
                    ['same_settings', 'different_region', 'different_bins', 'different_edges'].each { analysis_id ->
                        def analysis = new LinkedHashMap(rows[0])
                        analysis.analysis_id = analysis_id
                        rows << analysis
                    }
                    rows.each { row ->
                        row.association_methods = ''
                        row.heritability_methods = 'gcta_greml_ldms'
                    }
                })
                method_options = RELATIONAL.methodOptions(outputDir, 'gcta_greml_ldms_overrides', [
                    example_pgen_qt: [gcta: [
                        ld_score_region_kb: 50,
                        ld_bins: 1,
                        ldms_maf_edges: [0, 0.5],
                    ]],
                    same_settings: [gcta: [
                        ld_score_region_kb: 50,
                        ld_bins: 1,
                        ldms_maf_edges: [0, 0.5],
                    ]],
                    different_region: [gcta: [
                        ld_score_region_kb: 100,
                        ld_bins: 1,
                        ldms_maf_edges: [0, 0.5],
                    ]],
                    different_bins: [gcta: [
                        ld_score_region_kb: 50,
                        ld_bins: 2,
                        ldms_maf_edges: [0, 0.5],
                    ]],
                    different_edges: [gcta: [
                        ld_score_region_kb: 50,
                        ld_bins: 1,
                        ldms_maf_edges: [0, 0.2, 0.5],
                    ]],
                ])
                gcta_grm_parts = 1
                save_relatedness_matrices = true
            }
        }

        then {
            def matrices = new File("${params.outdir}/quality_control/relatedness_matrices")
            def results = new File("${params.outdir}/heritability/individual/gcta_greml_ldms")
            assertAll(
                { assert workflow.success },
                // The two explicitly equivalent compact settings share one family. Each single-setting
                // scientific change creates one further content-derived family.
                { assert TRACE.count(workflow, 'GCTA_CALCULATELDSCORES') == 4 },
                { assert TRACE.count(workflow, 'CUSTOM_GCTASTRATIFYLDSCORES') == 4 },
                { assert TRACE.count(workflow, 'GCTA_REMLLDMS') == 5 },
                { assert matrices.list().size() == 4 },
                { assert matrices.listFiles().every { matrix -> matrix.listFiles().every { artifact -> !artifact.name.endsWith('.mgrm') } } },
                { assert results.list().toList().sort() == ['different_bins', 'different_edges', 'different_region', 'example_pgen_qt', 'same_settings'] },
            )
        }
    }

    // The LDMS plan-setting refusals this file used to drive are asserted, message and attribution alike, by
    // `subworkflows/local/validate_gwas_input/tests/method_options_gcta.function.nf.test`; the family's
    // pipeline sentinel is `relational_gcta_greml.nf.test`.
}
