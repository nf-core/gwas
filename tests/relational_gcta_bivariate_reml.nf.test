nextflow_pipeline {

    name "Test primary dense GCTA bivariate REML relationship route"
    script "../main.nf"
    tag "pipeline"
    tag "relational"
    tag "heritability"
    tag "genetic_correlation"
    tag "gcta"
    tag "gcta_bivariate_reml"

    def pairInputs = { projectDir, outputDir, name ->
        def analyses = RELATIONAL.analyses(projectDir, outputDir, name, { rows ->
            def binary = RELATIONAL.analysis(projectDir, 'example_pgen_bt')
            binary.population_prevalence = 0.1
            rows << binary
            rows.each { row ->
                row.association_methods = ''
                row.heritability_methods = ''
            }
        })
        return [
            cohort: RELATIONAL.cohorts(projectDir, outputDir, name),
            analyses: analyses,
            relationships: RELATIONAL.relationships(projectDir, outputDir, name),
        ]
    }

    def workFiles = { outputDir ->
        def files = []
        new File(new File(outputDir.toString()).parentFile, 'work').eachFileRecurse { entry ->
            if (entry.isFile()) {
                files << entry
            }
        }
        return files
    }

    test("mixed quantitative-binary pair publishes native outputs, estimand views and provenance") {
        when {
            def inputs = pairInputs(projectDir, outputDir, 'gcta_bivariate_primary')
            params {
                outdir = "$outputDir"
                cohort_manifest = inputs.cohort
                analysis_manifest = inputs.analyses
                relationship_manifest = inputs.relationships
                method_options = RELATIONAL.methodOptions(outputDir, 'gcta_bivariate_primary', [
                    analyses: [:],
                    pair_requests: [
                        'gcta_bivariate_reml--qt_bt': [native_args: ['--reml-maxit', '500']],
                    ],
                ])
                gcta_grm_parts = 1
            }
        }

        then {
            def request = new File("${params.outdir}/requests/gcta_bivariate_reml/gcta_bivariate_reml--qt_bt")
            def heritability = new File("${params.outdir}/heritability/gcta_bivariate_reml/gcta_bivariate_reml--qt_bt/heritability.tsv")
            def correlation = new File("${params.outdir}/genetic_correlation/gcta_bivariate_reml/gcta_bivariate_reml--qt_bt/genetic_correlation.tsv")
            def covariance = new File("${params.outdir}/genetic_covariance/gcta_bivariate_reml/gcta_bivariate_reml--qt_bt/genetic_covariance.tsv")
            def versions = new File("${params.outdir}/pipeline_info/nf_core_gwas_software_mqc_versions.yml")
            def provenance = new groovy.json.JsonSlurper().parse(new File(request, 'provenance.json'))
            def diagnosticText = new File(request, 'diagnostics.tsv').text
            def nativeCommand = workFiles(outputDir).find { entry ->
                entry.name == '.command.sh' && entry.text.contains('--reml-bivar 1 2')
            }
            def stableRequestNames = request.listFiles()*.name.sort()
            def stableProvenance = groovy.json.JsonOutput.prettyPrint(groovy.json.JsonOutput.toJson(provenance))
            assertAll(
                { assert workflow.success },
                { assert TRACE.count(workflow, 'GCTA_MAKEGRMPART') == 1 },
                { assert TRACE.count(workflow, 'CUSTOM_GCTAMERGEGRMPARTS') == 1 },
                { assert TRACE.count(workflow, 'PREPARE_BIVARIATE_TRAITS') == 1 },
                { assert TRACE.count(workflow, 'GCTA_BIVARIATEREML') == 1 },
                { assert TRACE.count(workflow, 'NORMALISE_GCTA_BIVARIATE') == 1 },
                { assert TRACE.count(workflow, 'GCTA_REML') == 0 },
                { assert new File(request, 'native.hsq').isFile() },
                { assert new File(request, 'native.log').isFile() },
                { assert heritability.readLines().size() >= 3 },
                { assert correlation.readLines().size() == 2 },
                { assert covariance.readLines().size() == 2 },
                { assert heritability.readLines().tail().every { line -> !line.contains('\tNA\t') } },
                { assert correlation.readLines().tail().every { line -> !line.contains('\tNA\t') } },
                { assert covariance.readLines().tail().every { line -> !line.contains('\tNA\t') } },
                { assert diagnosticText.contains('\tclassification\t') },
                { assert diagnosticText.contains('\tunion_samples\t') },
                { assert provenance.relationship_id == 'qt_bt' },
                { assert provenance.request_id == 'gcta_bivariate_reml--qt_bt' },
                { assert provenance.orientation.left.analysis_id == 'example_pgen_qt' },
                { assert provenance.orientation.right.analysis_id == 'example_pgen_bt' },
                { assert provenance.matrix.kind == 'gcta_dense' },
                { assert provenance.matrix.settings == [:] },
                { assert provenance.matrix.key },
                { assert provenance.matrix.basename != provenance.request_id },
                { assert provenance.native_args == ['--reml-maxit', '500'] },
                { assert provenance.effective_prevalence == [0.1] },
                { assert provenance.declared_prevalence == [left: null, right: 0.1] },
                { assert provenance.diagnostics.residual_covariance_status == 'retained' },
                { assert provenance.execution.container.contains('python:3.14.5') },
                { assert provenance.native_components.containsKey('C(e)_tr12') },
                { assert nativeCommand != null },
                { assert nativeCommand.text.contains('--reml-bivar-prevalence 0.1') },
                { assert nativeCommand.text.contains('--reml-maxit 500') },
                { assert !nativeCommand.text.contains('\n        --prevalence ') },
                { assert snapshot(removeNextflowVersion(versions.toString())).match('versions') },
                { assert snapshot(stableRequestNames, heritability.text, correlation.text, covariance.text, diagnosticText, stableProvenance).match('results') },
            )
        }
    }

    test("primary pair route preserves topology under stub execution") {
        options "-stub"

        when {
            def inputs = pairInputs(projectDir, outputDir, 'gcta_bivariate_stub')
            params {
                outdir = "$outputDir"
                cohort_manifest = inputs.cohort
                analysis_manifest = inputs.analyses
                relationship_manifest = inputs.relationships
                gcta_grm_parts = 1
            }
        }

        then {
            def request = new File("${params.outdir}/requests/gcta_bivariate_reml/gcta_bivariate_reml--qt_bt")
            def provenance = new groovy.json.JsonSlurper().parse(new File(request, 'provenance.json'))
            assertAll(
                { assert workflow.success },
                { assert TRACE.count(workflow, 'GCTA_BIVARIATEREML') == 1 },
                { assert TRACE.count(workflow, 'NORMALISE_GCTA_BIVARIATE') == 1 },
                { assert new File(request, 'native.hsq').isFile() },
                { assert provenance.stub == true },
                { assert provenance.classification == 'completed_nonestimable' },
            )
        }
    }

    test("default unary GREML and pair requests share one dense matrix without migrating unary outputs") {
        when {
            params {
                outdir = "$outputDir"
                cohort_manifest = RELATIONAL.cohorts(projectDir, outputDir, 'gcta_bivariate_coexistence')
                analysis_manifest = RELATIONAL.analyses(projectDir, outputDir, 'gcta_bivariate_coexistence', { rows ->
                    def binary = RELATIONAL.analysis(projectDir, 'example_pgen_bt')
                    binary.population_prevalence = 0.1
                    rows << binary
                    rows.each { row ->
                        row.association_methods = ''
                        row.heritability_methods = 'gcta_greml'
                    }
                })
                relationship_manifest = RELATIONAL.relationships(projectDir, outputDir, 'gcta_bivariate_coexistence')
                gcta_grm_parts = 1
            }
        }

        then {
            def unaryRoot = new File("${params.outdir}/heritability/individual/gcta_greml")
            def pairRequest = new File("${params.outdir}/requests/gcta_bivariate_reml/gcta_bivariate_reml--qt_bt")
            assertAll(
                { assert workflow.success },
                { assert TRACE.count(workflow, 'GCTA_MAKEGRMPART') == 1 },
                { assert TRACE.count(workflow, 'CUSTOM_GCTAMERGEGRMPARTS') == 1 },
                { assert TRACE.count(workflow, 'GCTA_REML') == 2 },
                { assert TRACE.count(workflow, 'GCTA_BIVARIATEREML') == 1 },
                { assert new File(unaryRoot, 'example_pgen_qt/example_pgen_qt.gcta_greml.hsq').isFile() },
                { assert new File(unaryRoot, 'example_pgen_bt/example_pgen_bt.gcta_greml.hsq').isFile() },
                { assert new File(pairRequest, 'native.hsq').isFile() },
                { assert new File(pairRequest, 'provenance.json').isFile() },
            )
        }
    }

    def invalidPairs = [
        [
            name: 'same endpoint on both sides',
            mutateRelationships: { rows -> rows[0].right_analysis_id = rows[0].left_analysis_id },
            expected: "the exact same analysis endpoint 'example_pgen_qt' cannot occupy both sides",
        ],
        [
            name: 'distinct analyses declaring the same trait ID',
            mutateAnalyses: { rows -> rows[1].trait_id = rows[0].trait_id },
            expected: "declared trait_id 'QT' is equal on both sides; self-pairs are invalid",
        ],
        [
            name: 'reversed duplicate binding',
            mutateRelationships: { rows ->
                def reversed = new LinkedHashMap(rows[0])
                reversed.relationship_id = 'bt_qt'
                reversed.left_analysis_id = rows[0].right_analysis_id
                reversed.right_analysis_id = rows[0].left_analysis_id
                rows << reversed
            },
            expected: "unordered endpoint binding duplicates relationship_id 'qt_bt'",
        ],
        [
            name: 'reserved summary endpoint',
            mutateRelationships: { rows -> rows[0].left_summary_statistics_id = 'summary_qt' },
            expected: 'summary-statistics endpoints are reserved for the later SumCors and LDSC relationship routes',
        ],
    ]

    invalidPairs.each { scenario ->
        test("relationship validation rejects ${scenario.name} before task submission") {
            when {
                params {
                    outdir = "$outputDir"
                    cohort_manifest = RELATIONAL.cohorts(projectDir, outputDir, "invalid_${scenario.name.replace(' ', '_')}")
                    analysis_manifest = RELATIONAL.analyses(projectDir, outputDir, "invalid_${scenario.name.replace(' ', '_')}", { rows ->
                        rows << RELATIONAL.analysis(projectDir, 'example_pgen_bt')
                        rows.each { row ->
                            row.association_methods = ''
                            row.heritability_methods = ''
                        }
                        if (scenario.mutateAnalyses) {
                            scenario.mutateAnalyses(rows)
                        }
                    })
                    relationship_manifest = RELATIONAL.relationships(projectDir, outputDir, "invalid_${scenario.name.replace(' ', '_')}", { rows ->
                        if (scenario.mutateRelationships) {
                            scenario.mutateRelationships(rows)
                        }
                    })
                    gcta_grm_parts = 1
                }
            }

            then {
                def report = VALIDATION.report(outputDir, workflow.stdout)
                assertAll(
                    { assert !workflow.success },
                    { assert report.contains(params.relationship_manifest.toString()) },
                    { assert report.contains(scenario.expected) },
                    { assert TRACE.count(workflow, 'GCTA_MAKEGRMPART') == 0 },
                    { assert TRACE.count(workflow, 'GCTA_BIVARIATEREML') == 0 },
                )
            }
        }
    }

    test("relationship validation rejects endpoints from different cohorts before task submission") {
        when {
            params {
                outdir = "$outputDir"
                cohort_manifest = RELATIONAL.cohorts(projectDir, outputDir, 'invalid_pair_cohort', { rows ->
                    rows << RELATIONAL.cohort('example_bfile')
                })
                analysis_manifest = RELATIONAL.analyses(projectDir, outputDir, 'invalid_pair_cohort', { rows ->
                    def right = RELATIONAL.analysis(projectDir, 'example_pgen_bt')
                    right.analysis_id = 'example_bfile_bt'
                    right.cohort_id = 'example_bfile'
                    rows << right
                    rows.each { row ->
                        row.association_methods = ''
                        row.heritability_methods = ''
                    }
                })
                relationship_manifest = RELATIONAL.relationships(projectDir, outputDir, 'invalid_pair_cohort', { rows ->
                    rows[0].right_analysis_id = 'example_bfile_bt'
                })
            }
        }

        then {
            def report = VALIDATION.report(outputDir, workflow.stdout)
            assertAll(
                { assert !workflow.success },
                { assert report.contains("GCTA bivariate REML requires one cohort") },
                { assert report.contains("'example_pgen_qt' uses 'example_pgen'") },
                { assert report.contains("'example_bfile_bt' uses 'example_bfile'") },
                { assert TRACE.count(workflow, 'GCTA_MAKEGRMPART') == 0 },
                { assert TRACE.count(workflow, 'GCTA_BIVARIATEREML') == 0 },
            )
        }
    }

    test("pair native-argument firewall rejects wrapper-owned mechanics") {
        when {
            def inputs = pairInputs(projectDir, outputDir, 'gcta_bivariate_native_firewall')
            params {
                outdir = "$outputDir"
                cohort_manifest = inputs.cohort
                analysis_manifest = inputs.analyses
                relationship_manifest = inputs.relationships
                method_options = RELATIONAL.methodOptions(outputDir, 'gcta_bivariate_native_firewall', [
                    pair_requests: [
                        'gcta_bivariate_reml--qt_bt': [native_args: ['--out', 'hijacked']],
                    ],
                ])
            }
        }

        then {
            def report = VALIDATION.report(outputDir, workflow.stdout)
            assertAll(
                { assert !workflow.success },
                { assert report.contains("pair_request_id 'gcta_bivariate_reml--qt_bt'") },
                { assert report.contains("token 1 '--out' conflicts with wrapper-owned invocation mechanics") },
                { assert TRACE.count(workflow, 'GCTA_MAKEGRMPART') == 0 },
                { assert TRACE.count(workflow, 'GCTA_BIVARIATEREML') == 0 },
            )
        }
    }
}
