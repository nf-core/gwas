nextflow_pipeline {

    name "Test LDAK-KVIK association route"
    script "../main.nf"
    tag "pipeline"
    tag "association"
    tag "ldak"
    tag "kvik"

    def commands = { output_dir ->
        def scripts = []
        new File(new File(output_dir.toString()).parentFile, 'work').eachFileRecurse { entry ->
            if (entry.isFile() && entry.name == '.command.sh') {
                scripts << entry.text
            }
        }
        return scripts
    }

    def gzip_rows = { file ->
        new java.util.zip.GZIPInputStream(new FileInputStream(file))
            .withReader('UTF-8') { reader ->
                reader.readLines().collect { line -> line.split('\t', -1).toList() }
            }
    }

    def execution_modes = [
        [suffix: '', stub: false],
        [suffix: ' - stub', stub: true],
    ]

    def inputs = { output_dir, project_dir, String scenario, String subset, boolean binary = false ->
        def analysis_id = binary ? 'example_pgen_bt' : 'example_vcf_qt'
        def cohort_id = binary ? 'example_pgen' : 'example_vcf'
        def analyses = RELATIONAL.analyses(project_dir, output_dir, scenario, { rows ->
            rows[0] = RELATIONAL.analysis(project_dir, analysis_id)
            rows[0].association_methods = 'ldak_kvik'
        })
        def ldak = [kvik_step1_subset: subset]
        if (subset == 'provided') {
            ldak.predictor_extract = RELATIONAL.predictors(project_dir, output_dir, 'kvik_provided.in', 220)
        }
        return [
            cohort: RELATIONAL.cohorts(project_dir, output_dir, scenario, { rows ->
                rows[0] = RELATIONAL.cohort(cohort_id)
            }),
            analysis: analyses,
            options: RELATIONAL.methodOptions(output_dir, scenario, [(analysis_id): [ldak: ldak]]),
        ]
    }

    // These focused policy tests build their linked inputs locally and load only deterministic process
    // settings from scenario configs. They are intentionally not public named profiles.
    execution_modes.each { mode ->
        test("the all-predictors policy runs KVIK and harmonises its native result${mode.suffix}") {

            config "../conf/test_ldak_kvik_all.config"
            tag "kvik_all"
            if (!mode.stub) {
                tag "kvik_all_real"
                tag "kvik_real"
            }
            if (mode.stub) {
                options "-stub"
            }

            when {
                params {
                    outdir = "$outputDir"
                    def linked = inputs(outputDir, projectDir, 'ldak_kvik_all', 'all')
                    cohort_manifest = linked.cohort
                    analysis_manifest = linked.analysis
                    method_options = linked.options
                }
            }

            then {
                def native_result = new File("${params.outdir}/association/ldak_kvik/example_vcf_qt/example_vcf_qt.ldak_kvik.step2.assoc")
                def harmonised_result = new File("${params.outdir}/summary_statistics/example_vcf_qt--ldak_kvik/example_vcf_qt--ldak_kvik.canonical.tsv.gz")
                if (mode.stub) {
                    assertAll(
                        { assert workflow.success },
                        { assert TRACE.count(workflow, 'PLINK2_MAKEBED') == 1 },
                        { assert TRACE.count(workflow, 'LDAK_THINCOMMON') == 0 },
                        { assert TRACE.count(workflow, 'LDAK_KVIKSTEP1') == 1 },
                        { assert TRACE.count(workflow, 'LDAK_KVIKSTEP2') == 1 },
                        { assert TRACE.count(workflow, 'GWASLAB_HARMONIZE') == 1 },
                        { assert native_result.isFile() },
                        { assert harmonised_result.isFile() },
                    )
                } else {
                    def kvik_commands = commands(outputDir).findAll { command -> command.contains('--kvik-step') }
                    def versions = new File("${params.outdir}/pipeline_info/nf_core_gwas_software_mqc_versions.yml")
                    def harmonised_rows = gzip_rows(harmonised_result)
                    def kvik_summary = null
                    def kvik_harmonisation_input = null
                    new File(new File(outputDir.toString()).parentFile, 'work').eachFileRecurse { entry ->
                        if (entry.isFile() && entry.name == 'example_vcf_qt.ldak_kvik.step2.summaries') {
                            kvik_summary = entry
                        }
                        if (entry.isFile() && entry.name == 'example_vcf_qt.ldak_kvik.step2.harmonisation.tsv') {
                            kvik_harmonisation_input = entry
                        }
                    }
                    def summary_rows = kvik_summary.readLines().collect { line -> line.split('\t', -1).toList() }
                    def summary_predictor_index = summary_rows.first().indexOf('Predictor')
                    def summary_a1_index = summary_rows.first().indexOf('A1')
                    def summary_a2_index = summary_rows.first().indexOf('A2')
                    def summary_eaf_index = summary_rows.first().indexOf('A1Freq')
                    def summary_n_index = summary_rows.first().indexOf('n')
                    def expected_by_allele_key = summary_rows.drop(1).collectEntries { row ->
                        [
                            [row[summary_predictor_index], row[summary_a1_index], row[summary_a2_index]].join('\u001f'),
                            [eaf: row[summary_eaf_index], n: row[summary_n_index]],
                        ]
                    }
                    def expected_n_by_predictor = summary_rows.drop(1).collectEntries { row ->
                        [row[summary_predictor_index], row[summary_n_index]]
                    }
                    def expected_eaf_by_predictor = summary_rows.drop(1).collectEntries { row ->
                        [row[summary_predictor_index], row[summary_eaf_index]]
                    }
                    def harmonisation_input_rows = kvik_harmonisation_input.readLines().collect { line -> line.split('\t', -1).toList() }
                    def input_header = harmonisation_input_rows.first()
                    def input_predictor_index = input_header.indexOf('Predictor')
                    def input_a1_index = input_header.indexOf('A1')
                    def input_a2_index = input_header.indexOf('A2')
                    def input_eaf_index = input_header.indexOf('EAF')
                    def input_n_index = input_header.indexOf('N')
                    def stable_name_native = getAllFilesFromDir("${params.outdir}/association/ldak_kvik", relative: true, includeDir: true).findAll { path -> path.toString() }
                    def stable_path_native = getAllFilesFromDir("${params.outdir}/association/ldak_kvik", ignoreFile: 'tests/.nftignore')
                    def stable_name_harmonised = getAllFilesFromDir("${params.outdir}/summary_statistics", relative: true, includeDir: true).findAll { path -> path.toString() }
                    def stable_path_harmonised = RELATIONAL.gzipTextHashes("${params.outdir}/summary_statistics")
                    assertAll(
                        { assert workflow.success },
                        { assert TRACE.count(workflow, 'PLINK2_MAKEBED') == 1 },
                        { assert TRACE.count(workflow, 'LDAK_THINCOMMON') == 0 },
                        { assert TRACE.count(workflow, 'LDAK_KVIKSTEP1') == 1 },
                        { assert TRACE.count(workflow, 'LDAK_KVIKSTEP2') == 1 },
                        { assert TRACE.count(workflow, 'GWASLAB_HARMONIZE') == 1 },
                        { assert kvik_commands.size() == 2 },
                        { assert kvik_commands.every { command -> command.contains('--mpheno 1') } },
                        { assert kvik_commands.every { command -> command.contains('--random-seed 7') } },
                        { assert !kvik_commands.find { command -> command.contains('--kvik-step1') }.contains('--extract') },
                        { assert harmonised_rows.first() == ['SNPID', 'CHR', 'POS', 'EA', 'NEA', 'STATUS', 'EAF', 'BETA', 'SE', 'P', 'N'] },
                        { assert !input_header.contains('MAF') },
                        { assert !input_header.contains('Wald_Stat') },
                        { assert expected_n_by_predictor.values().any { value ->
                            new BigDecimal(value).stripTrailingZeros().scale() > 0
                        } },
                        // The `.assoc` table has neither an unambiguous effect-allele frequency nor
                        // an effective analysis size. Assert the harmonisation-only adapter against
                        // LDAK's explicit A1Freq and n on the full Predictor+A1+A2 key.
                        { assert harmonisation_input_rows.drop(1).every { row ->
                            def expected = expected_by_allele_key[
                                [row[input_predictor_index], row[input_a1_index], row[input_a2_index]].join('\u001f')
                            ]
                            expected && row[input_eaf_index] == expected.eaf && row[input_n_index] == expected.n
                        } },
                        { assert harmonised_rows.drop(1).every { row ->
                            new BigDecimal(row[6]).compareTo(
                                new BigDecimal(expected_eaf_by_predictor[row.first()])
                            ) == 0
                        } },
                        { assert harmonised_rows.drop(1).every { row -> row.last() == expected_n_by_predictor[row.first()] } },
                        { assert snapshot(stable_name_native, stable_path_native).match('all-native') },
                        { assert snapshot(stable_name_harmonised, stable_path_harmonised).match('all-harmonised') },
                        { assert snapshot(removeNextflowVersion(versions.toString())).match('versions') },
                    )
                }
            }
        }
    }

    execution_modes.each { mode ->
        test("the thin-common policy supplies LDAK's generated predictor list to Step 1${mode.suffix}") {

            config "../conf/test_ldak_kvik_thin_common.config"
            tag "kvik_thin_common"
            if (!mode.stub) {
                tag "kvik_real"
            }
            if (mode.stub) {
                options "-stub"
            }

            when {
                params {
                    outdir = "$outputDir"
                    def linked = inputs(outputDir, projectDir, 'ldak_kvik_thin_common', 'thin_common')
                    cohort_manifest = linked.cohort
                    analysis_manifest = linked.analysis
                    method_options = linked.options
                }
            }

            then {
                def native_result = new File("${params.outdir}/association/ldak_kvik/example_vcf_qt/example_vcf_qt.ldak_kvik.step2.assoc")
                def harmonised_result = new File("${params.outdir}/summary_statistics/example_vcf_qt--ldak_kvik/example_vcf_qt--ldak_kvik.canonical.tsv.gz")
                if (mode.stub) {
                    assertAll(
                        { assert workflow.success },
                        { assert TRACE.count(workflow, 'LDAK_THINCOMMON') == 1 },
                        { assert TRACE.count(workflow, 'LDAK_KVIKSTEP1') == 1 },
                        { assert TRACE.count(workflow, 'LDAK_KVIKSTEP2') == 1 },
                        { assert TRACE.count(workflow, 'GWASLAB_HARMONIZE') == 1 },
                        { assert native_result.isFile() },
                        { assert harmonised_result.isFile() },
                    )
                } else {
                    def step1 = commands(outputDir).find { command -> command.contains('--kvik-step1') }
                    def stable_name_native = getAllFilesFromDir("${params.outdir}/association/ldak_kvik", relative: true, includeDir: true).findAll { path -> path.toString() }
                    def stable_path_native = getAllFilesFromDir("${params.outdir}/association/ldak_kvik", ignoreFile: 'tests/.nftignore')
                    def stable_name_harmonised = getAllFilesFromDir("${params.outdir}/summary_statistics", relative: true, includeDir: true).findAll { path -> path.toString() }
                    def stable_path_harmonised = RELATIONAL.gzipTextHashes("${params.outdir}/summary_statistics")
                    assertAll(
                        { assert workflow.success },
                        { assert TRACE.count(workflow, 'LDAK_THINCOMMON') == 1 },
                        { assert TRACE.count(workflow, 'LDAK_KVIKSTEP1') == 1 },
                        { assert TRACE.count(workflow, 'LDAK_KVIKSTEP2') == 1 },
                        { assert step1 =~ /--extract "example_vcf\.ldak_kvik\.[0-9a-f]+\.ldak_kvik\.step1\.in"/ },
                        { assert snapshot(stable_name_native, stable_path_native).match('thin-common-native') },
                        { assert snapshot(stable_name_harmonised, stable_path_harmonised).match('thin-common-harmonised') },
                    )
                }
            }
        }
    }

    execution_modes.each { mode ->
        test("the provided policy stages the row's predictor list without running thinning${mode.suffix}") {

            config "../conf/test_ldak_kvik_provided.config"
            tag "kvik_provided"
            if (!mode.stub) {
                tag "kvik_real"
            }
            if (mode.stub) {
                options "-stub"
            }

            when {
                params {
                    outdir = "$outputDir"
                    def linked = inputs(outputDir, projectDir, 'ldak_kvik_provided', 'provided')
                    cohort_manifest = linked.cohort
                    analysis_manifest = linked.analysis
                    method_options = linked.options
                }
            }

            then {
                def native_result = new File("${params.outdir}/association/ldak_kvik/example_vcf_qt/example_vcf_qt.ldak_kvik.step2.assoc")
                def harmonised_result = new File("${params.outdir}/summary_statistics/example_vcf_qt--ldak_kvik/example_vcf_qt--ldak_kvik.canonical.tsv.gz")
                if (mode.stub) {
                    assertAll(
                        { assert workflow.success },
                        { assert TRACE.count(workflow, 'LDAK_THINCOMMON') == 0 },
                        { assert TRACE.count(workflow, 'LDAK_KVIKSTEP1') == 1 },
                        { assert TRACE.count(workflow, 'LDAK_KVIKSTEP2') == 1 },
                        { assert TRACE.count(workflow, 'GWASLAB_HARMONIZE') == 1 },
                        { assert native_result.isFile() },
                        { assert harmonised_result.isFile() },
                    )
                } else {
                    def step1 = commands(outputDir).find { command -> command.contains('--kvik-step1') }
                    def stable_name_native = getAllFilesFromDir("${params.outdir}/association/ldak_kvik", relative: true, includeDir: true).findAll { path -> path.toString() }
                    def stable_path_native = getAllFilesFromDir("${params.outdir}/association/ldak_kvik", ignoreFile: 'tests/.nftignore')
                    def stable_name_harmonised = getAllFilesFromDir("${params.outdir}/summary_statistics", relative: true, includeDir: true).findAll { path -> path.toString() }
                    def stable_path_harmonised = RELATIONAL.gzipTextHashes("${params.outdir}/summary_statistics")
                    assertAll(
                        { assert workflow.success },
                        { assert TRACE.count(workflow, 'LDAK_THINCOMMON') == 0 },
                        { assert TRACE.count(workflow, 'LDAK_KVIKSTEP1') == 1 },
                        { assert TRACE.count(workflow, 'LDAK_KVIKSTEP2') == 1 },
                        { assert step1.contains('--extract "kvik_provided.in"') },
                        { assert snapshot(stable_name_native, stable_path_native).match('provided-native') },
                        { assert snapshot(stable_name_harmonised, stable_path_harmonised).match('provided-harmonised') },
                    )
                }
            }
        }
    }

    execution_modes.each { mode ->
        test("binary mode reaches KVIK Step 1 and the binary GWASLab mapping${mode.suffix}") {

            config "../conf/test_ldak_kvik_binary.config"
            tag "kvik_binary"
            if (!mode.stub) {
                tag "kvik_real"
            }
            if (mode.stub) {
                options "-stub"
            }

            when {
                params {
                    outdir = "$outputDir"
                    def linked = inputs(outputDir, projectDir, 'ldak_kvik_binary', 'all', true)
                    cohort_manifest = linked.cohort
                    analysis_manifest = linked.analysis
                    method_options = linked.options
                }
            }

            then {
                def native_result = new File("${params.outdir}/association/ldak_kvik/example_pgen_bt/example_pgen_bt.ldak_kvik.step2.assoc")
                def harmonised_result = new File("${params.outdir}/summary_statistics/example_pgen_bt--ldak_kvik/example_pgen_bt--ldak_kvik.canonical.tsv.gz")
                if (mode.stub) {
                    assertAll(
                        { assert workflow.success },
                        { assert TRACE.count(workflow, 'PLINK2_MAKEBED') == 1 },
                        { assert TRACE.count(workflow, 'LDAK_KVIKSTEP1') == 1 },
                        { assert TRACE.count(workflow, 'LDAK_KVIKSTEP2') == 1 },
                        { assert TRACE.count(workflow, 'GWASLAB_HARMONIZE') == 1 },
                        { assert native_result.isFile() },
                        { assert harmonised_result.isFile() },
                    )
                } else {
                    def step1 = commands(outputDir).find { command -> command.contains('--kvik-step1') }
                    def step2 = commands(outputDir).find { command -> command.contains('--kvik-step2') }
                    def harmonised_rows = gzip_rows(harmonised_result)
                    def kvik_summary = null
                    new File(new File(outputDir.toString()).parentFile, 'work').eachFileRecurse { entry ->
                        if (entry.isFile() && entry.name == 'example_pgen_bt.ldak_kvik.step2.summaries') {
                            kvik_summary = entry
                        }
                    }
                    def summary_rows = kvik_summary.readLines().collect { line -> line.split('\t', -1).toList() }
                    def summary_predictor_index = summary_rows.first().indexOf('Predictor')
                    def summary_n_index = summary_rows.first().indexOf('n')
                    def expected_n_by_predictor = summary_rows.drop(1).collectEntries { row ->
                        [row[summary_predictor_index], row[summary_n_index]]
                    }
                    def stable_name_native = getAllFilesFromDir("${params.outdir}/association/ldak_kvik", relative: true, includeDir: true).findAll { path -> path.toString() }
                    def stable_path_native = getAllFilesFromDir("${params.outdir}/association/ldak_kvik", ignoreFile: 'tests/.nftignore')
                    def stable_name_harmonised = getAllFilesFromDir("${params.outdir}/summary_statistics", relative: true, includeDir: true).findAll { path -> path.toString() }
                    def stable_path_harmonised = RELATIONAL.gzipTextHashes("${params.outdir}/summary_statistics")
                    assertAll(
                        { assert workflow.success },
                        { assert step1.contains('--binary YES') },
                        { assert !step2.contains('--binary') },
                        { assert harmonised_rows.first() == ['SNPID', 'CHR', 'POS', 'EA', 'NEA', 'STATUS', 'EAF', 'BETA', 'SE', 'P', 'N'] },
                        // LDAK reports an approximate effective sample size for binary KVIK. Its
                        // textual value may be integral or fractional depending on the case/control
                        // balance, so the contract is a positive numeric value preserved exactly by
                        // the harmonisation adapter, not integer formatting.
                        { assert expected_n_by_predictor.values().every { value ->
                            new BigDecimal(value) > BigDecimal.ZERO
                        } },
                        { assert harmonised_rows.drop(1).every { row -> row.last() == expected_n_by_predictor[row.first()] } },
                        { assert snapshot(stable_name_native, stable_path_native).match('binary-native') },
                        { assert snapshot(stable_name_harmonised, stable_path_harmonised).match('binary-harmonised') },
                    )
                }
            }
        }
    }
}
