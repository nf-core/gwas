params {
    fixture_source_vcf = null
    fixture_output_dir = null
}

process {
    withName: 'MATERIALIZE_GWAS_TEST_FIXTURES:PLINK2_VCF_ALL' {
        ext.args   = '--double-id'
        ext.prefix = 'example_all'
        publishDir = [
            path: params.fixture_output_dir,
            mode: 'copy',
            pattern: '*.{pgen,psam,pvar}',
        ]
    }

    withName: 'MATERIALIZE_GWAS_TEST_FIXTURES:PLINK2_VCF_CHR1' {
        ext.args   = '--double-id --chr 1'
        ext.prefix = 'example_chr1'
        publishDir = [
            path: params.fixture_output_dir,
            mode: 'copy',
            pattern: '*.{pgen,psam,pvar}',
        ]
    }

    withName: 'MATERIALIZE_GWAS_TEST_FIXTURES:PLINK2_MAKEBED' {
        // This workflow runs from the project root, so `conf/modules/genotypes.config` is loaded and its bare
        // `withName: 'PLINK2_MAKEBED'` selector matches here too. That selector renders the projection policy
        // out of `meta.settings`, which this test-only caller does not build, so the static argument has to be
        // declared here. It is plink2's own default made explicit, and is verified not to change the
        // published `example_all.bed` bytes.
        ext.args   = '--hard-call-threshold 0.1'
        ext.prefix = 'example_all'
        publishDir = [
            path: params.fixture_output_dir,
            mode: 'copy',
            pattern: '*.{bed,bim,fam}',
        ]
    }
}

timeline.enabled = false
report.enabled   = false
trace.enabled    = false
dag.enabled      = false
