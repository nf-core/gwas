/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/gwas Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Binary-trait test profile options
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [cpus: 4, memory: '1.GB', time: '1.h']
}

params {
    // Config options
    config_profile_name        = 'Binary-trait test profile'
    config_profile_description = 'REGENIE association for the static binary-trait example'
}

includeConfig 'route_profile_resolver.config'
