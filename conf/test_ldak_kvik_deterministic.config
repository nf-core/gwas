/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/gwas Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Deterministic LDAK-KVIK content-snapshot options
----------------------------------------------------------------------------------------
*/

// Evaluate the production LDAK selectors before applying the test-only seed. Nextflow loads each
// config file once, so the pipeline's later module-family include does not overwrite this override.
params {
    // Output options
    publish_dir_mode          = 'copy'

    // Save controls
    save_relatedness_matrices = false
}

includeConfig 'modules/ldak.config'

process {
    resourceLimits = [cpus: 4, memory: '1.GB', time: '1.h']

    // LDAK-KVIK estimates stochastic model components. Pinning its documented random seed keeps the
    // native and harmonised content snapshots reproducible without changing production defaults.
    withName: 'LDAK_KVIKSTEP1|LDAK_KVIKSTEP2' {
        ext.args = [
            '--mpheno 1',
            '--random-seed 7',
        ].join(' ').trim()
    }
}
