/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/gwas Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Process resources that a fixed label cannot express
----------------------------------------------------------------------------------------
    `conf/base.config` keeps the nf-core template label tiers unchanged. This file holds the
    resource settings that do not fit them, all measured in a scaling study on synthetic cohorts:

    - one memory override for a process whose need is a label tier its CPU count is not;
    - the dense-tier CPUs and time for the installed nf-core GCTA modules, whose module label
      this pipeline does not edit;
    - memory computed from the sample count N, and the component count K, for every step
      that holds a dense N x N matrix. Memory for these steps grows exactly as N^2
      (R^2 >= 0.999 across 1k-75k samples) and crosses every label tier between about 10k
      and 100k samples, so no fixed label is right for both a test cohort and a biobank.

    Each dense closure requests ceil(1 + 1.3 * c * N^2) GB, where c is the measured GB per N^2
    from that study, the 1.3 factor is headroom over the fitted peak, and the 1 GB covers the fitted
    intercepts. The request doubles on the retry `conf/base.config` grants after an
    out-of-memory exit, and `process.resourceLimits` caps it like any other request.

    N is read from the staged sample list of the matrix the task builds or reads: the
    genotype `.fam`/`.psam` for a builder, the matrix's `.grm.id` (`.grm.iid` for MPH) for a
    consumer, and an LDAK `--keep` list when one restricts it. That count bounds the analysed
    samples from above, so the request errs high when phenotypes are missing, never low.
    Reading it here, at task creation, keeps resource policy out of the upstream-bound modules
    and out of the metadata that keys task caching.

    Selectors are bare process names on purpose. A bare `withName` selector in a config given
    with `-c` loads later and so replaces any closure here, while a `withLabel` selector cannot:
    in Nextflow `withName` always wins over `withLabel`. `docs/usage.md` ("Large cohorts") says so.
----------------------------------------------------------------------------------------
*/

// RESOURCES

process {

    // Holds the merged per-variant meta-analysis table in memory on one thread: 29 GB at 10M
    // variants (0.14 + 2.91e-6 * M GB), past the 6 GB `process_single` gives it. The
    // `process_medium` memory tier covers that without the five idle CPUs the label would add.
    withName: 'FINALISE_META_ANALYSIS' {
        memory = { 36.GB * task.attempt }
    }

    // The installed nf-core GCTA modules declare `process_medium`, and an installed module is not
    // edited. The local dense-matrix modules carry `process_high`; this gives these two the same
    // CPUs and time. Bivariate REML took 4.1 h at 25k samples on 6 CPUs and grows as N^3, so
    // the `process_medium` 8 h limit is exceeded well inside the memory the closures below allow.
    withName: 'GCTA_BIVARIATEREML|GCTA_BIVARIATEREMLLDMS' {
        cpus = { 12 * task.attempt }
        time = { 16.h * task.attempt }
    }

    // Dense-matrix memory from N (and K). Every closure below satisfies the adapter condition "without
    // it the code materially breaks": a fixed tier either fails these steps out of memory from about
    // 10k-100k samples or asks a small cohort's scheduler for tens of gigabytes it never uses.

    // GCTA `--make-grm-part`: one part takes 9.36e-9 GB per N^2 (13 cells to 50k, R^2 1.000; the
    // LDMS per-group build fits the same 9.68e-9). With P >= 2 parts each part takes 7.6e-9 GB per N^2/P
    // (measured at N = 10k-50k, P = 2-8, 44 tasks, R^2 0.997; worst point 2 % above the fit),
    // so splitting saves slightly more than 1/P.
    withName: 'GCTA_MAKEGRMPART' {
        memory = {
            def n = fam_psam.target.countLines()
            def p = nparts as Integer
            def k = p == 1 ? 9.4e-9 : 7.6e-9
            "${(Math.ceil(1 + 1.3 * k * n * n / p) as long) * task.attempt} GB"
        }
    }

    // GCTA unary REML holds about K + 4 dense N x N matrices: pooled over GCTA_REML (K = 1) and
    // GCTA_REMLLDMS (K = 4, 12), 2.993e-8 + 7.476e-9 * K GB per N^2 (15 cells, R^2 1.0000).
    // K is the number of `.grm.id` files staged, one per component matrix.
    withName: 'GCTA_REML|GCTA_REMLLDMS' {
        memory = {
            def ids = (grm_files instanceof Collection ? grm_files : [grm_files]).findAll { grm_file -> grm_file.name.endsWith('.grm.id') }
            def n = ids ? ids.first().target.countLines() : 0
            def k = Math.max(ids.size(), 1)
            "${(Math.ceil(1 + 1.3 * (2.993e-8 + 7.476e-9 * k) * n * n) as long) * task.attempt} GB"
        }
    }

    // GCTA bivariate REML works on (2N)^2 matrices: pooled over GCTA_BIVARIATEREML (K = 1) and
    // GCTA_BIVARIATEREMLLDMS (K = 4), 8.990e-8 + 5.977e-8 * K GB per N^2 (13 cells, R^2 1.0000).
    withName: 'GCTA_BIVARIATEREML|GCTA_BIVARIATEREMLLDMS' {
        memory = {
            def ids = (grm_files instanceof Collection ? grm_files : [grm_files]).findAll { grm_file -> grm_file.name.endsWith('.grm.id') }
            def n = ids ? ids.first().target.countLines() : 0
            def k = Math.max(ids.size(), 1)
            "${(Math.ceil(1 + 1.3 * (8.990e-8 + 5.977e-8 * k) * n * n) as long) * task.attempt} GB"
        }
    }

    // LDAK `--calc-kins-direct`: 7.57e-9 GB per N^2 (9 cells to 75k, R^2 1.000).
    withName: 'LDAK_CALCKINS' {
        memory = {
            def n = fam.target.countLines()
            "${(Math.ceil(1 + 1.3 * 7.6e-9 * n * n) as long) * task.attempt} GB"
        }
    }

    // LDAK REML: 7.83e-9 GB per N^2 (9 cells to 75k, R^2 1.000). LDAK reads only the samples a
    // `--keep` list names, so a relatedness-filtered kinship is sized by its keep list.
    withName: 'LDAK_REML' {
        memory = {
            def id = (grm_files instanceof Collection ? grm_files : [grm_files]).find { grm_file -> grm_file.name.endsWith('.grm.id') }
            def n = id ? id.target.countLines() : 0
            n = keep_file ? Math.min(n, keep_file.target.countLines()) : n
            "${(Math.ceil(1 + 1.3 * 7.8e-9 * n * n) as long) * task.attempt} GB"
        }
    }

    // LDAK HE, PCGC and `--adjust-grm`: 3.73e-9-3.76e-9 GB per N^2 (8 cells each to 50k,
    // R^2 1.000), one dense single-precision copy of the kinship.
    withName: 'LDAK_HE|LDAK_PCGC|LDAK_ADJUSTGRM' {
        memory = {
            def id = (grm_files instanceof Collection ? grm_files : [grm_files]).find { grm_file -> grm_file.name.endsWith('.grm.id') }
            def n = id ? id.target.countLines() : 0
            n = keep_file ? Math.min(n, keep_file.target.countLines()) : n
            "${(Math.ceil(1 + 1.3 * 3.8e-9 * n * n) as long) * task.attempt} GB"
        }
    }

    // MPH `--make_grm`, one component per task: 0.49 + 7.47e-9 * N^2 GB (11 dense cells to 75k
    // and 7 LDMS cells, R^2 1.000). The 0.5 GB intercept is MPH's own and is kept inside the headroom.
    withName: 'MPH_MAKEGRM' {
        memory = {
            def n = fam.target.countLines()
            "${(Math.ceil(1 + 1.3 * (0.5 + 7.5e-9 * n * n)) as long) * task.attempt} GB"
        }
    }

    // MPH REML holds single-precision matrices. Pooled over the dense (K = 1) and LDMS (K = 12) fits
    // (R^2 1.0000): unary 3.787e-9 + 1.890e-9 * K and pair 1.468e-8 + 2.304e-9 * K GB per N^2.
    // A pair fit names two traits. K is the number of `.grm.bin` files staged, one per component.
    withName: 'MPH_REML' {
        memory = {
            def grm = grm_files instanceof Collection ? grm_files : [grm_files]
            def iid = grm.find { grm_file -> grm_file.name.endsWith('.grm.iid') }
            def n = iid ? iid.target.countLines() : 0
            def k = Math.max(grm.count { grm_file -> grm_file.name.endsWith('.grm.bin') } as Integer, 1)
            def per_n2 = trait_names.size() > 1 ? 1.468e-8 + 2.304e-9 * k : 3.787e-9 + 1.890e-9 * k
            "${(Math.ceil(1 + 1.3 * per_n2 * n * n) as long) * task.attempt} GB"
        }
    }
}
