/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/gwas Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Phenotype and covariate preparation module options
----------------------------------------------------------------------------------------
*/

// PHENOTYPE AND COVARIATE PREPARATION

process {

    // The prepared files are derived from the researcher's own inputs and carry no result, so they
    // are published only when asked for. The headerless serialisations are the same content as
    // their headered counterparts and remain unpublished. Stated explicitly rather than left to
    // the process-wide default, so a later change to that default cannot silently start publishing
    // them.
    withName: 'PREPARE_PHENOTYPE_INPUTS' {
        publishDir = [
            path: { "${params.outdir}/phenotypes/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.{pheno,qcovar,catcovar,covar}',
            saveAs: { filename -> filename.contains('.noheader.') ? null : filename },
            enabled: params.save_normalised_phenotypes,
        ]
    }
}
