/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/gwas Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Phenotype and covariate normalisation module options
----------------------------------------------------------------------------------------
*/

// PHENOTYPE AND COVARIATE NORMALISATION

process {

    // The normalised files are derived from the researcher's own inputs and carry no result, so they
    // are published only when asked for. The headerless serialisations and the run log are never
    // published: the first two are the same content as their headered counterparts and the log
    // records container-local paths, so both are provenance noise rather than a result. Stated
    // explicitly rather than left to the process-wide default, so a later change to that default
    // cannot silently start publishing them.
    withName: 'NORMALISE_PHENOTYPES' {
        publishDir = [
            path: { "${params.outdir}/phenotypes/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.{pheno,qcovar,catcovar,covar}',
            saveAs: { filename -> filename.contains('.noheader.') ? null : filename },
            enabled: params.save_normalised_phenotypes,
        ]
    }
}
