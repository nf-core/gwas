/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/gwas Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Standalone CBIIT Python 3 LDSC summary-statistics module options
----------------------------------------------------------------------------------------
*/

// LDSC MUNGING, HERITABILITY AND GENETIC CORRELATION

process {

    // This digest is the verified local build of the pinned CBIIT `ldsc39` source. The corresponding
    // registry manifest is a release gate until publication completes; tests override it with the same
    // image by local tag through LDSC_TEST_CONTAINER.
    withName: 'LDSC_MUNGESUMSTATS|LDSC_H2_OBSERVED|LDSC_H2_LIABILITY|LDSC_RG_OBSERVED|LDSC_RG_LIABILITY' {
        container = { workflow.containerEngine in ['singularity', 'apptainer'] && !task.ext.singularity_pull_docker_container
            ? 'docker://ghcr.io/lyh970817/gwas/ldsc@sha256:77fbb697c16a559c3fe75204b1e7ab6a0202afcf10b8a8629bcc98592b0e412b'
            : 'ghcr.io/lyh970817/gwas/ldsc:3.0.2-cbiit-6c67395@sha256:77fbb697c16a559c3fe75204b1e7ab6a0202afcf10b8a8629bcc98592b0e412b' }
    }

    // The canonical contract fixes every input role. HapMap3 remains a typed staged resource, while all
    // wrapper-owned operation, input and output flags stay outside request-level native arguments.
    withName: 'LDSC_MUNGESUMSTATS' {
        ext.args = [
            '--snp SNPID',
            '--a1 EA',
            '--a2 NEA',
            '--signed-sumstats BETA,0',
            '--p P',
            '--N-col N',
        ].join(' ').trim()
        ext.prefix = { meta.munging_key }
    }

    withName: 'LDSC_H2_OBSERVED' {
        ext.args   = { (meta.native_args ?: []).join(' ') }
        ext.prefix = { 'native.observed' }
        publishDir = [
            path: { "${params.outdir}/requests/ldsc_h2/${meta.request_id}" },
            mode: params.publish_dir_mode,
            pattern: 'native.observed.log',
        ]
    }

    withName: 'LDSC_H2_LIABILITY' {
        ext.args = {
            [
                "--samp-prev ${meta.effective_sample_prevalence.join(',')}",
                "--pop-prev ${meta.effective_population_prevalence.join(',')}",
                (meta.native_args ?: []).join(' '),
            ].join(' ').trim()
        }
        ext.prefix = { 'native.liability' }
        publishDir = [
            path: { "${params.outdir}/requests/ldsc_h2/${meta.request_id}" },
            mode: params.publish_dir_mode,
            pattern: 'native.liability.log',
        ]
    }

    withName: 'LDSC_RG_OBSERVED' {
        ext.args   = { (meta.native_args ?: []).join(' ') }
        ext.prefix = { 'native.observed' }
        publishDir = [
            path: { "${params.outdir}/requests/ldsc_rg/${meta.request_id}" },
            mode: params.publish_dir_mode,
            pattern: 'native.observed.log',
        ]
    }

    withName: 'LDSC_RG_LIABILITY' {
        ext.args = {
            [
                "--samp-prev ${meta.effective_sample_prevalence.join(',')}",
                "--pop-prev ${meta.effective_population_prevalence.join(',')}",
                (meta.native_args ?: []).join(' '),
            ].join(' ').trim()
        }
        ext.prefix = { 'native.liability' }
        publishDir = [
            path: { "${params.outdir}/requests/ldsc_rg/${meta.request_id}" },
            mode: params.publish_dir_mode,
            pattern: 'native.liability.log',
        ]
    }

    // One explicit router publishes each lightweight estimand view and keeps the multi-estimand native
    // payload plus diagnostics/provenance request-addressed. No view ranks or combines methods.
    withName: 'NORMALISE_LDSC' {
        ext.ldsc_container = 'ghcr.io/lyh970817/gwas/ldsc:3.0.2-cbiit-6c67395@sha256:77fbb697c16a559c3fe75204b1e7ab6a0202afcf10b8a8629bcc98592b0e412b'
        publishDir = [
            path: { params.outdir },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename == 'heritability.tsv') {
                    return "heritability/${meta.method}/${meta.request_id}/heritability.tsv"
                }
                if (filename == 'genetic_correlation.tsv') {
                    return "genetic_correlation/${meta.method}/${meta.request_id}/genetic_correlation.tsv"
                }
                if (filename == 'genetic_covariance.tsv') {
                    return "genetic_covariance/${meta.method}/${meta.request_id}/genetic_covariance.tsv"
                }
                if (filename in ['diagnostics.tsv', 'provenance.json']) {
                    return "requests/${meta.method}/${meta.request_id}/${filename}"
                }
                return null
            },
        ]
    }
}
