/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/gwas Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    REGENIE association module options
----------------------------------------------------------------------------------------
*/

// REGENIE ASSOCIATION

process {

    // Both selectors name the pipeline call site rather than the bare process, because the REGENIE
    // processes also run from their own colocated component tests, which this file must not configure.
    // `(.*:)?` rather than `.*:` because `withName` is a full-match regex and the fully qualified name
    // has no leading segment when the route is exercised on its own.

    // Every Step 1 execution mode reads the same canonical trait and derives binary mode from the
    // immutable fit metadata. Low-memory temporary predictions remain in the task work directory.
    withName: '(.*:)?ROUTE_ASSOCIATION_ANALYSES:PLINK_ASSOCIATION_REGENIE:PLINK_FIT_REGENIE:(REGENIE_STEP1|REGENIE_SPLITL0|REGENIE_RUNL0|REGENIE_RUNL1)' {
        ext.args   = {
            [
                '--phenoColList PHENO',
                // The selector PLINK_ASSOCIATION_REGENIE's component nextflow.config declares: Step 2
                // consumes a staged bundle, so the native list must resolve its staged companions.
                '--use-relative-path',
                meta.cat_covariate_names ? "--catCovarList '${meta.cat_covariate_names.join(',')}'" : '',
                meta.is_binary ? '--bt' : '',
                params.regenie_lowmem ? '--lowmem' : '',
                params.regenie_lowmem ? "--lowmem-prefix ${meta.id}.regenie_lowmem" : '',
            ].join(' ').trim()
        }
        ext.prefix = { "${meta.id}.regenie_step1" }
    }

    withName: '(.*:)?ROUTE_ASSOCIATION_ANALYSES:PLINK_ASSOCIATION_REGENIE:REGENIE_STEP2' {
        ext.args   = {
            [
                '--phenoColList PHENO',
                meta.cat_covariate_names ? "--catCovarList '${meta.cat_covariate_names.join(',')}'" : '',
                meta.is_binary ? '--bt' : '',
                meta.is_binary && meta.method_options.regenie.firth ? '--firth' : '',
                meta.is_binary && meta.method_options.regenie.firth && meta.method_options.regenie.firth_approx ? '--approx' : '',
                meta.is_binary && meta.method_options.regenie.firth ? "--pThresh ${meta.method_options.regenie.firth_p_threshold}" : '',
                meta.method_options.regenie.min_mac != null ? "--minMAC ${meta.method_options.regenie.min_mac}" : '',
            ].join(' ').trim()
        }
        ext.prefix = { "${meta.id}.regenie" }
        publishDir = [
            path: { "${params.outdir}/association/regenie/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.regenie.gz',
            saveAs: { filename -> filename.replace('_PHENO.regenie.gz', '.gz') },
        ]
    }
}
