/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/gwas Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    GCTA relatedness matrices and heritability module options
----------------------------------------------------------------------------------------
*/

// GCTA RELATEDNESS MATRICES AND HERITABILITY

process {

    // Matrix-building arguments may read only settings already present in the content identity. This keeps
    // the command and reuse key coupled: a per-analysis MAF override cannot alter matrix bytes while
    // retaining the default key.
    withName: '.*:PREPARE_RELATEDNESS_MATRICES:PLINK_PREPARE_GRM_GCTA:GCTA_MAKEGRMPART' {
        ext.args = {
            [meta.settings.maf != null ? "--maf ${meta.settings.maf}" : ''].join(' ').trim()
        }
    }
    //
    // The merged bundle is the reusable artefact and the only one published, and then only when asked for.
    // The path is addressed by the reuse key rather than by cohort because one cohort can carry several
    // distinct matrices and a shared matrix belongs to no single analysis. The per-partition files and the
    // GCTA logs are never published: the partitions are an implementation detail of the memory control and
    // the logs record container-local paths and a timestamp.
    //
    // The selector is qualified by the calling subworkflow rather than left bare because the LD- and
    // MAF-stratified route nests a second `CUSTOM_GCTAMERGEGRMPARTS` under its own stratum builder, whose
    // per-stratum matrices are not base matrices and must not publish here.
    withName: '.*:PREPARE_RELATEDNESS_MATRICES:PLINK_PREPARE_GRM_GCTA:CUSTOM_GCTAMERGEGRMPARTS' {
        publishDir = [
            path: { "${params.outdir}/quality_control/relatedness_matrices/${meta.key}" },
            mode: params.publish_dir_mode,
            pattern: '*.grm.{bin,N.bin,id}',
            enabled: params.save_relatedness_matrices,
        ]
    }

    withName: '.*:PREPARE_RELATEDNESS_MATRICES:GCTA_MAKEBKSPARSE' {
        publishDir = [
            path: { "${params.outdir}/quality_control/relatedness_matrices/${meta.key}" },
            mode: params.publish_dir_mode,
            pattern: '*.grm.{id,sp}',
            enabled: params.save_relatedness_matrices,
        ]
    }

    withName: '.*:GRM_HERITABILITY_GCTA:GCTA_REML' {
        // Preparation writes the trait to a fixed third column, so the trait selector is the constant 1
        // rather than something resolved from the samplesheet's column name.
        //
        // `--prevalence` transforms the estimate from the observed scale to the liability scale. Ingress
        // validation permits it only for a binary trait, so this adapter trusts the declared internal record.
        ext.args   = {
            [
                '--mpheno 1',
                meta.population_prevalence != null ? "--prevalence ${meta.population_prevalence}" : '',
                meta.method_options.gcta.reml_no_constrain ? '--reml-no-constrain' : '',
            ].join(' ').trim()
        }
        ext.prefix = { "${meta.id}.gcta_greml" }
        publishDir = [
            path: { "${params.outdir}/heritability/individual/gcta_greml/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.hsq',
        ]
    }

    withName: '.*:GRM_HERITABILITY_GCTA:GCTA_REMLLDMS' {
        ext.args   = {
            [
                '--mpheno 1',
                meta.population_prevalence != null ? "--prevalence ${meta.population_prevalence}" : '',
                meta.method_options.gcta.reml_no_constrain ? '--reml-no-constrain' : '',
            ].join(' ').trim()
        }
        ext.prefix = { "${meta.id}.gcta_greml_ldms" }
        publishDir = [
            path: { "${params.outdir}/heritability/individual/gcta_greml_ldms/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.hsq',
        ]
    }

    // The pipeline owns request attribution and the native-argument firewall; the installed atom owns
    // only the GCTA invocation. Endpoint-aware prevalence is emitted through the native bivariate flag,
    // never through unary --prevalence, and the request ID is intentionally not used as the GRM basename.
    withName: '.*:GCTA_BIVARIATEREML' {
        ext.args = {
            [
                meta.reml_bivar_prevalence ? "--reml-bivar-prevalence ${meta.reml_bivar_prevalence.join(' ')}" : '',
                meta.native_args.join(' '),
            ].join(' ').trim()
        }
        ext.prefix = { 'native' }
        publishDir = [
            path: { "${params.outdir}/requests/gcta_bivariate_reml/${meta.request_id}" },
            mode: params.publish_dir_mode,
            pattern: 'native.{hsq,log}',
        ]
    }

    // REML-LDMS owns the same scientific argument and prevalence seams as dense bivariate REML, while
    // the wrapper-owned primary input is the staged MGRM family rather than one dense GRM basename.
    withName: '.*:GCTA_BIVARIATEREMLLDMS' {
        ext.args = {
            [
                meta.reml_bivar_prevalence ? "--reml-bivar-prevalence ${meta.reml_bivar_prevalence.join(' ')}" : '',
                meta.native_args.join(' '),
            ].join(' ').trim()
        }
        ext.prefix = { 'native' }
        publishDir = [
            path: { "${params.outdir}/requests/gcta_bivariate_reml_ldms/${meta.request_id}" },
            mode: params.publish_dir_mode,
            pattern: 'native.{hsq,log}',
        ]
    }

    // Haseman-Elston regression is a moment estimator with no prevalence, ascertainment or covariate
    // parameter, so the only scientific argument seam is the request's own native-argument list. The
    // published native table is the `.HEreg` file; the log is published with it because GCTA writes the
    // jackknife sampling variance/covariance matrix of the estimates only there.
    withName: '.*:GCTA_BIVARIATEHEREG' {
        ext.args = { meta.native_args.join(' ').trim() }
        ext.prefix = { 'native' }
        publishDir = [
            path: { "${params.outdir}/requests/gcta_bivariate_he/${meta.request_id}" },
            mode: params.publish_dir_mode,
            pattern: 'native.{HEreg,log}',
        ]
    }

    // HEreg-LDMS shares the HEreg argument seam and differs only in consuming the staged MGRM family.
    withName: '.*:GCTA_BIVARIATEHEREGLDMS' {
        ext.args = { meta.native_args.join(' ').trim() }
        ext.prefix = { 'native' }
        publishDir = [
            path: { "${params.outdir}/requests/gcta_bivariate_he_ldms/${meta.request_id}" },
            mode: params.publish_dir_mode,
            pattern: 'native.{HEreg,log}',
        ]
    }

    // The module itself selects --fastGWA-mlm or --fastGWA-mlm-binary from the is_binary input.
    // Deliberately do not expose ext.args here: accepting arbitrary text would make the unsupported
    // plain --fastGWA-lr route reachable and would hide scientific inputs outside the reuse key.
    withName: 'GCTA_FASTGWA' {
        ext.prefix = { "${meta.id}.gcta_fastgwa" }
        publishDir = [
            path: { "${params.outdir}/association/gcta_fastgwa/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.fastGWA',
        ]
    }
}
