/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/gwas Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Summary statistics harmonisation module options
----------------------------------------------------------------------------------------
*/

// SUMMARY STATISTICS HARMONISATION

process {

    withName: 'GWASLAB_HARMONIZE' {
        // GWASLab is the harmonisation intermediate for both internal and external raw inputs. The
        // canonicalisation adapter below is the single publication owner, so the same scientific table
        // is not published once with a producer-oriented name and again with its stable result identity.
        ext.prefix = { "${meta.summary_statistics_id}.harmonised" }
    }
}
