/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/gwas Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Cohort genotype preparation module options
----------------------------------------------------------------------------------------
*/

// COHORT GENOTYPE PREPARATION

process {

    // The prepared bundle is an intermediate, so it is published only when the researcher asks for
    // it. The path is keyed by cohort rather than flat, because two cohorts may legitimately be
    // supplied files of the same basename and their bundles must not overwrite each other. The
    // conversion log is deliberately not published: it records container-local paths and a
    // timestamp, so it is provenance noise rather than a result.
    withName: 'PLINK2_MAKEPGEN|PLINK2_VCF' {
        publishDir = [path: { "${params.outdir}/genotypes/${meta.id}" }, mode: params.publish_dir_mode, pattern: '*.{pgen,psam,pvar}', enabled: params.save_prepared_genotypes]
    }

    withName: 'PLINK2_VCF' {
        // A VCF carries one sample identifier per sample, while both PLINK encodings carry a family
        // identifier as well. Without `--double-id` plink2 leaves the family identifier unset, so a
        // VCF-supplied cohort would not line up with the phenotype and covariate files that its
        // PLINK-supplied siblings use. Setting both identifiers to the VCF sample identifier is what
        // makes all three encodings converge on one canonical bundle.
        ext.args = '--double-id'
    }
}
