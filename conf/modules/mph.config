/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/gwas Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    MPH relatedness matrices and heritability module options
----------------------------------------------------------------------------------------
*/

// MPH RELATEDNESS MATRICES AND HERITABILITY

process {

    // The one-component MPH matrix is a base artifact and publishes by its reuse key, as the merged GCTA
    // dense bundle does. The selector is qualified by the calling composition rather than left bare because
    // the stratified builder nests a second `MPH_MAKEGRM` per component, and those bundles are published as a
    // family through the pipeline's own output block instead, by the family's key.
    withName: '.*:PREPARE_RELATEDNESS_MATRICES:PLINK_PREPARE_GRM_MPH:MPH_MAKEGRM' {
        publishDir = [
            path: { "${params.outdir}/quality_control/relatedness_matrices/${meta.key}" },
            mode: params.publish_dir_mode,
            pattern: '*.grm.{bin,iid}',
            enabled: params.save_relatedness_matrices,
        ]
    }

    // The serializer and the fit each run from two controllers -- the unary heritability
    // route and the pair relationship route -- and the two publish into different trees under different
    // prefixes, so each selector names the controller it configures. `(.*:)?` rather than `.*:` because
    // `withName` is a full-match regex and the fully qualified name has no leading segment when the
    // subworkflow is exercised on its own.

    withName: '(.*:)?ROUTE_MPH_HERITABILITY:PREPARE_MPH_INPUTS' {
        // The serializer publishes nothing. The route supplies the selected estimator token.
        ext.prefix = { "${meta.id}.${meta.mph_estimator}" }
    }

    withName: '(.*:)?ROUTE_MPH_HERITABILITY:MPH_REML' {
        // Render the route's native argument list; the atom owns matrix, trait and covariate flags.
        ext.args   = { meta.mph_effective.native_arguments.join(' ').trim() }
        ext.prefix = { "${meta.id}.${meta.mph_estimator}" }
        // `*.mq.py.csv` is deliberately absent from the pattern: it is one projected phenotype per individual,
        // so it is individual-level data that scales with the cohort, and it stays in the work directory for
        // the reason LDAK's per-individual heritabilities do.
        publishDir = [
            path: { "${params.outdir}/heritability/individual/${meta.mph_estimator}/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.{mq.vc.csv,mq.blue.csv,mq.iter.csv,mq.cor.csv,log}',
        ]
    }

    // MPH BIVARIATE RELATIONSHIP REQUESTS
    //
    // A pair request publishes under the deterministic request identity beside every other pairwise route, with
    // the native family under the shared `native` prefix.

    withName: '(.*:)?ROUTE_MPH_BIVARIATE_RELATIONSHIPS:PREPARE_MPH_INPUTS' {
        ext.prefix = { 'native' }
    }

    withName: '(.*:)?ROUTE_MPH_BIVARIATE_RELATIONSHIPS:MPH_REML' {
        ext.args   = { meta.mph_effective.native_arguments.join(' ').trim() }
        ext.prefix = { 'native' }
        publishDir = [
            path: { "${params.outdir}/requests/${meta.method}/${meta.request_id}" },
            mode: params.publish_dir_mode,
            pattern: 'native.{mq.vc.csv,mq.blue.csv,mq.iter.csv,mq.cor.csv,log}',
        ]
    }
}
