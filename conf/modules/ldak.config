/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/gwas Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    LDAK association, relatedness matrix and heritability module options
----------------------------------------------------------------------------------------
*/

// LDAK ASSOCIATION, RELATEDNESS MATRICES AND HERITABILITY

process {

    // Qualified by the calling route, as every other route-owned block here is, so that this naming and
    // publication policy cannot reach a bare component test of the same process.
    withName: '(.*:)?ROUTE_LDAK_KVIK_ASSOCIATIONS:LDAK_THINCOMMON' {
        ext.prefix = { "${meta.id}.ldak_kvik.step1" }
    }

    withName: '(.*:)?ROUTE_LDAK_KVIK_ASSOCIATIONS:PLINK_ASSOCIATION_LDAK_KVIK:LDAK_KVIKSTEP1' {
        // Preparation fixes the trait as the first phenotype after FID/IID in the headerless file.
        ext.args   = { ['--mpheno 1', meta.is_binary ? '--binary YES' : ''].join(' ').trim() }
        ext.prefix = { "${meta.id}.ldak_kvik" }
    }

    withName: '(.*:)?ROUTE_LDAK_KVIK_ASSOCIATIONS:PLINK_ASSOCIATION_LDAK_KVIK:LDAK_KVIKSTEP2' {
        ext.args   = '--mpheno 1'
        publishDir = [
            path: { "${params.outdir}/association/ldak_kvik/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.step2*.assoc',
        ]
    }

    // Matrix metadata retains the weights settings in its content identity. Equal weights use LDAK's native
    // omission of a weights file; supplied weights are staged by the reusable composition.
    withName: '.*:PREPARE_RELATEDNESS_MATRICES:PLINK_PREPARE_GRM_LDAK:LDAK_CALCKINS' {
        publishDir = [
            path: { "${params.outdir}/quality_control/relatedness_matrices/${meta.key}" },
            mode: params.publish_dir_mode,
            pattern: '*.grm.{bin,id,details,adjust}',
            enabled: params.save_relatedness_matrices,
        ]
    }

    withName: '.*:PREPARE_RELATEDNESS_MATRICES:PLINK_PREPARE_GRM_LDAK:LDAK_SUBGRM' {
        publishDir = [
            path: { "${params.outdir}/quality_control/relatedness_matrices/${meta.key}" },
            mode: params.publish_dir_mode,
            pattern: '*.grm.{bin,id,details,adjust}',
            enabled: params.save_relatedness_matrices,
        ]
    }

    withName: '(.*:)?ROUTE_GRM_HERITABILITY:LDAK_ADJUSTGRM' {
        // The module defaults to `<id>.adjusted` so its `${prefix}.grm.*` outputs cannot capture the staged
        // parent matrix. This caller opts out because the adjusted artifact carries its own derived identity
        // (`ldak_adjusted.<key>`), which is never the parent kinship artifact's own id, so the two prefixes
        // cannot collide in the work directory.
        ext.prefix = { meta.id }
        publishDir = [
            path: { "${params.outdir}/quality_control/relatedness_matrices/${meta.key}" },
            mode: params.publish_dir_mode,
            pattern: '*.grm.{bin,id,details,adjust,root}',
            enabled: params.save_relatedness_matrices,
        ]
    }

    withName: '(.*:)?ROUTE_GRM_HERITABILITY:LDAK_REML' {
        // Preparation fixes the trait at the third column, which is LDAK phenotype number one.
        ext.args   = {
            [
                '--mpheno 1',
                meta.population_prevalence != null ? "--prevalence ${meta.population_prevalence}" : '',
            ].join(' ').trim()
        }
        ext.prefix = { "${meta.id}.ldak_reml" }
        publishDir = [
            path: { "${params.outdir}/heritability/individual/ldak_reml/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.reml*',
        ]
    }

    withName: '(.*:)?ROUTE_GRM_HERITABILITY:LDAK_HE' {
        ext.args   = {
            [
                '--mpheno 1',
                meta.population_prevalence != null ? "--prevalence ${meta.population_prevalence}" : '',
            ].join(' ').trim()
        }
        ext.prefix = { "${meta.id}.ldak_he" }
        publishDir = [
            path: { "${params.outdir}/heritability/individual/ldak_he/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.{he,he.liab,coeff.liab,factor}',
        ]
    }

    withName: '(.*:)?ROUTE_GRM_HERITABILITY:LDAK_PCGC' {
        ext.args   = '--mpheno 1'
        ext.prefix = { "${meta.id}.ldak_pcgc" }
        publishDir = [
            path: { "${params.outdir}/heritability/individual/ldak_pcgc/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.pcgc*',
        ]
    }

    // The direct-genotype estimators read the same model options as the kinship routes, but no matrix
    // metadata exists to carry the model settings. Equal weights are native when no weights file is
    // supplied; `provided` is the staged `--weights` role.
    // The three stochastic controls are native omissions unless the researcher curated them.
    withName: '(.*:)?ROUTE_LDAK_DIRECT_HERITABILITY:LDAK_FASTHE' {
        ext.args   = {
            [
                '--mpheno 1',
                meta.population_prevalence != null ? "--prevalence ${meta.population_prevalence}" : '',
                meta.method_options.ldak.fast_repetitions != null ? "--repetitions ${meta.method_options.ldak.fast_repetitions}" : '',
                meta.method_options.ldak.fast_num_blocks != null ? "--num-blocks ${meta.method_options.ldak.fast_num_blocks}" : '',
                meta.method_options.ldak.fast_seed != null ? "--random-seed ${meta.method_options.ldak.fast_seed}" : '',
            ].join(' ').trim()
        }
        ext.prefix = { "${meta.id}.ldak_fast_he" }
        publishDir = [
            path: { "${params.outdir}/heritability/individual/ldak_fast_he/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.{fasthe,fasthe.liab,factor,cats,coeff,cross,enrich,share,log}',
        ]
    }

    withName: '(.*:)?ROUTE_LDAK_DIRECT_HERITABILITY:LDAK_FASTPCGC' {
        ext.args   = {
            [
                '--mpheno 1',
                meta.method_options.ldak.fast_repetitions != null ? "--repetitions ${meta.method_options.ldak.fast_repetitions}" : '',
                meta.method_options.ldak.fast_num_blocks != null ? "--num-blocks ${meta.method_options.ldak.fast_num_blocks}" : '',
                meta.method_options.ldak.fast_seed != null ? "--random-seed ${meta.method_options.ldak.fast_seed}" : '',
            ].join(' ').trim()
        }
        ext.prefix = { "${meta.id}.ldak_fast_pcgc" }
        publishDir = [
            path: { "${params.outdir}/heritability/individual/ldak_fast_pcgc/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.{fastpcgc,fastpcgc.marginal,cats,coeff,cross,enrich,share,log}',
        ]
    }

    withName: LDAK_SUMHER {
        ext.args   = { meta.effective_native_args.join(' ') }
        ext.prefix = { 'native' }
        publishDir = [
            path: { "${params.outdir}/requests/ldak_sumher/${meta.request_id}" },
            mode: params.publish_dir_mode,
            pattern: 'native.*',
        ]
    }

    withName: LDAK_SUMCORS {
        ext.args   = { meta.effective_native_args.join(' ') }
        ext.prefix = { 'native' }
        publishDir = [
            path: { "${params.outdir}/requests/ldak_sumcors/${meta.request_id}" },
            mode: params.publish_dir_mode,
            pattern: 'native.*',
        ]
    }
}
