// Native model products retain their own semantics; the derived summary always carries fixed BETA/SE/P.
process {
    withName: '(.*:)?ROUTE_META_ANALYSIS:COMMON_VARIANT_META_ANALYSIS:GWASLAB_META_ANALYZE' {
        ext.prefix = { meta.request_id }
        publishDir = [
            [
                path: { "${params.outdir}/requests/fixed/${meta.request_id}" },
                mode: params.publish_dir_mode,
                pattern: '*.{fixed.tsv.gz,gwaslab.log}',
            ],
            [
                path: { "${params.outdir}/requests/random/${meta.request_id}" },
                mode: params.publish_dir_mode,
                pattern: '*.random.tsv.gz',
            ],
        ]
    }
    withName: '(.*:)?ROUTE_META_ANALYSIS:COMMON_VARIANT_META_ANALYSIS:METASOFT_RE2' {
        ext.prefix = { meta.request_id }
        publishDir = [
            path: { "${params.outdir}/requests/re2/${meta.request_id}" },
            mode: params.publish_dir_mode,
            pattern: '*.metasoft.{txt,log}',
        ]
    }
    withName: '(.*:)?ROUTE_META_ANALYSIS:COMMON_VARIANT_META_ANALYSIS:MRMEGA' {
        ext.prefix = { meta.request_id }
        publishDir = [
            path: { "${params.outdir}/requests/mrmega/${meta.request_id}" },
            mode: params.publish_dir_mode,
            pattern: '*.{result,log}',
        ]
    }
    withName: '(.*:)?ROUTE_META_ANALYSIS:FINALISE_META_ANALYSIS' {
        ext.prefix = { meta.summary_statistics_id }
        publishDir = [
            path: { "${params.outdir}/summary_statistics/${meta.summary_statistics_id}" },
            mode: params.publish_dir_mode,
            pattern: '*.gwaslab.tsv.gz',
        ]
    }
}
