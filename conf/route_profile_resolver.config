/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/gwas Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Portable static route-profile input resolver
----------------------------------------------------------------------------------------
*/

// Every static route profile resolves its manifests from the published nf-core/test-datasets `gwas`
// branch under `params.pipelines_testdata_base_path`, so `nextflow run nf-core/gwas -profile test,docker`
// works from a clean clone with no environment variable and no preparatory script. The bivariate method
// options and the relationship manifest stay inside the pipeline repository, which nf-core accepts as a
// test input alongside the public URLs.
//
// GWAS_TEST_FIXTURES is the offline override: set it to a materialized, checksum-verified bundle root and
// every manifest resolves from there instead. `tests/fixtures/materialize.sh --profile <profile>` builds
// that root and prints it, and GWAS_FIXTURE_SOURCE selects the canonical source it reads from.
//
// The six PLINK derivatives (example_all.{pgen,psam,pvar,bed,bim,fam}) that the cohort
// manifest points at resolve over the network only once the follow-up
// nf-core/test-datasets PR adding them to the `gwas` branch has merged.
params.route_profile_resolution = {
    def scenario_by_name = [
        'Fast routine test profile': [analysis: 'analysis_manifest_quantitative.csv', options: null, relationship: null],
        'Binary-trait test profile': [analysis: 'analysis_manifest_binary.csv', options: null, relationship: null],
        'Association-only test profile': [analysis: 'analysis_manifest_association_only.csv', options: null, relationship: null],
        'Heritability-only test profile': [analysis: 'analysis_manifest_heritability_only.csv', options: null, relationship: null],
        'Full-scale test profile': [analysis: 'analysis_manifest_heterogeneous.csv', options: 'method_options_heterogeneous_bivariate.json', relationship: 'relationship_manifest.csv'],
    ]
    def scenario = scenario_by_name[params.config_profile_name]
    if (!scenario) {
        throw new IllegalStateException("No static relational test scenario is registered for profile '${params.config_profile_name}'")
    }

    // Both branches read the bivariate method options and the relationship manifest from the pipeline's
    // own assets, which keeps them available to a clean clone that never materializes a fixture bundle.
    def asset_root = new File(projectDir.toString(), 'assets/examples/relational').absoluteFile

    def declared_fixture_root = System.getenv('GWAS_TEST_FIXTURES')
    if (!declared_fixture_root) {
        def published_relational_root = "${params.pipelines_testdata_base_path}results/fixtures/relational"
        return [
            cohort_manifest: "${published_relational_root}/cohort_manifest.csv".toString(),
            analysis_manifest: "${published_relational_root}/${scenario.analysis}".toString(),
            relationship_manifest: scenario.relationship ? new File(asset_root, scenario.relationship).toString() : null,
            method_options: scenario.options ? new File(asset_root, scenario.options).toString() : null,
        ]
    }

    def fixture_root = new File(declared_fixture_root).absoluteFile
    def local_relational_root = [new File(fixture_root, 'relational'), new File(fixture_root, 'results/fixtures/relational')].find { directory -> directory.isDirectory() }
    if (!local_relational_root) {
        throw new IllegalStateException("GWAS_TEST_FIXTURES is set to '${declared_fixture_root}' but no relational fixture directory exists")
    }
    def relational_root = local_relational_root.absolutePath
    def cohort_manifest = new File(relational_root, 'cohort_manifest.csv').absoluteFile
    def analysis_manifest = new File(relational_root, scenario.analysis).absoluteFile
    // materialize.sh publishes the bivariate options document into the bundle alongside the manifests,
    // so a declared root resolves method options from the same verified cache entry as the manifests.
    def method_options = scenario.options ? new File(relational_root, scenario.options).absoluteFile : null
    def relationship_manifest = scenario.relationship ? new File(asset_root, scenario.relationship) : null
    [cohort_manifest, analysis_manifest, method_options, relationship_manifest]
        .findAll { input -> input }
        .each { input ->
            if (!input.isFile()) {
                throw new IllegalStateException("GWAS_TEST_FIXTURES is set to '${declared_fixture_root}' but ${input} is not a file")
            }
        }

    return [
        cohort_manifest: cohort_manifest.toString(),
        analysis_manifest: analysis_manifest.toString(),
        relationship_manifest: relationship_manifest?.toString(),
        method_options: method_options?.toString(),
    ]
}.call()

// Input options
params {
    cohort_manifest       = params.route_profile_resolution.cohort_manifest
    analysis_manifest     = params.route_profile_resolution.analysis_manifest
    relationship_manifest = params.route_profile_resolution.relationship_manifest
    method_options        = params.route_profile_resolution.method_options
}
