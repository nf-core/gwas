/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/gwas Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Portable static route-profile input resolver
----------------------------------------------------------------------------------------
*/

// Public test profiles consume the same static manifests published by nf-core/test-datasets. An explicit
// GWAS_TEST_FIXTURES root is used only by the fixture-backed test harness; ordinary launches use the public
// gwas branch directly and do not require a prelaunch manifest-generation step.
params.route_profile_resolution = {
    def scenario_by_name = [
        'Fast routine test profile'            : [analysis: 'analysis_manifest_quantitative.csv', options: null],
        'Binary-trait test profile'            : [analysis: 'analysis_manifest_binary.csv', options: null],
        'Association-only test profile'        : [analysis: 'analysis_manifest_association_only.csv', options: null],
        'Heritability-only test profile'       : [analysis: 'analysis_manifest_heritability_only.csv', options: null],
        'Full-scale test profile'              : [analysis: 'analysis_manifest_heterogeneous.csv', options: 'method_options_heterogeneous.json'],
    ]
    def scenario = scenario_by_name[params.config_profile_name]
    if (!scenario) {
        throw new IllegalStateException("No static relational test scenario is registered for profile '${params.config_profile_name}'")
    }

    def declared_fixture_root = System.getenv('GWAS_TEST_FIXTURES')
    def fixture_root = declared_fixture_root
        ? new File(declared_fixture_root).absoluteFile
        : 'https://raw.githubusercontent.com/nf-core/test-datasets/gwas/results/fixtures'
    def relational_root = declared_fixture_root
        ? new File(fixture_root, 'relational').absolutePath
        : "${fixture_root}/relational"
    def resolve = { filename ->
        if (!filename) return null
        def resolved = declared_fixture_root
            ? new File(relational_root, filename).absoluteFile
            : "${relational_root}/${filename}"
        if (declared_fixture_root && !resolved.isFile()) {
            throw new IllegalStateException("GWAS_TEST_FIXTURES is set to '${declared_fixture_root}' but ${resolved} is not a file")
        }
        return resolved.toString()
    }

    [
        cohort_manifest: resolve('cohort_manifest.csv'),
        analysis_manifest: resolve(scenario.analysis),
        method_options: resolve(scenario.options),
    ]
}()

// Input options
params {
    cohort_manifest   = params.route_profile_resolution.cohort_manifest
    analysis_manifest = params.route_profile_resolution.analysis_manifest
    method_options    = params.route_profile_resolution.method_options
}
