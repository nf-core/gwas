/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/gwas Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Portable static test-profile input resolver
----------------------------------------------------------------------------------------
*/

// Every static test profile resolves its cohort manifest from the published nf-core/test-datasets `gwas`
// branch under `params.pipelines_testdata_base_path`, so `nextflow run nf-core/gwas -profile test,docker`
// works from a clean clone with no environment variable and no preparatory script. The analysis manifest
// stays inside the pipeline repository: the published examples each select a method, and no method is
// registered in this release, so the profiles read the preparation-only example from
// `assets/examples/relational`, which nf-core accepts as a test input alongside the public URLs.
//
// GWAS_TEST_FIXTURES is the offline override: set it to a materialized, checksum-verified bundle root and
// both manifests resolve from there instead. `tests/fixtures/materialize.sh --profile <profile>` builds
// that root and prints it, and GWAS_FIXTURE_SOURCE selects the canonical source it reads from.
params.route_profile_resolution = {
    def scenario_by_name = [
        'Fast routine test profile': [analysis: 'analysis_manifest_preparation_only.csv', options: null],
        'Full-scale test profile': [analysis: 'analysis_manifest_preparation_only.csv', options: null],
    ]
    def scenario = scenario_by_name[params.config_profile_name]
    if (!scenario) {
        throw new IllegalStateException("No static relational test scenario is registered for profile '${params.config_profile_name}'")
    }

    // The published branch reads the analysis manifest from the pipeline's own assets, which keeps it
    // available to a clean clone that never materializes a fixture bundle.
    def asset_root = new File(projectDir.toString(), 'assets/examples/relational').absoluteFile

    def declared_fixture_root = System.getenv('GWAS_TEST_FIXTURES')
    if (!declared_fixture_root) {
        def published_relational_root = "${params.pipelines_testdata_base_path}results/fixtures/relational"
        return [
            cohort_manifest: "${published_relational_root}/cohort_manifest.csv".toString(),
            analysis_manifest: new File(asset_root, scenario.analysis).toString(),
            method_options: scenario.options ? new File(asset_root, scenario.options).toString() : null,
        ]
    }

    def fixture_root = new File(declared_fixture_root).absoluteFile
    def local_relational_root = [new File(fixture_root, 'relational'), new File(fixture_root, 'results/fixtures/relational')].find { directory -> directory.isDirectory() }
    if (!local_relational_root) {
        throw new IllegalStateException("GWAS_TEST_FIXTURES is set to '${declared_fixture_root}' but no relational fixture directory exists")
    }
    def cohort_manifest = new File(local_relational_root, 'cohort_manifest.csv').absoluteFile
    // materialize.sh publishes the preparation-only manifest into the bundle alongside the published
    // manifests, with the fixture URLs relocated to the bundle, so a declared root resolves every input from
    // the same verified cache entry and the suite reads local copies only.
    def analysis_manifest = new File(local_relational_root, scenario.analysis).absoluteFile
    def method_options = scenario.options ? new File(local_relational_root, scenario.options).absoluteFile : null
    [cohort_manifest, analysis_manifest, method_options]
        .findAll { input -> input }
        .each { input ->
            if (!input.isFile()) {
                throw new IllegalStateException("GWAS_TEST_FIXTURES is set to '${declared_fixture_root}' but ${input} is not a file")
            }
        }

    return [
        cohort_manifest: cohort_manifest.toString(),
        analysis_manifest: analysis_manifest.toString(),
        method_options: method_options?.toString(),
    ]
}.call()

// Input options
params {
    input           = params.route_profile_resolution.analysis_manifest
    cohort_manifest = params.route_profile_resolution.cohort_manifest
    method_options  = params.route_profile_resolution.method_options
}
