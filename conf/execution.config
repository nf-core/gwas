/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/gwas Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Pipeline execution defaults
----------------------------------------------------------------------------------------
    Placement rule. Scientific specification — what is estimated and under which model —
    belongs in the analysis manifest's `method_options`. Execution strategy — partitioning,
    execution modes, job counts, block sizes and low-memory modes — belongs here. Task
    resources (cpus, memory, time) belong in process configuration (`conf/base.config`).
    Translation of these settings into native command lines belongs in the relevant
    `conf/modules/*.config`.
----------------------------------------------------------------------------------------
*/

params {

    // Relatedness-matrix construction
    gcta_grm_parts      = 1

    // Association execution
    regenie_step1_mode  = 'standard'
    regenie_step1_jobs  = null
    regenie_lowmem      = true
    regenie_step2_bsize = 400
}
