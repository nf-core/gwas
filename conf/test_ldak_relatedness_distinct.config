/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/gwas Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    LDAK distinct relatedness matrix route test options
----------------------------------------------------------------------------------------
*/

includeConfig 'test_ldak_relatedness.config'

process {
    resourceLimits = [cpus: 4, memory: '8.GB', time: '1.h']
}

params {
    // Config options
    config_profile_name        = 'LDAK distinct relatedness matrix test profile'
    config_profile_description = 'LDAK model and power settings that fork matrix identity'
}

includeConfig 'route_profile_resolver.config'
