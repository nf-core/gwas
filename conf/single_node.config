/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/gwas Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Run every task with the local executor inside a single compute node
----------------------------------------------------------------------------------------
    For a run whose inputs are visible only on the node the pipeline is launched from — a
    host-mounted BioFuse view is the case this was written for, and any other node-local
    mount behaves the same way. Every task has to execute on that node, so the scheduler is
    asked for one allocation up front and Nextflow fills it with the local executor instead
    of submitting each task as its own job, which another node could pick up.

    Both sizes come from the allocation. Slurm exports `SLURM_CPUS_ON_NODE` (the cores of
    this node assigned to the job) and `SLURM_MEM_PER_NODE` (MB) into the job environment.
    Outside an allocation both are absent, and `SLURM_MEM_PER_NODE` reads `0` under
    `--mem=0`, which means "whatever the node has" rather than a figure to schedule against.
    In those cases the fallbacks are every core the host reports and 8 GB — deliberately
    conservative for memory, because guessing high on an unknown host oversubscribes it,
    and a real allocation supplies the true figure anyway.

    The strict config parser rejects variable declarations in a config file, so each of the
    two sizes is spelled out where it is used rather than computed once.

    This profile sets no container engine: stack it with the one the site uses, for example
    `-profile single_node,apptainer` or `-profile single_node,singularity`.
----------------------------------------------------------------------------------------
*/

process {
    executor = 'local'

    // `conf/base.config` scales label resources for a cluster that gives a large task its own
    // node. Inside one allocation nothing can exceed the allocation, so cap every request at
    // it; uncapped, a `process_high_memory` task asks for more than the node was given and the
    // local executor never schedules it.
    resourceLimits = [
        cpus: System.getenv('SLURM_CPUS_ON_NODE')?.isInteger() ? System.getenv('SLURM_CPUS_ON_NODE') as Integer : Runtime.runtime.availableProcessors(),
        memory: System.getenv('SLURM_MEM_PER_NODE')?.isInteger() && (System.getenv('SLURM_MEM_PER_NODE') as Integer) > 0 ? "${System.getenv('SLURM_MEM_PER_NODE')}.MB" : '8.GB',
    ]
}

executor {
    // What the local executor is allowed to hand out at once. Uncapped it sizes itself from the whole
    // machine, which on a shared node is everything the allocation did not ask for. `executor.cpus` and
    // `executor.memory` are documented as read by the local executor only, so they need no selector here
    // and, unlike an `executor.$local` block, the config schema recognises them.
    cpus   = System.getenv('SLURM_CPUS_ON_NODE')?.isInteger() ? System.getenv('SLURM_CPUS_ON_NODE') as Integer : Runtime.runtime.availableProcessors()
    memory = System.getenv('SLURM_MEM_PER_NODE')?.isInteger() && (System.getenv('SLURM_MEM_PER_NODE') as Integer) > 0 ? "${System.getenv('SLURM_MEM_PER_NODE')}.MB" : '8.GB'
}
