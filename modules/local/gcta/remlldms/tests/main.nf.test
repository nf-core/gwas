nextflow_process {

    name "Test Process GCTA_REMLLDMS"
    script "../main.nf"
    process "GCTA_REMLLDMS"

    tag "modules"
    tag "modules_nfcore"
    tag "gcta"
    tag "gcta/remlldms"
    tag "gcta/makegrm"
    tag "gawk"
    config "./nextflow.config"

    setup {
        run("GAWK", alias: "GAWK_QUANTITATIVE_PHENOTYPE") {
            script "../../../../nf-core/gawk/main.nf"
            process {
                """
                input[0] = [
                    [ id:'QuantitativeTrait' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated_quantitative_phenoname.phe', checkIfExists: true)
                ]
                input[1] = Channel.of('{ print \$1, \$2, \$3 }').collectFile(name:'quantitative_phenotypes.awk')
                input[2] = false
                """
            }
        }

        run("GAWK", alias: "GAWK_MULTI_PHENOTYPES") {
            script "../../../../nf-core/gawk/main.nf"
            process {
                """
                input[0] = [
                    [ id:'QuantitativeTraitMpheno' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated_quantitative_phenoname.phe', checkIfExists: true)
                ]
                input[1] = Channel.of('{ print \$1, \$2, \$3, (\$3 * 0.5) + ((NR % 7) / 10.0) }').collectFile(name:'multi_phenotypes.awk')
                input[2] = false
                """
            }
        }

        run("GAWK", alias: "GAWK_BINARY_PHENOTYPE") {
            script "../../../../nf-core/gawk/main.nf"
            process {
                """
                input[0] = [
                    [ id:'BinaryTrait' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated_binary_phenoname.phe', checkIfExists: true)
                ]
                input[1] = Channel.of('FNR == 1 { next } { print \$1, \$2, \$3 + 1 }').collectFile(name:'binary_phenotypes.awk')
                input[2] = false
                """
            }
        }

        run("GAWK", alias: "GAWK_QUANTITATIVE_COVARIATES") {
            script "../../../../nf-core/gawk/main.nf"
            process {
                """
                input[0] = [
                    [ id:'covariates_quant' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated_covariates.txt', checkIfExists: true)
                ]
                input[1] = Channel.of('FNR == 1 { next } { print \$1, \$2, \$4, \$5 }').collectFile(name:'quantitative_covariates.awk')
                input[2] = false
                """
            }
        }

        run("GAWK", alias: "GAWK_CATEGORICAL_COVARIATES") {
            script "../../../../nf-core/gawk/main.nf"
            process {
                """
                input[0] = [
                    [ id:'covariates_cat' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated_covariates.txt', checkIfExists: true)
                ]
                input[1] = Channel.of('FNR == 1 { next } { print \$1, \$2, \$3 }').collectFile(name:'categorical_covariates.awk')
                input[2] = false
                """
            }
        }

        run("GCTA_MAKEGRM", alias: "GCTA_MAKEGRM_DENSE") {
            script "../../../../nf-core/gcta/makegrm/main.nf"
            process {
                """
                file('plink_simulated.mbfile').text = 'plink_simulated\\n'

                input[0] = [
                    [ id:'plink_simulated_dense' ],
                    file('plink_simulated.mbfile'),
                    [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.bed', checkIfExists: true)
                    ],
                    [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.bim', checkIfExists: true)
                    ],
                    [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.fam', checkIfExists: true)
                    ]
                ]
                """
            }
        }

        run("GCTA_MAKEGRM", alias: "GCTA_MAKEGRM_STRATUM_LOW") {
            script "../../../../nf-core/gcta/makegrm/main.nf"
            process {
                """
                file('plink_simulated.mbfile').text = 'plink_simulated\\n'

                input[0] = [
                    [ id:'plink_simulated_stratum_low' ],
                    file('plink_simulated.mbfile'),
                    [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.bed', checkIfExists: true)
                    ],
                    [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.bim', checkIfExists: true)
                    ],
                    [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.fam', checkIfExists: true)
                    ]
                ]
                """
            }
        }

        run("GCTA_MAKEGRM", alias: "GCTA_MAKEGRM_STRATUM_HIGH") {
            script "../../../../nf-core/gcta/makegrm/main.nf"
            process {
                """
                file('plink_simulated.mbfile').text = 'plink_simulated\\n'

                input[0] = [
                    [ id:'plink_simulated_stratum_high' ],
                    file('plink_simulated.mbfile'),
                    [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.bed', checkIfExists: true)
                    ],
                    [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.bim', checkIfExists: true)
                    ],
                    [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.fam', checkIfExists: true)
                    ]
                ]
                """
            }
        }
    }

    test("homo_sapiens gsmr - ldms mgrm with mpheno selection") {
        when {
            params {
                module_args = '--mpheno 2'
            }
            process {
                """
                input[0] = GCTA_MAKEGRM_DENSE.out.grm_files.map { _meta, grm_files -> [[id: 'plink_simulated_ldms'], grm_files] }
                input[1] = GAWK_MULTI_PHENOTYPES.out.output.map { meta, pheno -> [[ id:'plink_simulated_ldms' ], pheno] }
                input[2] = GAWK_QUANTITATIVE_COVARIATES.out.output.map { meta, covar -> [[ id:'plink_simulated_ldms' ], covar] }
                input[3] = GAWK_CATEGORICAL_COVARIATES.out.output.map { meta, covar -> [[ id:'plink_simulated_ldms' ], covar] }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.reml_results.size() == 1 },
                { assert process.out.reml_results.get(0).get(0).id == "plink_simulated_ldms" },
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ['log'])).match() }
            )
        }
    }

    test("homo_sapiens gsmr - quantitative phenotype with ldms mgrm and covariates") {
        when {
            process {
                """
                input[0] = GCTA_MAKEGRM_DENSE.out.grm_files.map { _meta, grm_files -> [[id: 'plink_simulated_ldms'], grm_files] }
                input[1] = GAWK_QUANTITATIVE_PHENOTYPE.out.output.map { meta, pheno -> [[ id:'plink_simulated_ldms' ], pheno] }
                input[2] = GAWK_QUANTITATIVE_COVARIATES.out.output.map { meta, covar -> [[ id:'plink_simulated_ldms' ], covar] }
                input[3] = GAWK_CATEGORICAL_COVARIATES.out.output.map { meta, covar -> [[ id:'plink_simulated_ldms' ], covar] }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.reml_results.size() == 1 },
                { assert process.out.reml_results.get(0).get(0).id == "plink_simulated_ldms" },
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ['log'])).match() }
            )
        }
    }

    test("homo_sapiens gsmr - quantitative phenotype with ldms mgrm and no covariates") {
        when {
            process {
                """
                input[0] = GCTA_MAKEGRM_DENSE.out.grm_files.map { _meta, grm_files -> [[id: 'plink_simulated_ldms'], grm_files] }
                input[1] = GAWK_QUANTITATIVE_PHENOTYPE.out.output.map { meta, pheno -> [[ id:'plink_simulated_ldms' ], pheno] }
                input[2] = [[ id:'plink_simulated_ldms' ], []]
                input[3] = [[ id:'plink_simulated_ldms' ], []]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.reml_results.size() == 1 },
                { assert process.out.reml_results.get(0).get(0).id == "plink_simulated_ldms" },
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ['log'])).match() }
            )
        }
    }

    test("homo_sapiens gsmr - binary phenotype with ldms mgrm and prevalence") {
        when {
            params {
                module_args = '--prevalence 0.1'
            }
            process {
                """
                input[0] = GCTA_MAKEGRM_DENSE.out.grm_files.map { _meta, grm_files -> [[id: 'plink_simulated_ldms'], grm_files] }
                input[1] = GAWK_BINARY_PHENOTYPE.out.output.map { meta, pheno -> [[ id:'plink_simulated_ldms' ], pheno] }
                input[2] = [[ id:'plink_simulated_ldms' ], []]
                input[3] = [[ id:'plink_simulated_ldms' ], []]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.reml_results.size() == 1 },
                { assert process.out.reml_results.get(0).get(0).id == "plink_simulated_ldms" },
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ['log'])).match() }
            )
        }
    }

    test("homo_sapiens gsmr - ldms mgrm defaults to first phenotype") {
        when {
            process {
                """
                input[0] = GCTA_MAKEGRM_DENSE.out.grm_files.map { _meta, grm_files -> [[id: 'plink_simulated_ldms'], grm_files] }
                input[1] = GAWK_MULTI_PHENOTYPES.out.output.map { meta, pheno -> [[ id:'plink_simulated_ldms' ], pheno] }
                input[2] = GAWK_QUANTITATIVE_COVARIATES.out.output.map { meta, covar -> [[ id:'plink_simulated_ldms' ], covar] }
                input[3] = GAWK_CATEGORICAL_COVARIATES.out.output.map { meta, covar -> [[ id:'plink_simulated_ldms' ], covar] }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.reml_results.size() == 1 },
                { assert process.out.reml_results.get(0).get(0).id == "plink_simulated_ldms" },
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ['log'])).match() }
            )
        }
    }

    test("homo_sapiens gsmr - a two-component mgrm keeps the declared component order") {
        when {
            params {
                module_args = '--reml-no-constrain'
            }
            process {
                """
                input[0] = GCTA_MAKEGRM_STRATUM_LOW.out.grm_files
                    .concat(GCTA_MAKEGRM_STRATUM_HIGH.out.grm_files)
                    .map { _meta, grm_files -> grm_files }
                    .collect()
                    .map { grm_files -> [[ id:'plink_simulated_ldms_family' ], grm_files] }
                input[1] = GAWK_QUANTITATIVE_PHENOTYPE.out.output.map { _meta, pheno -> [[ id:'plink_simulated_ldms_family' ], pheno] }
                input[2] = [[ id:'plink_simulated_ldms_family' ], []]
                input[3] = [[ id:'plink_simulated_ldms_family' ], []]
                """
            }
        }

        then {
            def results = path(process.out.reml_results.get(0).get(1))
            def manifest = results.parent.resolve('.command.sh').text.readLines().find { line -> line.startsWith('printf') }
            def partition = results.text
            assertAll(
                { assert process.success },
                // The manifest entries follow the staged bundle order the caller declared, not GRM completion.
                { assert manifest == 'printf \'%s\\n\' "plink_simulated_stratum_low" "plink_simulated_stratum_high" > "plink_simulated_ldms_family.mgrm"' },
                // Two declared components produce a two-way native partition and no third component.
                { assert partition.contains('V(G1)') },
                { assert partition.contains('V(G2)') },
                { assert !partition.contains('V(G3)') },
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ['log'])).match() }
            )
        }
    }

    test("homo_sapiens gsmr - quantitative phenotype with ldms mgrm - stub") {
        options "-stub"

        when {
            process {
                """
                input[0] = GCTA_MAKEGRM_DENSE.out.grm_files.map { _meta, grm_files -> [[id: 'plink_simulated_ldms'], grm_files] }
                input[1] = GAWK_QUANTITATIVE_PHENOTYPE.out.output.map { meta, pheno -> [[ id:'plink_simulated_ldms' ], pheno] }
                input[2] = [[ id:'plink_simulated_ldms' ], []]
                input[3] = [[ id:'plink_simulated_ldms' ], []]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.reml_results.size() == 1 },
                { assert process.out.reml_results.get(0).get(0).id == "plink_simulated_ldms" },
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ['log'])).match() }
            )
        }
    }
}
