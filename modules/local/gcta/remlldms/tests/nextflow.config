params {
    module_args = ""
}

// The 200-sample, 220-marker fixture needs only a small native matrix.
process {
    cpus = 2
    memory = 2.GB
    withName: "GCTA_REMLLDMS" {
        ext.args = { params.module_args ?: "" }
    }

    // Two disjoint MAF strata stand in for an LD/MAF grouping plan: the component's own contract is the
    // declared order of whatever complete bundles the caller stages, not how they were stratified.
    withName: "GCTA_MAKEGRM_STRATUM_LOW" {
        ext.args = "--max-maf 0.2"
    }

    withName: "GCTA_MAKEGRM_STRATUM_HIGH" {
        ext.args = "--maf 0.2"
    }
}
