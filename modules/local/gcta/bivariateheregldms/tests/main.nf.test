nextflow_process {
    name "Test Process GCTA_BIVARIATEHEREGLDMS"
    script "../main.nf"
    process "GCTA_BIVARIATEHEREGLDMS"

    tag "modules"
    tag "modules_local"
    tag "modules_nfcore"
    tag "gcta"
    tag "gcta/bivariateheregldms"
    tag "gcta/makegrmpart"
    tag "gawk"
    config "./nextflow.config"

    setup {
        run("GAWK", alias: "GAWK_BIVARIATE_PHENO") {
            script "../../../../nf-core/gawk/main.nf"
            process {
                """
                input[0] = [
                    [ id:'Trait1__Trait2' ],
                    [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated_quantitative_phenoname.phe', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated_covariates.txt', checkIfExists: true)
                    ]
                ]
                input[1] = Channel.of('FNR == NR { if (FNR == 1) next; trait1[\$2] = \$3; next } FNR == 1 { next } { print \$1, \$2, trait1[\$2], \$4 }').collectFile(name:'bivariate_phenotype.awk')
                input[2] = false
                """
            }
        }

        run("GAWK", alias: "GAWK_COMPLEMENT_VARIANTS") {
            script "../../../../nf-core/gawk/main.nf"
            process {
                """
                input[0] = [
                    [ id:'plink_simulated_complement' ],
                    [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_random_selected_snp.txt', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.bim', checkIfExists: true)
                    ]
                ]
                input[1] = Channel.of('FNR == NR { keep[\$1] = 1; next } !(\$2 in keep) { print \$2 }').collectFile(name:'complement_variants.awk')
                input[2] = false
                """
            }
        }

        run("GCTA_MAKEGRMPART", alias: "GCTA_MAKEGRMPART_LDMS1") {
            script "../../makegrmpart/main.nf"
            process {
                """
                file('plink_simulated.mbfile').text = 'plink_simulated\\n'

                input[0] = [
                    [ id:'plink_simulated_ldms1' ],
                    1,
                    1,
                    file('plink_simulated.mbfile'),
                    [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.bed', checkIfExists: true)
                    ],
                    [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.bim', checkIfExists: true)
                    ],
                    [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.fam', checkIfExists: true)
                    ]
                ]
                input[1] = [
                    [ id:'plink_random_selected_snp' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_random_selected_snp.txt', checkIfExists: true)
                ]
                """
            }
        }

        run("GCTA_MAKEGRMPART", alias: "GCTA_MAKEGRMPART_LDMS2") {
            script "../../makegrmpart/main.nf"
            process {
                """
                file('plink_simulated.mbfile').text = 'plink_simulated\\n'

                input[0] = [
                    [ id:'plink_simulated_ldms2' ],
                    1,
                    1,
                    file('plink_simulated.mbfile'),
                    [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.bed', checkIfExists: true)
                    ],
                    [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.bim', checkIfExists: true)
                    ],
                    [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.fam', checkIfExists: true)
                    ]
                ]
                input[1] = GAWK_COMPLEMENT_VARIANTS.out.output
                """
            }
        }
    }

    test("homo_sapiens popgen - bivariate quantitative phenotype with ldms mgrm") {
        when {
            process {
                """
                ldms_grm_files = GCTA_MAKEGRMPART_LDMS1.out.grm_files
                    .mix(GCTA_MAKEGRMPART_LDMS2.out.grm_files)
                    .map { _meta, grm_files, _nparts_gcta, _part_gcta_job -> grm_files }
                    .collect()
                    .map { rows -> rows.flatten() }

                input[0] = ldms_grm_files.map { grm_files ->
                    [[ id:'plink_simulated_ldms' ], grm_files, ['plink_simulated_ldms1.part_1_1', 'plink_simulated_ldms2.part_1_1']]
                }
                input[1] = GAWK_BIVARIATE_PHENO.out.output.map { _meta, phenotype_file -> [[ id:'plink_simulated_ldms' ], phenotype_file, 1, 2] }
                """
            }
        }

        then {
            def resultFile = file(process.out.hereg_results.get(0).get(1))
            def logText = file(process.out.log.get(0).get(1)).text
            def workDirectory = path(process.out.log.get(0).get(1)).parent
            def command = workDirectory.resolve(".command.sh").text.replaceAll(/\s+/, " ")
            def mgrm = workDirectory.resolve('plink_simulated_ldms.mgrm').text
            // `.HEreg` is padded fixed width and `Sum of C(G)/Vp_tr12` fills its 20-character field, so a
            // whitespace split cannot recover the labels: enumerate the coefficient names instead.
            def valueBySource = resultFile.readLines()
                .collect { line -> (line =~ /^(Coefficient|Intercept_tr\d+|Sum of [VC]\(G\)\/Vp_tr\d+|[VC]\(G\d*\)\/Vp_tr\d+|Total rG|rG\d*|N_tr\d+)\s+(\S.*?)\s*$/) }
                .findAll { matcher -> matcher.matches() }
                .collectEntries { matcher -> [(matcher.group(1)): matcher.group(2).split(/\s+/) as List] }
            assertAll(
                { assert process.success },
                { assert process.out.hereg_results.size() == 1 },
                { assert process.out.log.size() == 1 },
                { assert process.out.hereg_results.get(0).get(0).id == "plink_simulated_ldms" },
                { assert resultFile.name == "plink_simulated_ldms.HEreg" },
                { assert command.contains("--HEreg-bivar 1 2") },
                { assert command.contains('--mgrm "plink_simulated_ldms.mgrm"') },
                { assert mgrm == 'plink_simulated_ldms1.part_1_1\nplink_simulated_ldms2.part_1_1\n' },
                { assert process.out.versions_gcta.get(0).get(1) == "gcta" },
                { assert process.out.versions_gcta.get(0).get(2) == "1.94.1" },
                // Two declared components produce per-component rows.
                { assert valueBySource.keySet().containsAll(["V(G1)/Vp_tr1", "V(G1)/Vp_tr2", "C(G1)/Vp_tr12", "V(G2)/Vp_tr1", "V(G2)/Vp_tr2", "C(G2)/Vp_tr12", "rG1", "rG2"]) },
                // GCTA emits a native total for the multi-component model, so no pipeline-side
                // delta-method reconstruction is needed. Each total carries its own jackknife SE.
                { assert valueBySource.keySet().containsAll(["Sum of V(G)/Vp_tr1", "Sum of V(G)/Vp_tr2", "Sum of C(G)/Vp_tr12", "Total rG"]) },
                { assert valueBySource["Total rG"].size() == 3 },
                { assert valueBySource["Sum of C(G)/Vp_tr12"].size() == 5 },
                // The complete sampling covariance matrix is a log-only artefact.
                { assert logText.contains("Jackknife sampling variance/covariance") },
                { assert !resultFile.text.contains("Jackknife sampling variance/covariance") },
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ["log"])).match() }
            )
        }
    }

    test("homo_sapiens popgen - mgrm referencing a missing GRM basename fails") {
        when {
            process {
                """
                ldms_grm_files = GCTA_MAKEGRMPART_LDMS1.out.grm_files
                    .mix(GCTA_MAKEGRMPART_LDMS2.out.grm_files)
                    .map { _meta, grm_files, _nparts_gcta, _part_gcta_job -> grm_files }
                    .collect()
                    .map { rows -> rows.flatten() }

                input[0] = ldms_grm_files.map { grm_files ->
                    [[ id:'plink_simulated_ldms' ], grm_files, ['plink_simulated_ldms_missing.part_1_1']]
                }
                input[1] = GAWK_BIVARIATE_PHENO.out.output.map { _meta, phenotype_file -> [[ id:'plink_simulated_ldms' ], phenotype_file, 1, 2] }
                """
            }
        }

        then {
            assertAll(
                { assert !process.success },
                { assert process.exitStatus != 0 }
            )
        }
    }

    test("homo_sapiens popgen - bivariate quantitative phenotype with ldms mgrm - stub") {
        options "-stub"

        when {
            process {
                """
                ldms_grm_files = GCTA_MAKEGRMPART_LDMS1.out.grm_files
                    .mix(GCTA_MAKEGRMPART_LDMS2.out.grm_files)
                    .map { _meta, grm_files, _nparts_gcta, _part_gcta_job -> grm_files }
                    .collect()
                    .map { rows -> rows.flatten() }

                input[0] = ldms_grm_files.map { grm_files ->
                    [[ id:'plink_simulated_ldms' ], grm_files, ['plink_simulated_ldms1.part_1_1', 'plink_simulated_ldms2.part_1_1']]
                }
                input[1] = GAWK_BIVARIATE_PHENO.out.output.map { _meta, phenotype_file -> [[ id:'plink_simulated_ldms' ], phenotype_file, 1, 2] }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.hereg_results.get(0).get(0).id == "plink_simulated_ldms" },
                { assert file(process.out.hereg_results.get(0).get(1)).name == "plink_simulated_ldms.HEreg" },
                { assert file(process.out.log.get(0).get(1)).name == "plink_simulated_ldms.log" },
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ["log"])).match() }
            )
        }
    }
}
