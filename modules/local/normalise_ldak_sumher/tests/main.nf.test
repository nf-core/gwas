nextflow_process {

    name "Test Process NORMALISE_LDAK_SUMHER"
    script "../main.nf"
    process "NORMALISE_LDAK_SUMHER"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "normalise_ldak_sumher"

    def metadata = [
        id: 'trait_low_coverage',
        summary_statistics_id: 'trait_low_coverage',
        request_id: 'ldak_sumher--trait_low_coverage',
        method: 'ldak_sumher',
        trait_id: 'TRAIT_LOW_COVERAGE',
        trait_type: 'quantitative',
        population_prevalence: null,
        sample_prevalence: null,
        native_args: ['--check-sums', 'NO'],
        effective_native_args: ['--check-sums', 'NO'],
        reference_metadata: [model: 'LDAK-Thin'],
        reference_validation: 'structural_availability_only',
        native_runtime: 'ghcr.io/lyh970817/gwas/ldak@sha256:f2b2157559e4346cab5e9f478ab70fc76359743ef06522fed9ad23769d735a6e',
    ]

    test("a low-coverage HIGH warning prevents a plain estimable classification") {
        when {
            def root = new File(outputDir.toString(), 'native_low_coverage')
            root.mkdirs()
            def hers = new File(root, 'native.hers')
            hers.text = 'Component Heritability SE\nHer_All 0.2 0.01\n'
            def extra = new File(root, 'native.extra')
            extra.text = 'Converged YES\nNum_Datapoints 50\n'
            def overlap = new File(root, 'native.overlap')
            overlap.text = 'Tagging_File_Predictors 100\nSummary_Statistic_Predictors 50\nOverlap_Proportion 0.5\n'
            def log = new File(root, 'native.log')
            log.text = 'LDAK SumHer completed\n'
            def preparation = new File(root, 'preparation.json')
            preparation.text = '{"strand_ambiguous_rows_present":0}\n'
            process {
                """
                input[0] = [new groovy.json.JsonSlurper().parseText('${groovy.json.JsonOutput.toJson(metadata)}'), file('${hers}', checkIfExists: true), file('${extra}', checkIfExists: true), file('${overlap}', checkIfExists: true), file('${log}', checkIfExists: true), file('${preparation}', checkIfExists: true), []]
                """
            }
        }

        then {
            def heritability = new File(process.out.heritability.get(0).get(1).toString()).readLines()
            def diagnostics = new File(process.out.diagnostics.get(0).get(1).toString()).readLines()
            def provenance = new groovy.json.JsonSlurper().parse(new File(process.out.provenance.get(0).get(1).toString()))
            assertAll(
                { assert process.success },
                { assert provenance.warnings == ["HIGH: summary-statistics coverage is below LDAK's approximate 80% guidance under an explicit incomplete-summary override"] },
                { assert provenance.classification == 'estimable_with_warning' },
                { assert provenance.diagnostics.classification == 'estimable_with_warning' },
                { assert heritability.last().endsWith('\testimable_with_warning') },
                { assert diagnostics.contains('ldak_sumher--trait_low_coverage\tclassification\testimable_with_warning') },
            )
        }
    }
}
