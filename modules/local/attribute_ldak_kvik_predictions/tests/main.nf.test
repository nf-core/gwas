nextflow_process {

    name "Test Process ATTRIBUTE_LDAK_KVIK_PREDICTIONS"
    script "../main.nf"
    process "ATTRIBUTE_LDAK_KVIK_PREDICTIONS"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "attribute_ldak_kvik_predictions"

    test("attribute an LDAK-KVIK Step 1 bundle") {

        when {
            process {
                """
                input[0] = [
                    [ id:'analysis_1' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.bed', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.bim', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.fam', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.bundle.size() == 1 },
                { assert process.out.bundle.get(0).get(0).id == 'analysis_1' },
                {
                    assert process.out.bundle.get(0).drop(1).collect { path(it).fileName.toString() } == [
                        'analysis_1.ldak_kvik.step1.root',
                        'analysis_1.ldak_kvik.step1.loco.details',
                        'analysis_1.ldak_kvik.step1.loco.prs'
                    ]
                },
                { assert process.out.findAll { key, val -> key.startsWith('versions') }.size() == 1 }
            )
        }

    }

    test("attribute an LDAK-KVIK Step 1 bundle - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'analysis_1' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.bed', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.bim', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.fam', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.bundle.size() == 1 },
                { assert process.out.bundle.get(0).get(0).id == 'analysis_1' },
                {
                    assert process.out.bundle.get(0).drop(1).collect { path(it).fileName.toString() } == [
                        'analysis_1.ldak_kvik.step1.root',
                        'analysis_1.ldak_kvik.step1.loco.details',
                        'analysis_1.ldak_kvik.step1.loco.prs'
                    ]
                }
            )
        }

    }

}
