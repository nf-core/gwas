params {
    module_args = ""
}

process {
    withName: 'REGENIE_SPLITL0|REGENIE_SPLITL0_PLINK2|REGENIE_RUNL0|REGENIE_RUNL0_PLINK2|REGENIE_RUNL1' {
        ext.args = { params.module_args ?: "" }
    }
}

// The public popgen fixture has 200 samples and 220 variants.
process {
    withName: 'REGENIE_.*' {
        cpus = 1
        memory = '2.GB'
    }
}
