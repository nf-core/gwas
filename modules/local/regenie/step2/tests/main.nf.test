                input[0] = [[id: 'association'], file(genotype_base + 'plink_simulated.bed'), file(genotype_base + 'plink_simulated.bim'), file(genotype_base + 'plink_simulated.fam')]
                input[1] = REGENIE_STEP1_MULTITRAIT.out.predictions.join(REGENIE_STEP1_MULTITRAIT.out.loco)
                input[2] = [[id: 'phenotypes'], file('${outputDir}/two_traits.phe')]
                input[3] = [[id: 'covariates'], []]
                input[4] = 400
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert process.out.results[0][0] == [id: 'association'] },
                {
                    def results = process.out.results[0][1]
                    assert results.size() == 2
                    def directory = path(results[0]).parent
                    def lines = directory.resolve('plink_simulated_pred.list').text.readLines().findAll { it }
                    assert lines.size() == 2
                    assert lines.collect { it.tokenize()[0] }.sort() == ['QuantitativeTrait', 'QuantitativeTrait2']
                    assert lines.every { directory.resolve(it.tokenize()[1]).exists() }
                    assert results.every { path(it).exists() }
                },
                {
                    assert snapshot(
                        process.out.results,
                        process.out.log.collect { [it[0], path(it[1]).getFileName().toString()] },
                        process.out.versions_regenie
                    ).match()
                }
            )
        }
    }

}
