    test("homo_sapiens popgen - meta id output prefix - stub") {

        options "-stub"

        when {
            params {
                module_args = "--phenoColList QuantitativeTrait"
            }
            process {
                """
                input[0] = [
                    [ id:'cohort_alias' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.bed', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.bim', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.fam', checkIfExists: true)
                ]

                input[1] = REGENIE_STEP1_QUANTITATIVE.out.predictions.join(REGENIE_STEP1_QUANTITATIVE.out.loco)

                input[2] = [
                    [ id:'plink_simulated' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated_quantitative_phenoname.phe', checkIfExists: true)
                ]

                input[3] = [
                    [ id:'plink_simulated' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated_covariates.txt', checkIfExists: true)
                ]

                input[4] = 400
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.results.get(0).get(0).id == 'cohort_alias' },
                { assert path(process.out.results.get(0).get(1)).fileName.toString() == 'cohort_alias.plink_simulated_QuantitativeTrait.regenie.gz' },
                { assert path(process.out.log.get(0).get(1)).fileName.toString() == 'cohort_alias.plink_simulated.log' },
                {
                    def stableResults = process.out.results.collect { result ->
                        [result[0], result[1]]
                    }
                    def stableLogs = process.out.log.collect { logFile ->
                        [logFile[0], path(logFile[1]).getFileName().toString()]
                    }
                    assert snapshot(
                        stableResults,
                        stableLogs,
                        process.out.findAll { key, val -> key.startsWith('versions') }
                    ).match()
                }
            )
        }

    }

    test("homo_sapiens popgen - complete multi-trait prediction bundle") {
        when {
            params {
                module_args = "--phenoColList QuantitativeTrait,QuantitativeTrait2"
            }
            process {
                """
                def genotype_base = params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/'
                input[0] = [[id: 'association'], file(genotype_base + 'plink_simulated.bed'), file(genotype_base + 'plink_simulated.bim'), file(genotype_base + 'plink_simulated.fam')]
                input[1] = REGENIE_STEP1_MULTITRAIT.out.predictions.join(REGENIE_STEP1_MULTITRAIT.out.loco)
                input[2] = [[id: 'phenotypes'], file('${outputDir}/two_traits.phe')]
                input[3] = [[id: 'covariates'], []]
                input[4] = 400
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert process.out.results[0][0] == [id: 'association'] },
                {
                    def results = process.out.results[0][1]
                    assert results.size() == 2
                    def directory = path(results[0]).parent
                    def lines = directory.resolve('plink_simulated_pred.list').text.readLines().findAll { it }
                    assert lines.size() == 2
                    assert lines.collect { it.tokenize()[0] }.sort() == ['QuantitativeTrait', 'QuantitativeTrait2']
                    assert lines.every { directory.resolve(it.tokenize()[1]).exists() }
                    assert results.every { path(it).exists() }
                },
                {
                    assert snapshot(
                        process.out.results,
                        process.out.log.collect { [it[0], path(it[1]).getFileName().toString()] },
                        process.out.versions_regenie
                    ).match()
                }
            )
        }
    }
    test("homo_sapiens popgen - complete multi-trait prediction bundle - stub") {
        options "-stub"
        when {
            params {
                module_args = "--phenoColList QuantitativeTrait,QuantitativeTrait2"
