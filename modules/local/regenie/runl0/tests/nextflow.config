params {
    module_args   = ""
    module_prefix = null
}

process {
    withName: 'REGENIE_SPLITL0|REGENIE_SPLITL0_PLINK2|REGENIE_RUNL0' {
        ext.args = { params.module_args ?: "" }
    }
    // The PLINK 2 scenario renames both the splitter and the L0 job so the two setups cannot collide.
    withName: 'REGENIE_SPLITL0_PLINK2|REGENIE_RUNL0' {
        ext.prefix = { params.module_prefix }
    }
}

// The public popgen fixture has 200 samples and 220 variants.
process {
    withName: 'REGENIE_.*' {
        cpus = 1
        memory = '2.GB'
    }
}
