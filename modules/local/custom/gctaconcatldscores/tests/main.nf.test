nextflow_process {

    name "Test Process CUSTOM_GCTACONCATLDSCORES"
    script "../main.nf"
    process "CUSTOM_GCTACONCATLDSCORES"
    config "./nextflow.config"

    tag "modules"
    tag "modules_nfcore"
    tag "custom"
    tag "custom/gctaconcatldscores"

    // The tables are supplied in chromosome order 10, 2, 1, the reverse of their lexical file-name order, so a
    // join that followed staged file-name order would produce a different table. Rows inside a table are
    // deliberately not in base-pair order, and must stay as they are.
    def header = 'SNP chr bp freq mean_rsq snp_num max_rsq ldscore_SNP ldscore_region'
    def tables = [
        '10': ['s10b 10 900 0.1 0.01 2 0.2 1.5 1.25', 's10a 10 100 0.2 0.02 2 0.3 1 1.25'],
        '2': ['s2a 2 100 0.3 0.03 1 0.4 2 2'],
        '1': ['s1a 1 100 0.4 0.04 2 0.5 3 3.5', 's1b 1 200 0.5 0.05 2 0.6 4 3.5'],
    ]
    def inputCode = { output_dir ->
        def root = new File(new File(output_dir.toString()).parentFile, 'inputs')
        root.mkdirs()
        def files = tables.collect { chromosome, rows ->
            def table = new File(root, "plan_chr${chromosome}_gcta_ld.score.ld")
            table.text = ([header] + rows).join('\n') + '\n'
            "file('${table.absolutePath}', checkIfExists: true)"
        }
        return """
            input[0] = [[id: 'plan'], ${files}]
            """
    }
    def expected = ([header] + tables.values().flatten()).join('\n') + '\n'

    test("per-chromosome tables join in supplied order under one header") {
        when {
            process { inputCode(outputDir) }
        }
        then {
            assertAll(
                { assert process.success },
                { assert process.out.ld_scores[0][0] == [id: 'plan'] },
                { assert file(process.out.ld_scores[0][1]).name == 'plan_gcta_ld.score.ld' },
                { assert file(process.out.ld_scores[0][1]).text == expected },
                { assert snapshot(sanitizeOutput(process.out)).match() },
            )
        }
    }

    test("per-chromosome table join - stub") {
        options "-stub"
        when {
            process { inputCode(outputDir) }
        }
        then {
            assertAll(
                { assert process.success },
                { assert file(process.out.ld_scores[0][1]).text == expected },
                { assert snapshot(sanitizeOutput(process.out)).match() },
            )
        }
    }
}
