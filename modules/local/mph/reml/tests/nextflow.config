params {
    // No curated option is rendered by default; cases that need one override this parameter.
    module_args = ""
}

process {
    // The pipeline's own blocks for this process are qualified by their calling controller, so they do not
    // reach a bare process scope. The argument, prefix and publication seams are restated here anyway: the
    // pipeline's argument closure reads route-local effective settings this component test does not mint, its
    // prefix belongs to the route, and a route publication closure reaching this scope would evaluate an unset
    // `params.outdir` into a literal `null/` tree beside the test. What is under test is the component
    // contract, not the pipeline's routing and publication policy.
    withName: MPH_REML {
        // A case that must compare two native settings against each other has to run both arms inside one
        // invocation, because the comparison is between two runs on the same matrices and nf-test surfaces
        // only the process under test. A request that carries its own argument list therefore wins over the
        // scenario-wide parameter; every other case leaves `meta.native_args` unset and reads the parameter.
        ext.args = { meta.native_args != null ? meta.native_args : (params.module_args ?: "") }
        ext.prefix = { meta.id }
        publishDir = []
        container = System.getenv('MPH_TEST_CONTAINER') ?: 'ghcr.io/lyh970817/gwas/mph@sha256:c471ae7132e961bf401dd3db177d4c0c1c6cfdf0fc8306db1dcaac5b85a6c3e7'
        cpus = 2
        memory = 2.GB
    }

    withName: 'MPH_MAKEGRM.*' {
        container = System.getenv('MPH_TEST_CONTAINER') ?: 'ghcr.io/lyh970817/gwas/mph@sha256:c471ae7132e961bf401dd3db177d4c0c1c6cfdf0fc8306db1dcaac5b85a6c3e7'
        cpus = 2
        memory = 2.GB
    }
}
