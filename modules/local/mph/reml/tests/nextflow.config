params.module_args = ''

process {
    withName: MPH_REML {
        // A case that compares two native settings against each other has to run both arms inside one
        // invocation, because the comparison is between two runs on the same matrices and nf-test surfaces
        // only the process under test. `on_the_fly` is that case's own request; every other case leaves the
        // branch inert and reads `params.module_args`.
        ext.args = { params.module_args + (meta.id == 'on_the_fly' ? ' --save_memory' : '') }
        cpus = 2
        memory = 2.GB
    }
    withName: 'MPH_MAKEGRM.*' {
        cpus = 2
        memory = 2.GB
    }
}
