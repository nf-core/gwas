nextflow_process {

    name "Test Process MPH_MAKEGRM"
    config "./nextflow.config"
    script "../main.nf"
    process "MPH_MAKEGRM"

    tag "modules"
    tag "modules_nfcore"
    tag "mph"
    tag "mph/makegrm"

    // The shipped popgen trio is 200 samples by 220 variants, every variant on chromosome 1 and none
    // monomorphic -- which matters here, because MPH's only default quality filter is dropping MAF-zero
    // variants and the `.grm.bin` header records the weight sum over the survivors, not over the file.
    def genotypes = """
                [
                    [ id:'plink_simulated' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.bed', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.bim', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.fam', checkIfExists: true)
                ]
    """

    // Native weight tables are deterministic derivatives of the existing PLINK fixture.
    def weights = """
                def bim = file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.bim')
                def ids = bim.readLines().collect { it.tokenize()[1] }
                file('dense_plan.snp_info.csv').text = 'SNP,all\\n' + ids.collect { it + ',1' }.join('\\n') + '\\n'
                file('ld_maf_plan.snp_info.csv').text = 'SNP,ld01,ld02\\n' + ids.withIndex().collect { id, index -> id + (index < ids.size().intdiv(2) ? ',1,0' : ',0,1') }.join('\\n') + '\\n'
    """

    def member = { bundle, suffix -> bundle.find { staged -> staged.toString().endsWith(suffix) } }

    // `int32 n` then a `float32` sum of the SNP weights over the post-quality-control variants. It is not
    // `sum2pq` and it is not a variant count except when every weight is 1, so it is read as what it is.
    def grmHeader = { binary ->
        def buffer = java.nio.ByteBuffer.wrap(new File(binary.toString()).bytes[0..7] as byte[]).order(java.nio.ByteOrder.LITTLE_ENDIAN)
        [buffer.getInt(), buffer.getFloat() as Double]
    }

    def command = { produced -> path(produced).parent.resolve('.command.sh').text }

    // The weight column as the task saw it, counted out of the SNP-information file staged beside the result.
    def weightedVariants = { produced, snpInfoName, column ->
        def lines = path(produced).parent.resolve(snpInfoName).readLines().findAll { line -> line.trim() }
        def index = (lines.first().split(',') as List).indexOf(column)
        lines.tail().count { line -> (line.split(',') as List)[index] == '1' }
    }

    test("homo_sapiens popgen - the one-component matrix is the declared size, header and identifier order") {

        when {
            process {
                """
                ${weights}
                input[0] = ${genotypes}
                input[1] = [[id:'dense_plan'],file('dense_plan.snp_info.csv'),'all']
                """
            }
        }

        then {
            def bundle = process.out.grm_files.get(0).get(1)
            def binary = member(bundle, '.grm.bin')
            def identifiers = member(bundle, '.grm.iid')
            def samples = path(identifiers).parent.resolve('plink_simulated.fam').readLines()
                .findAll { line -> line.trim() }
                .collect { line -> line.trim().tokenize()[1] }
            def declared = weightedVariants(binary, 'dense_plan.snp_info.csv', 'all')
            assertAll(
                { assert process.success },
                // MPH writes only `.grm.bin` and `.grm.iid` -- no `.grm.N.bin`, no `.grm.id` -- and the binary
                // is an 8-byte header followed by a row-major upper triangle of `float32`. Anything else in
                // this slot is a foreign layout that MPH would read to completion and answer wrongly from.
                { assert bundle.size() == 2 },
                { assert new File(binary.toString()).length() == 8 + 4 * samples.size() * (samples.size() + 1) / 2 },
                { assert grmHeader(binary)[0] == samples.size() },
                // Every weight in this plan is 1, so the weight sum is the post-quality-control predictor
                // count. It equals the number of weight-1 rows only because the fixture has no monomorphic
                // variant; MPH drops those before summing and says so nowhere but its own count lines.
                { assert grmHeader(binary)[1] == declared as Double },
                { assert path(binary).parent.resolve('plink_simulated.log').text.contains("${declared} post-QC variants are used for making GRM.") },
                // MPH indexes the matrix by the order of `.grm.iid` and nothing in its output detects a
                // violation: a correctly sized file in the wrong order is a stable, well-formed wrong answer
                // at exit 0. One identifier per line, in FAM order, is therefore asserted line for line.
                { assert path(identifiers).readLines() == samples },
                { assert command(binary).contains('--snp_weight_name "all"') },
                // The thread count is pinned rather than left to MPH's unset default of 1, because the caller
                // owns reproducibility here: the matrix is thread-invariant but the fit above it is not.
                { assert command(binary).contains('--num_threads') },
                { assert process.out.versions_mph.get(0) == ['MPH_MAKEGRM', 'mph', '0.55.1'] },
                // The matrix is byte-reproducible across thread counts and repeats, so the whole bundle is
                // snapshotted. Only the log carries wall-clock lines.
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ["log"])).match() }
            )
        }
    }

    test("homo_sapiens popgen - a second weight column builds a different matrix from the same bundle") {

        when {
            process {
                """
                ${weights}
                input[0] = Channel.of('ld01', 'ld02').map { column ->
                    [
                        [ id: column ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.bed', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.bim', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.fam', checkIfExists: true)
                    ]
                }
                input[1] = Channel.of('ld01','ld02').map { column -> [[id:'ld_maf_plan'],file('ld_maf_plan.snp_info.csv'),column] }
                """
            }
        }

        then {
            // Keyed by the requested column rather than read positionally, because two tasks of one process
            // complete in whatever order they finish in.
            def bundles = process.out.grm_files.collectEntries { entry -> [(entry.get(0).id): entry.get(1)] }
            def binaries = bundles.collectEntries { column, bundle -> [(column): member(bundle, '.grm.bin')] }
            assertAll(
                { assert process.success },
                { assert process.out.grm_files.size() == 2 },
                { assert bundles.keySet().sort() == ['ld01', 'ld02'] },
                // Each task built from the column its own identity names. Asserting this is what makes the
                // comparison below meaningful rather than a comparison of two unknown matrices.
                { assert command(binaries['ld01']).contains('--snp_weight_name "ld01"') },
                { assert command(binaries['ld02']).contains('--snp_weight_name "ld02"') },
                // Same bundle, same samples, same size, same header weight sum -- the two halves of the BIM
                // are equal in number -- and yet a different matrix, because the predictor sets are disjoint.
                { assert new File(binaries['ld01'].toString()).length() == new File(binaries['ld02'].toString()).length() },
                { assert grmHeader(binaries['ld01'])[0] == 200 },
                { assert grmHeader(binaries['ld02'])[0] == 200 },
                { assert grmHeader(binaries['ld01'])[1] == weightedVariants(binaries['ld01'], 'ld_maf_plan.snp_info.csv', 'ld01') as Double },
                { assert grmHeader(binaries['ld02'])[1] == weightedVariants(binaries['ld02'], 'ld_maf_plan.snp_info.csv', 'ld02') as Double },
                { assert path(binaries['ld01']).md5 != path(binaries['ld02']).md5 },
                { assert process.out.versions_mph.get(0) == ['MPH_MAKEGRM', 'mph', '0.55.1'] }
            )
        }
    }

    test("homo_sapiens popgen - stub") {

        options "-stub"

        when {
            process {
                """
                ${weights}
                input[0] = ${genotypes}
                input[1] = [[id:'dense_plan'],file('dense_plan.snp_info.csv'),'all']
                """
            }
        }

        then {
            def bundle = process.out.grm_files.get(0).get(1)
            def binary = member(bundle, '.grm.bin')
            assertAll(
                { assert process.success },
                { assert bundle.collect { staged -> file(staged).name }.sort() == ['plink_simulated.grm.bin', 'plink_simulated.grm.iid'] },
                { assert file(process.out.log.get(0).get(1)).name == 'plink_simulated.log' },
                // The stub writes a parseable 8-byte header rather than an empty file, because that header is
                // the first thing every consumer of this bundle reads.
                { assert new File(binary.toString()).length() == 8 },
                { assert grmHeader(binary) == [200, 0.0d] },
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ["log"])).match() }
            )
        }
    }
}
