nextflow_process {

    name "Test Process NORMALISE_LDAK_SUMCORS"
    script "../main.nf"
    process "NORMALISE_LDAK_SUMCORS"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "normalise_ldak_sumcors"

    def metadata = [
        id: 'pair_low_coverage',
        relationship_id: 'pair_low_coverage',
        request_id: 'ldak_sumcors--pair_low_coverage',
        method: 'ldak_sumcors',
        left_summary_statistics_id: 'left_low_coverage',
        right_summary_statistics_id: 'right_low_coverage',
        left_trait_id: 'LEFT_LOW_COVERAGE',
        right_trait_id: 'RIGHT_LOW_COVERAGE',
        left_trait_type: 'quantitative',
        right_trait_type: 'quantitative',
        left_population_prevalence: null,
        right_population_prevalence: null,
        left_sample_prevalence: null,
        right_sample_prevalence: null,
        native_args: ['--check-sums', 'NO'],
        effective_native_args: ['--check-sums', 'NO'],
        reference_metadata: [model: 'LDAK-Thin'],
        reference_validation: 'structural_availability_only',
        native_runtime: 'ghcr.io/lyh970817/gwas/ldak@sha256:f2b2157559e4346cab5e9f478ab70fc76359743ef06522fed9ad23769d735a6e',
    ]

    def nativeInputs = { outputDir, name, leftEstimate = '0.2' ->
        def root = new File(outputDir.toString(), "native_${name}")
        root.mkdirs()
        def correlations = new File(root, 'native.cors')
        correlations.text = """
        Her1_All ${leftEstimate} 0.01
        Her2_All 0.3 0.02
        Coher_All 0.1 0.01
        Cor_All 0.4 0.05
        Intercept1 1.0 0.1
        Intercept2 1.0 0.1
        Overlap 0.0 0.1
        """.stripIndent().trim() + '\n'
        def correlationsFull = new File(root, 'native.cors.full')
        correlationsFull.text = 'Category Correlation SE\n'
        def overlap = new File(root, 'native.overlap')
        overlap.text = 'Tagging_File_Predictors 100\nSummary_Statistic_Predictors 50\nOverlap_Proportion 0.5\n'
        def log = new File(root, 'native.log')
        log.text = 'LDAK SumCors completed\n'
        def leftPreparation = new File(root, 'left.preparation.json')
        leftPreparation.text = '{"strand_ambiguous_rows_present":0}\n'
        def rightPreparation = new File(root, 'right.preparation.json')
        rightPreparation.text = '{"strand_ambiguous_rows_present":0}\n'
        [
            correlations: correlations,
            correlationsFull: correlationsFull,
            overlap: overlap,
            log: log,
            leftPreparation: leftPreparation,
            rightPreparation: rightPreparation,
        ]
    }

    test("a low-coverage HIGH warning prevents a plain estimable classification") {
        when {
            def inputs = nativeInputs(outputDir, 'low_coverage')
            process {
                """
                input[0] = [new groovy.json.JsonSlurper().parseText('${groovy.json.JsonOutput.toJson(metadata)}'), file('${inputs.correlations}', checkIfExists: true), file('${inputs.correlationsFull}', checkIfExists: true), file('${inputs.overlap}', checkIfExists: true), file('${inputs.log}', checkIfExists: true), file('${inputs.leftPreparation}', checkIfExists: true), file('${inputs.rightPreparation}', checkIfExists: true), []]
                """
            }
        }

        then {
            def heritability = new File(process.out.heritability.get(0).get(1).toString()).readLines()
            def covariance = new File(process.out.genetic_covariance.get(0).get(1).toString()).readLines()
            def correlation = new File(process.out.genetic_correlation.get(0).get(1).toString()).readLines()
            def diagnostics = new File(process.out.diagnostics.get(0).get(1).toString()).readLines()
            def provenance = new groovy.json.JsonSlurper().parse(new File(process.out.provenance.get(0).get(1).toString()))
            def normalizedRows = heritability.tail() + covariance.tail() + correlation.tail()
            assertAll(
                { assert process.success },
                { assert provenance.warnings == ["HIGH: summary-statistics coverage is below LDAK's approximate 80% guidance under an explicit incomplete-summary override"] },
                { assert provenance.classification == 'estimable_with_warning' },
                { assert provenance.diagnostics.classification == 'estimable_with_warning' },
                { assert normalizedRows.every { row -> row.endsWith('\testimable_with_warning') } },
                { assert normalizedRows.every { row -> !row.endsWith('\testimable') } },
                { assert diagnostics.contains('ldak_sumcors--pair_low_coverage\tclassification\testimable_with_warning') },
            )
        }
    }

    test("nonestimable primary results take precedence over a low-coverage HIGH warning") {
        when {
            def inputs = nativeInputs(outputDir, 'low_coverage_nonestimable', 'NA')
            process {
                """
                input[0] = [new groovy.json.JsonSlurper().parseText('${groovy.json.JsonOutput.toJson(metadata)}'), file('${inputs.correlations}', checkIfExists: true), file('${inputs.correlationsFull}', checkIfExists: true), file('${inputs.overlap}', checkIfExists: true), file('${inputs.log}', checkIfExists: true), file('${inputs.leftPreparation}', checkIfExists: true), file('${inputs.rightPreparation}', checkIfExists: true), []]
                """
            }
        }

        then {
            def heritability = new File(process.out.heritability.get(0).get(1).toString()).readLines()
            def covariance = new File(process.out.genetic_covariance.get(0).get(1).toString()).readLines()
            def correlation = new File(process.out.genetic_correlation.get(0).get(1).toString()).readLines()
            def diagnostics = new File(process.out.diagnostics.get(0).get(1).toString()).readLines()
            def provenance = new groovy.json.JsonSlurper().parse(new File(process.out.provenance.get(0).get(1).toString()))
            def normalizedRows = heritability.tail() + covariance.tail() + correlation.tail()
            assertAll(
                { assert process.success },
                { assert provenance.warnings == ["HIGH: summary-statistics coverage is below LDAK's approximate 80% guidance under an explicit incomplete-summary override"] },
                { assert provenance.classification == 'completed_nonestimable' },
                { assert provenance.diagnostics.classification == 'completed_nonestimable' },
                { assert normalizedRows.every { row -> row.endsWith('\tcompleted_nonestimable') } },
                { assert diagnostics.contains('ldak_sumcors--pair_low_coverage\tclassification\tcompleted_nonestimable') },
            )
        }
    }
}
