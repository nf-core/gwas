params {
    module_args = ""
}

// The 200-sample, 220-marker fixture needs only a small native matrix.
process {
    cpus = 2
    memory = 2.GB
    withName: 'LDAK_FASTPCGC' {
        ext.args   = { params.module_args ?: "" }
    }

    // The setup-generated inputs are cut from files whose own extensions would collide with the staged PLINK 1
    // bundle, so each derivative names the role it plays rather than the file it came from.
    withName: 'GAWK_FACTORS' {
        ext.suffix = "catcovar"
    }

    withName: 'GAWK_WEIGHTS_ALL' {
        ext.suffix = "weights"
    }
}
