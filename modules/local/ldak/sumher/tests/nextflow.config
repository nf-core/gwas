params {
    module_args = ""
    ldak_sumher_fixture_base_path = "${projectDir}/modules/local/ldak/sumher/tests/fixtures/"
}

process {
    withName: LDAK_SUMHER {
        ext.args = { params.module_args ?: "" }
        // The pipeline's own bare `withName: 'LDAK_SUMHER'` block matches this scope too, because nf-test loads
        // the root `nextflow.config` for every test. Restate the module's own identity and drop the caller's
        // publication here, so the component contract is tested rather than the pipeline's routing policy —
        // and so the route's `publishDir` closure does not evaluate an unset `params.outdir` and an unset
        // `meta.request_id` into a literal `null/requests/ldak_sumher/null` tree beside the test.
        //
        // The suppression has to be qualified to the same degree as the block it overrides. Nextflow applies
        // `withName:` selectors in three passes — bare process name, then simple name, then fully qualified
        // name — and a later pass overwrites an earlier one whatever order the config files were loaded in. The
        // pipeline block is bare, so a bare selector here is the matching degree; if that block is ever
        // qualified by calling controller, this one has to be qualified with it or the `null/` tree returns.
        ext.prefix = { meta.id }
        publishDir = []
        cpus = 2
        memory = 2.GB
        container = System.getenv("LDAK_TEST_CONTAINER") ?: "ghcr.io/lyh970817/gwas/ldak@sha256:a0699bb7637ef2ba20c37fc6ef46b9533c78e68a022d770478a2fbb938e10a00"
    }
}
