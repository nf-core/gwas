params.module_args = ''
process {
    // No `ext.prefix` here: `--kvik-step2` reads the staged Step 1 bundle by its own basename, which is the
    // module's default prefix, and the setup process names that bundle.
    withName: LDAK_KVIKSTEP2 {
        ext.args = params.module_args
    }
    withName: LDAK_KVIKSTEP1 {
        ext.args = '--mpheno 1 --random-seed 7'
    }
}
