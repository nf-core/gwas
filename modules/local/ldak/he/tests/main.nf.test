nextflow_process {

    name "Test Process LDAK_HE"
    config "./nextflow.config"
    script "../main.nf"
    process "LDAK_HE"

    tag "modules"
    tag "modules_local"
    tag "ldak"
    tag "ldak/he"

    setup {
        run("LDAK_CALCKINS") {
            script "../../calckins/main.nf"
            process {
                """
                input[0] = [
                    [id: 'kinship'],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.bed', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.bim', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.fam', checkIfExists: true),
                    -0.25
                ]
                input[1] = [[id: 'weights'], []]
                """
            }
        }
        run("GAWK", alias: "GAWK_QUANT_PHENO") {
            script "../../../../nf-core/gawk/main.nf"
            process {
                """
                input[0] = [[id: 'quantitative'], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated_quantitative_phenoname.phe', checkIfExists: true)]
                input[1] = Channel.of('FNR == 1 { next } { print \$1, \$2, \$3 }').collectFile(name: 'quantitative_phenotype.awk')
                input[2] = false
                """
            }
        }
        run("GAWK", alias: "GAWK_BINARY_PHENO") {
            script "../../../../nf-core/gawk/main.nf"
            process {
                """
                input[0] = [[id: 'binary'], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated_quantitative_phenoname.phe', checkIfExists: true)]
                input[1] = Channel.of('FNR == 1 { next } { print \$1, \$2, (\$3 > 0 ? 1 : 0) }').collectFile(name: 'binary_phenotype.awk')
                input[2] = false
                """
            }
        }
    }

    test("quantitative phenotype without prevalence reports the observed scale") {
        when {
            process {
                """
                input[0] = GAWK_QUANT_PHENO.out.output.map { _meta, phenotype -> [[id: 'he_quantitative'], phenotype, []] }
                input[1] = LDAK_CALCKINS.out.ldak_grm.map { meta, bin, ids, details, adjust -> [meta, [bin, ids, details, adjust]] }
                input[2] = [[id: 'keep'], []]
                input[3] = [[id: 'qcovar'], []]
                input[4] = [[id: 'factors'], []]
                """
            }
        }
        then {
            def command = path(process.out.he_results.get(0).get(1)).parent.resolve('.command.sh').text
            assertAll(
                { assert process.success },
                { assert !command.contains('--prevalence') },
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ['log'])).match() }
            )
        }
    }

    test("binary phenotype with prevalence reports the liability scale and conversion factors") {
        when {
            process {
                """
                input[0] = GAWK_BINARY_PHENO.out.output.map { _meta, phenotype -> [[id: 'he_binary'], phenotype, 0.1] }
                input[1] = LDAK_CALCKINS.out.ldak_grm.map { meta, bin, ids, details, adjust -> [meta, [bin, ids, details, adjust]] }
                input[2] = [[id: 'keep'], []]
                input[3] = [[id: 'qcovar'], []]
                input[4] = [[id: 'factors'], []]
                """
            }
        }
        then {
            def command = path(process.out.he_results.get(0).get(1)).parent.resolve('.command.sh').text
            assertAll(
                { assert process.success },
                { assert command.contains('--prevalence "0.1"') },
                { assert path(process.out.he_liability.get(0).get(1)).text.contains('Her_All') },
                { assert path(process.out.factor.get(0).get(1)).text.contains('Scaling_Factor_Observed->Liability') },
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ['log'])).match() }
            )
        }
    }

    test("binary phenotype with prevalence - stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = GAWK_BINARY_PHENO.out.output.map { _meta, phenotype -> [[id: 'he_stub'], phenotype, 0.1] }
                input[1] = LDAK_CALCKINS.out.ldak_grm.map { meta, bin, ids, details, adjust -> [meta, [bin, ids, details, adjust]] }
                input[2] = [[id: 'keep'], []]
                input[3] = [[id: 'qcovar'], []]
                input[4] = [[id: 'factors'], []]
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ['log'])).match() }
            )
        }
    }
}
