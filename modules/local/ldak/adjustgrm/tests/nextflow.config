params {
    module_args = ""
}

// The 200-sample, 220-marker fixture needs only a small native matrix.
process {
    withName: 'GAWK_KEEP' { ext.suffix = 'keep' }
    cpus = 2
    memory = 2.GB
    withName: 'LDAK_ADJUSTGRM' {
        ext.args = { params.module_args ?: "" }
    }
    withName: 'GAWK_QUANT_PHENO' { ext.prefix = 'quantitative.pheno' }
    withName: 'GAWK_BINARY_PHENO' { ext.prefix = 'binary.pheno' }
    withName: 'GAWK_COVAR' { ext.prefix = 'numeric.covar' }
}
