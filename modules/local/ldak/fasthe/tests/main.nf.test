nextflow_process {

    name "Test Process LDAK_FASTHE"
    config "./nextflow.config"
    script "../main.nf"
    process "LDAK_FASTHE"

    tag "modules"
    tag "modules_local"
    tag "modules_nfcore"
    tag "ldak"
    tag "ldak/fasthe"
    tag "gawk"

    setup {
        run("GAWK", alias: "GAWK_QUANT_PHENO") {
            script "../../../../nf-core/gawk/main.nf"
            process {
                """
                input[0] = [
                    [ id: 'quantitative' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated_quantitative_phenoname.phe', checkIfExists: true)
                ]
                input[1] = Channel.of('FNR == 1 { next } { print \$1, \$2, \$3 }').collectFile(name: 'quantitative_phenotype.awk')
                input[2] = false
                """
            }
        }

        run("GAWK", alias: "GAWK_BINARY_PHENO") {
            script "../../../../nf-core/gawk/main.nf"
            process {
                """
                input[0] = [
                    [ id: 'binary' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated_quantitative_phenoname.phe', checkIfExists: true)
                ]
                input[1] = Channel.of('FNR == 1 { next } { print \$1, \$2, (\$3 > 0 ? 1 : 0) }').collectFile(name: 'binary_phenotype.awk')
                input[2] = false
                """
            }
        }

        run("GAWK", alias: "GAWK_QUANT_COVAR") {
            script "../../../../nf-core/gawk/main.nf"
            process {
                """
                input[0] = [
                    [ id: 'covariates' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated_covariates.txt', checkIfExists: true)
                ]
                input[1] = Channel.of('FNR == 1 { next } { print }').collectFile(name: 'quantitative_covariates.awk')
                input[2] = false
                """
            }
        }

        run("GAWK", alias: "GAWK_FACTORS") {
            script "../../../../nf-core/gawk/main.nf"
            process {
                """
                input[0] = [
                    [ id: 'factors' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.fam', checkIfExists: true)
                ]
                input[1] = Channel.of('{ print \$1, \$2, (FNR % 2 ? 1 : 2) }').collectFile(name: 'categorical_covariates.awk')
                input[2] = false
                """
            }
        }

        run("GAWK", alias: "GAWK_WEIGHTS_ALL") {
            script "../../../../nf-core/gawk/main.nf"
            process {
                """
                input[0] = [
                    [ id: 'weights_all' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.bim', checkIfExists: true)
                ]
                input[1] = Channel.of('{ print \$2, 1 }').collectFile(name: 'weights_all.awk')
                input[2] = false
                """
            }
        }

        run("GAWK", alias: "GAWK_WEIGHTS_HALF") {
            script "../../../../nf-core/gawk/main.nf"
            process {
                """
                input[0] = [
                    [ id: 'weights_half' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.bim', checkIfExists: true)
                ]
                input[1] = Channel.of('FNR % 2 { print \$2, 1 }').collectFile(name: 'weights_half.awk')
                input[2] = false
                """
            }
        }
    }

    def genotypes = """
                [
                    [ id: 'plink_simulated' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.bed', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.bim', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.fam', checkIfExists: true),
                    -0.25
                ]
    """

    test("homo_sapiens popgen - quantitative trait with quantitative and categorical covariates") {

        when {
            params {
                module_args = "--mpheno 1 --ignore-weights YES --random-seed 7"
            }
            process {
                """
                input[0] = GAWK_QUANT_PHENO.out.output.map { _meta, phenotype -> [[ id: 'fast_he_covariates' ], phenotype, []] }
                input[1] = ${genotypes}
                input[2] = [[ id: 'weights' ], []]
                input[3] = GAWK_QUANT_COVAR.out.output.map { _meta, covariates -> [[ id: 'fast_he_covariates' ], covariates] }
                input[4] = GAWK_FACTORS.out.output.map { _meta, covariates -> [[ id: 'fast_he_covariates' ], covariates] }
                """
            }
        }

        then {
            def resultFile = path(process.out.fasthe_results.get(0).get(1))
            def command = resultFile.parent.resolve(".command.sh").text.replaceAll(/\s+/, " ")
            def headerValue = { name -> resultFile.readLines().find { line -> line.startsWith("${name} ") }.split(/\s+/)[1] }
            assertAll(
                { assert process.success },
                // The direct-genotype contract: raw PLINK 1 in, no kinship of any kind.
                { assert command.contains('--fast-he "fast_he_covariates"') },
                { assert command.contains('--bfile "plink_simulated"') },
                { assert command.contains('--power "-0.25"') },
                { assert command.contains('--covar "covariates.txt"') },
                { assert command.contains('--factors "factors.catcovar"') },
                { assert command.contains("--mpheno 1") },
                { assert command.contains("--random-seed 7") },
                { assert !command.contains("--grm") },
                { assert !command.contains("--weights") },
                { assert !command.contains("--prevalence") },
                // Four quantitative columns plus one two-level factor's single indicator, plus the intercept.
                { assert headerValue('Num_Covariates') == "6" },
                { assert headerValue('Total_Samples') == "200" },
                { assert headerValue('With_Phenotypes') == "200" },
                { assert resultFile.text.contains("Her_All") },
                // `--factors` is what produces the combined covariate echo; `--prevalence` was not passed, so
                // the liability-scale family is absent.
                { assert process.out.combined.size() == 1 },
                { assert process.out.fasthe_liability.size() == 0 },
                { assert process.out.factor.size() == 0 },
                { assert process.out.versions_ldak6.get(0).get(1) == "ldak6" },
                { assert process.out.versions_ldak6.get(0).get(2) == "6" },
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ["log"])).match() }
            )
        }
    }

    test("homo_sapiens popgen - full-coverage weights with reduced repetitions and jackknife blocks") {

        when {
            params {
                module_args = "--mpheno 1 --repetitions 10 --num-blocks 20 --random-seed 7"
            }
            process {
                """
                input[0] = GAWK_QUANT_PHENO.out.output.map { _meta, phenotype -> [[ id: 'fast_he_weights' ], phenotype, []] }
                input[1] = ${genotypes}
                input[2] = GAWK_WEIGHTS_ALL.out.output.map { _meta, weights -> [[ id: 'weights_all' ], weights] }
                input[3] = [[ id: 'quantitative_covariates' ], []]
                input[4] = [[ id: 'categorical_covariates' ], []]
                """
            }
        }

        then {
            def resultFile = path(process.out.fasthe_results.get(0).get(1))
            def command = resultFile.parent.resolve(".command.sh").text.replaceAll(/\s+/, " ")
            assertAll(
                { assert process.success },
                { assert command.contains('--weights "weights_all.weights"') },
                { assert !command.contains("--ignore-weights") },
                { assert !command.contains("--covar") },
                { assert !command.contains("--factors") },
                // The two stochastic controls are observable in the artifacts they size.
                { assert path(process.out.repetitions.get(0).get(1)).readLines().size() == 10 },
                { assert path(process.out.jackests.get(0).get(1)).readLines().size() == 20 },
                // No `--factors`, so no combined covariate echo.
                { assert process.out.combined.size() == 0 },
                // Full predictor coverage: LDAK zero-weights nothing and says nothing about it.
                { assert !path(process.out.log.get(0).get(1)).text.contains("contains weights for only") },
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ["log"])).match() }
            )
        }
    }

    test("homo_sapiens popgen - weights covering only half the predictors warn and change the estimate") {

        when {
            params {
                module_args = "--mpheno 1 --random-seed 7"
            }
            process {
                """
                def coverage = GAWK_QUANT_PHENO.out.output
                    .combine(GAWK_WEIGHTS_ALL.out.output)
                    .combine(GAWK_WEIGHTS_HALF.out.output)
                    .flatMap { _pheno_meta, phenotype, _all_meta, all_weights, _half_meta, half_weights ->
                        [['all_predictors', phenotype, all_weights], ['half_predictors', phenotype, half_weights]]
                    }
                    .multiMap { id, phenotype, weights ->
                        pheno: [[ id: id ], phenotype, []]
                        genotypes: ${genotypes.trim()}
                        weights: [[ id: id ], weights]
                        qcovar: [[ id: id ], []]
                        covar: [[ id: id ], []]
                    }

                input[0] = coverage.pheno
                input[1] = coverage.genotypes
                input[2] = coverage.weights
                input[3] = coverage.qcovar
                input[4] = coverage.covar
                """
            }
        }

        then {
            // A weights file naming only some of the BIM predictors is not an error: LDAK gives the rest
            // weight zero, warns, and returns a different estimate. Both coverages run in one invocation so
            // the comparison is against the other record of the same seeded run, not a remembered number.
            def resultById = process.out.fasthe_results.collectEntries { meta, results -> [(meta.id): path(results)] }
            def logById = process.out.log.collectEntries { meta, logfile -> [(meta.id): path(logfile)] }
            def heritability = { results -> results.readLines().find { line -> line.startsWith('Her_All') }.split(/\s+/)[1] }
            assertAll(
                { assert process.success },
                { assert resultById.keySet().toList().sort() == ['all_predictors', 'half_predictors'] },
                { assert logById['half_predictors'].text.contains("contains weights for only 110 of the 220 predictors") },
                { assert logById['half_predictors'].text.contains("the remaining predictors will be given weight zero") },
                { assert !logById['all_predictors'].text.contains("contains weights for only") },
                { assert heritability(resultById['half_predictors']) != heritability(resultById['all_predictors']) }
            )
        }
    }

    test("homo_sapiens popgen - omitting the weights flag gives equal weights") {

        when {
            params {
                module_args = "--mpheno 1 --random-seed 7"
            }
            process {
                """
                def policies = GAWK_QUANT_PHENO.out.output
                    .flatMap { _meta, phenotype ->
                        [['equal_policy_explicit', phenotype], ['equal_policy_native', phenotype]]
                    }
                    .multiMap { id, phenotype ->
                        pheno: [[ id: id ], phenotype, []]
                        genotypes: ${genotypes.trim()}
                        weights: [[ id: id ], []]
                        qcovar: [[ id: id ], []]
                        covar: [[ id: id ], []]
                    }

                input[0] = policies.pheno
                input[1] = policies.genotypes
                input[2] = policies.weights
                input[3] = policies.qcovar
                input[4] = policies.covar
                """
            }
        }

        then {
            // `--ignore-weights YES` only suppresses a weights lookup that never happens without `--weights`,
            // so passing it and passing nothing are the same native operation. The
            // `Coeffsfile` line names the output prefix and is the only difference the two may legitimately
            // have.
            def resultById = process.out.fasthe_results.collectEntries { meta, results -> [(meta.id): path(results)] }
            def jackestsById = process.out.jackests.collectEntries { meta, jackests -> [(meta.id): path(jackests)] }
            def repetitionsById = process.out.repetitions.collectEntries { meta, repetitions -> [(meta.id): path(repetitions)] }
            def commandById = process.out.log.collectEntries { meta, logfile -> [(meta.id): path(logfile).parent.resolve(".command.sh").text.replaceAll(/\s+/, " ")] }
            def withoutCoeffsfile = { results -> results.readLines().findAll { line -> !line.startsWith('Coeffsfile') } }
            assertAll(
                { assert process.success },
                { assert commandById['equal_policy_explicit'].contains("--ignore-weights YES") },
                { assert !commandById['equal_policy_native'].contains("--ignore-weights") },
                { assert withoutCoeffsfile(resultById['equal_policy_explicit']) == withoutCoeffsfile(resultById['equal_policy_native']) },
                { assert jackestsById['equal_policy_explicit'].text == jackestsById['equal_policy_native'].text },
                { assert repetitionsById['equal_policy_explicit'].text == repetitionsById['equal_policy_native'].text }
            )
        }
    }

    test("homo_sapiens popgen - a binary trait with a declared prevalence adds the liability-scale family") {

        when {
            params {
                module_args = "--mpheno 1 --ignore-weights YES --random-seed 7"
            }
            process {
                """
                input[0] = GAWK_BINARY_PHENO.out.output.map { _meta, phenotype -> [[ id: 'fast_he_binary' ], phenotype, 0.3] }
                input[1] = ${genotypes}
                input[2] = [[ id: 'weights' ], []]
                input[3] = [[ id: 'quantitative_covariates' ], []]
                input[4] = [[ id: 'categorical_covariates' ], []]
                """
            }
        }

        then {
            // The atom describes the native operation, not one pipeline policy: `--prevalence` reaching
            // `--fast-he` produces a liability-scale result and its scaling factors, and the module declares
            // both for callers that supply the optional prevalence.
            assertAll(
                { assert process.success },
                { assert process.out.fasthe_liability.size() == 1 },
                { assert process.out.factor.size() == 1 },
                { assert path(process.out.factor.get(0).get(1)).text.contains("Scaling_Factor_Observed->Liability") },
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ["log"])).match() }
            )
        }
    }

    test("homo_sapiens popgen - a prevalence on a quantitative trait fails") {

        when {
            params {
                module_args = "--mpheno 1"
            }
            process {
                """
                input[0] = GAWK_QUANT_PHENO.out.output.map { _meta, phenotype -> [[ id: 'fast_he_not_binary' ], phenotype, 0.3] }
                input[1] = ${genotypes}
                input[2] = [[ id: 'weights' ], []]
                input[3] = [[ id: 'quantitative_covariates' ], []]
                input[4] = [[ id: 'categorical_covariates' ], []]
                """
            }
        }

        then {
            assertAll(
                { assert !process.success },
                { assert process.exitStatus != 0 }
            )
        }
    }

    test("homo_sapiens popgen - quantitative trait with quantitative and categorical covariates - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = GAWK_QUANT_PHENO.out.output.map { _meta, phenotype -> [[ id: 'fast_he_stub' ], phenotype, []] }
                input[1] = ${genotypes}
                input[2] = [[ id: 'weights' ], []]
                input[3] = GAWK_QUANT_COVAR.out.output.map { _meta, covariates -> [[ id: 'fast_he_stub' ], covariates] }
                input[4] = GAWK_FACTORS.out.output.map { _meta, covariates -> [[ id: 'fast_he_stub' ], covariates] }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert file(process.out.fasthe_results.get(0).get(1)).name == "fast_he_stub.fasthe" },
                { assert file(process.out.log.get(0).get(1)).name == "fast_he_stub.log" },
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ["log"])).match() }
            )
        }
    }
}
