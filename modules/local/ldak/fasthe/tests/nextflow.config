params {
    module_args = ""
}

process {
    // Two records of one invocation are compared directly in the weights-policy case, and they differ only in
    // whether the native equal-weights opt-out is passed. That flag is a process-level extension argument
    // rather than a tuple member, so the closure selects it by the record's own identity.
    withName: 'LDAK_FASTHE' {
        ext.args   = { [params.module_args ?: "", meta.id == "equal_policy_explicit" ? "--ignore-weights YES" : ""].join(" ").trim() }
        // The pipeline's own bare `withName: 'LDAK_FASTHE'` block matches this scope too, because nf-test loads
        // the root `nextflow.config` for every test. Restate the module's own identity and drop the caller's
        // publication here, so the component contract is tested rather than the pipeline's routing policy —
        // and so the route's `publishDir` closure does not evaluate an unset `params.outdir` into a literal
        // `null/` tree beside the test.
        ext.prefix = { meta.id }
        publishDir = []
        cpus       = 2
        memory     = 2.GB
    }

    // The setup-generated inputs are cut from files whose own extensions would collide with the staged PLINK 1
    // bundle, so each derivative names the role it plays rather than the file it came from.
    withName: 'GAWK_FACTORS' {
        ext.suffix = "catcovar"
    }

    withName: 'GAWK_WEIGHTS_ALL|GAWK_WEIGHTS_HALF' {
        ext.suffix = "weights"
    }
}
