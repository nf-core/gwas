nextflow_process {
    name "Test Process LDAK_REML"
    script "../main.nf"
    process "LDAK_REML"
    config "./nextflow.config"
    tag "modules"
    tag "modules_nfcore"
    tag "ldak"
    tag "ldak/calckins"
    tag "gawk"
    tag "ldak/reml"

    setup {
        run("LDAK_CALCKINS") {
            script "../../calckins/main.nf"
            process {
                """
                input[0] = [
                    [id: 'kinship'],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.bed', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.bim', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.fam', checkIfExists: true),
                    -0.25
                ]
                input[1] = [[id: 'weights'], []]
                """
            }
        }
        run("GAWK", alias: "GAWK_QUANT_PHENO") {
            script "../../../../nf-core/gawk/main.nf"
            process {
                """
                input[0] = [[id: 'quantitative'], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated_quantitative_phenoname.phe', checkIfExists: true)]
                input[1] = Channel.of('FNR == 1 { next } { print \$1, \$2, \$3 }').collectFile(name: 'quantitative_phenotype.awk')
                input[2] = false
                """
            }
        }
        run("GAWK", alias: "GAWK_BINARY_PHENO") {
            script "../../../../nf-core/gawk/main.nf"
            process {
                """
                input[0] = [[id: 'binary'], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated_quantitative_phenoname.phe', checkIfExists: true)]
                input[1] = Channel.of('FNR == 1 { next } { print \$1, \$2, (\$3 > 0 ? 1 : 0) }').collectFile(name: 'binary_phenotype.awk')
                input[2] = false
                """
            }
        }
        run("GAWK", alias: "GAWK_COVAR") {
            script "../../../../nf-core/gawk/main.nf"
            process {
                """
                input[0] = [[id: 'covariates'], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated_covariates.txt', checkIfExists: true)]
                input[1] = channel.of('FNR == 1 { next } { print \$1, \$2, \$4, \$5 }').collectFile(name: 'covariates.awk')
                input[2] = false
                """
            }
        }
        run("GAWK", alias: "GAWK_KEEP") {
            script "../../../../nf-core/gawk/main.nf"
            process {
                """
                input[0] = [[id: 'sample_subset'], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.fam', checkIfExists: true)]
                input[1] = channel.of('NR <= 180 { print \$1, \$2 }').collectFile(name: 'subset.awk')
                input[2] = false
                """
            }
        }
        run("GAWK", alias: "GAWK_FACTORS") {
            script "../../../../nf-core/gawk/main.nf"
            process {
                """
                input[0] = [[id: 'factors'], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated_covariates.txt', checkIfExists: true)]
                input[1] = channel.of('FNR == 1 { next } { print \$1, \$2, \$3 }').collectFile(name: 'factors.awk')
                input[2] = false
                """
            }
        }
    }

    test("binary phenotype") {

        when {
            params { module_args = '--mpheno 1 --random-seed 7 --prevalence 0.1' }
            process {
                """
                input[0] = GAWK_BINARY_PHENO.out.output.map { _meta, phenotype -> [[id: 'reml_analysis'], phenotype] }
                input[1] = LDAK_CALCKINS.out.ldak_grm
                input[2] = [[id: 'keep'], []]
                input[3] = [[id: 'qcovar'], []]
                input[4] = [[id: 'factors'], []]
                """
            }
        }
        then {
            assertAll(
                { assert process.success },

                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ['log'])).match() }
            )
        }
    }

    test("explicit sample subset with quantitative and categorical covariates") {

        when {
            params { module_args = '--mpheno 1 --random-seed 7' }

            process {
                """
                input[0] = GAWK_QUANT_PHENO.out.output.map { _meta, phenotype -> [[id: 'reml_analysis'], phenotype] }
                input[1] = LDAK_CALCKINS.out.ldak_grm
                input[2] = GAWK_KEEP.out.output
                input[3] = GAWK_COVAR.out.output
                input[4] = GAWK_FACTORS.out.output
                """
            }
        }
        then {
            assertAll(
                { assert process.success },

                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ['log'])).match() }
            )
        }
    }

    test("quantitative phenotype") {

        when {
            params { module_args = '--mpheno 1 --random-seed 7' }

            process {
                """
                input[0] = GAWK_QUANT_PHENO.out.output.map { _meta, phenotype -> [[id: 'reml_analysis'], phenotype] }
                input[1] = LDAK_CALCKINS.out.ldak_grm
                input[2] = [[id: 'keep'], []]
                input[3] = [[id: 'qcovar'], []]
                input[4] = [[id: 'factors'], []]
                """
            }
        }
        then {
            assertAll(
                { assert process.success },

                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ['log'])).match() }
            )
        }
    }

    test("native operation - stub") {
        options "-stub"
        when {
            params { module_args = '--mpheno 1 --random-seed 7 --prevalence 0.1' }
            process {
                """
                input[0] = GAWK_BINARY_PHENO.out.output.map { _meta, phenotype -> [[id: 'reml_analysis'], phenotype] }
                input[1] = LDAK_CALCKINS.out.ldak_grm
                input[2] = [[id: 'keep'], []]
                input[3] = [[id: 'qcovar'], []]
                input[4] = [[id: 'factors'], []]
                """
            }
        }
        then {
            assertAll(
                { assert process.success },

                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ['log'])).match() }
            )
        }
    }

}
