// Component-local test arguments, loaded explicitly from this module's test.
//
// `nextflow.config` includes `conf/modules/genotypes.config` unconditionally and nf-test's own `configFile`
// is additive, so the pipeline's bare `withName: 'PLINK2_MAKEBED'` selector reaches a module-level test too.
// That selector renders the projection policy out of `meta.settings`, which a module test does not build.
// Declaring the static arguments here keeps them out of the pipeline-level `tests/nextflow.config`, where an
// override would replace the production closure for every pipeline test and silently drop the policy flag.
process {
    withName: 'PLINK2_MAKEBED' {
        ext.args = '--hard-call-threshold 0.1'
    }
    withName: 'PLINK2_VCF' {
        ext.args = '--double-id --vcf-half-call error'
    }
}
