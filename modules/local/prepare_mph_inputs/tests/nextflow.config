process {
    // The pipeline's own blocks for this process are qualified by their calling controller, so they do not
    // reach a bare process scope. The prefix is restated here because it is route-local state a component test
    // does not mint; the pipeline blocks publish nothing, so there is no publication policy to suppress.
    withName: 'PREPARE_MPH_INPUTS' {
        ext.prefix = { meta.id }
    }
}
