params {
    fit_args  = '--phenoColList QuantitativeTrait --use-relative-path'
    test_args = '--phenoColList QuantitativeTrait'
}

process {
    // The public simulated fixture has 200 samples and 220 variants.
    withName: 'REGENIE_.*' {
        cpus   = 1
        memory = '2.GB'
    }
    // Fit and test products share one work directory only through the staged bundle, so the fit prefix
    // keeps the producer's own files apart from the test event's.
    withName: 'REGENIE_STEP1|REGENIE_SPLITL0|REGENIE_RUNL0|REGENIE_RUNL1' {
        ext.args   = { params.fit_args }
        ext.prefix = { "${meta.id}.fit" }
    }
    withName: REGENIE_STEP2 {
        ext.args = { params.test_args }
    }
}
