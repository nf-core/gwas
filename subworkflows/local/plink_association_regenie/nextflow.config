// IMPORTANT: Add this configuration to your modules.config

// REGENIE writes the absolute work-directory path of every LOCO file into the native prediction list.
// This composition stages one complete bundle into every Step 2 task, so the list must address its
// companions by their staged names. Only the Step 1 fit commands accept the native flag.
process {
    withName: '.*:PLINK_ASSOCIATION_REGENIE:PLINK_FIT_REGENIE:(REGENIE_STEP1|REGENIE_SPLITL0|REGENIE_RUNL0|REGENIE_RUNL1)' {
        ext.args = '--use-relative-path'
    }
}
