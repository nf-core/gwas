nextflow_workflow {

    name "Test subworkflow PREPARE_COHORT_GENOTYPES"
    script "../main.nf"
    workflow "PREPARE_COHORT_GENOTYPES"
    tag "subworkflow"
    tag "subworkflows_local"
    tag "genotypes"

    // The pipeline-level suite can see that a cohort was prepared once because preparation appears in
    // the execution trace. This focused test verifies the other half of the contract directly at the
    // seam: every request on that cohort receives the prepared bundle, in the representation the cohort
    // was supplied in. No registered method reads PLINK 1 yet, so the projection branch is exercised only by
    // the nf-core/modules `plink2/makebed` test; the request-facing PLINK 1 stream is asserted empty here.

    def fixtures = { project_dir -> "${FIXTURES.base(project_dir)}results/fixtures/genotypes/" }

    def extensions = { members -> members.collect { member -> member.toString().tokenize('.').last() } }

    test("every request on a cohort receives that cohort's native bundle") {

        when {
            workflow {
                """
                def bundle = { names -> names.collect { name -> file('${fixtures.call(projectDir)}' + name, checkIfExists: true) } }

                input[0] = channel.fromList([
                    [[id: 'plink2_qt1', cohort: 'cohort_plink2', genotype_format: 'plink2', association_methods: [], heritability_methods: []], bundle.call(['example_all.pgen', 'example_all.psam', 'example_all.pvar'])],
                    [[id: 'plink2_qt2', cohort: 'cohort_plink2', genotype_format: 'plink2', association_methods: [], heritability_methods: []], bundle.call(['example_all.pgen', 'example_all.psam', 'example_all.pvar'])],
                    [[id: 'plink2_qt3', cohort: 'cohort_plink2', genotype_format: 'plink2', association_methods: [], heritability_methods: []], bundle.call(['example_all.pgen', 'example_all.psam', 'example_all.pvar'])],
                    [[id: 'plink2_qt4', cohort: 'cohort_plink2', genotype_format: 'plink2', association_methods: [], heritability_methods: []], bundle.call(['example_all.pgen', 'example_all.psam', 'example_all.pvar'])],
                    [[id: 'plink1_qt', cohort: 'cohort_plink1', genotype_format: 'plink1', association_methods: [], heritability_methods: []], bundle.call(['example_all.bed', 'example_all.bim', 'example_all.fam'])],
                ])
                """
            }
        }

        then {
            def cohorts = workflow.out.cohort_native_genotypes.collect { meta, primary, variant_file, sample_file ->
                [meta, extensions.call([primary, variant_file, sample_file])]
            }.sort { entry -> entry[0].id }
            assertAll(
                { assert workflow.success },
                // Nothing after the first request on cohort_plink2 is dropped, and nothing is duplicated: one
                // bundle out per request in, keyed by the focal request identifier rather than by the cohort.
                { assert workflow.out.native_genotypes.collect { meta, _primary, _variant_file, _sample_file -> meta.id }.sort() ==
                    ['plink1_qt', 'plink2_qt1', 'plink2_qt2', 'plink2_qt3', 'plink2_qt4'] },
                // The cohort side is a reduction of that same set: two distinct cohorts, two bundles.
                { assert cohorts.collect { meta, _members -> meta.id } == ['cohort_plink1', 'cohort_plink2'] },
                // Representation is preserved. `genotype_format` keeps the manifest's meaning while
                // `native_format` states the same representation on disk.
                { assert cohorts.collect { meta, _members -> meta.genotype_format } == ['plink1', 'plink2'] },
                { assert cohorts.collect { meta, _members -> meta.native_format } == ['plink1', 'plink2'] },
                // Format-polymorphic member order at the native emit: primary, variant file, sample file.
                { assert cohorts.find { meta, _members -> meta.id == 'cohort_plink1' }[1] == ['bed', 'bim', 'fam'] },
                { assert cohorts.find { meta, _members -> meta.id == 'cohort_plink2' }[1] == ['pgen', 'pvar', 'psam'] },
                // Neither cohort is converted for its native consumers.
                { assert TRACE.count(workflow, 'PLINK2_MAKEBED') == 0 },
                { assert TRACE.count(workflow, 'PREPARE_GENOTYPE_SOURCE') == 2 },
                { assert workflow.out.plink1_genotypes.isEmpty() },
                { assert workflow.out.cohort_plink1_view_keys.isEmpty() },
                { assert workflow.out.cohort_native_view_keys.size() == 2 },
            )
        }
    }

    test("a PLINK 2 cohort is never projected while no consumer reads PLINK 1") {

        when {
            workflow {
                """
                def bundle = { names -> names.collect { name -> file('${fixtures.call(projectDir)}' + name, checkIfExists: true) } }
                def genotypes = bundle.call(['example_all.pgen', 'example_all.psam', 'example_all.pvar'])

                input[0] = channel.fromList([
                    [[id: 'plink2_qt1', cohort: 'cohort_plink2', genotype_format: 'plink2', association_methods: [], heritability_methods: []], genotypes],
                    [[id: 'plink2_qt2', cohort: 'cohort_plink2', genotype_format: 'plink2', association_methods: [], heritability_methods: []], genotypes],
                ])
                """
            }
        }

        then {
            def view = workflow.out.cohort_views.first()[1]
            assertAll(
                { assert workflow.success },
                { assert TRACE.count(workflow, 'PLINK2_MAKEBED') == 0 },
                { assert workflow.out.plink1_genotypes.isEmpty() },
                { assert workflow.out.cohort_plink1_view_keys.isEmpty() },
                { assert view.plink1 == null },
            )
        }
    }

    test("a declared view identity is used as supplied and the files are never digested") {

        when {
            workflow {
                """
                def bundle = { names -> names.collect { name -> file('${fixtures.call(projectDir)}' + name, checkIfExists: true) } }

                input[0] = channel.fromList([
                    [[id: 'bare', cohort: 'cohort_bare', genotype_format: 'plink1', genotype_view_id: '52d1d326413775cd', association_methods: [], heritability_methods: []], bundle.call(['example_all.bed', 'example_all.bim', 'example_all.fam'])],
                    [[id: 'namespaced', cohort: 'cohort_namespaced', genotype_format: 'plink2', genotype_view_id: 'biofuse:52d1d326413775cd', association_methods: [], heritability_methods: []], bundle.call(['example_all.pgen', 'example_all.psam', 'example_all.pvar'])],
                ])
                """
            }
        }

        then {
            def views = workflow.out.cohort_views.collectEntries { cohort_meta, view -> [(cohort_meta.id): view] }
            assertAll(
                { assert workflow.success },
                // A declared identity is the whole point of a mounted view: the pipeline never opens the
                // files to learn what they are.
                { assert TRACE.count(workflow, 'PREPARE_GENOTYPE_SOURCE') == 0 },
                { assert views['cohort_bare'].source.identity == [mode: 'declared', value: '52d1d326413775cd'] },
                { assert views['cohort_namespaced'].source.identity == [mode: 'declared', value: 'biofuse:52d1d326413775cd'] },
                { assert views.every { _cohort_id, view -> view.source.members == null } },
            )
        }
    }

    test("two cohort identifiers over identical bytes share one view identity") {

        when {
            workflow {
                """
                def bundle = { names -> names.collect { name -> file('${fixtures.call(projectDir)}' + name, checkIfExists: true) } }
                def genotypes = bundle.call(['example_all.bed', 'example_all.bim', 'example_all.fam'])

                input[0] = channel.fromList([
                    [[id: 'left', cohort: 'cohort_left', genotype_format: 'plink1', association_methods: [], heritability_methods: []], genotypes],
                    [[id: 'right', cohort: 'cohort_right', genotype_format: 'plink1', association_methods: [], heritability_methods: []], genotypes],
                ])
                """
            }
        }

        then {
            def keys = workflow.out.cohort_native_view_keys.collect { _cohort_id, key -> key }
            assertAll(
                { assert workflow.success },
                // Equality is content equality: the identity folds the member roles and digests, not the
                // cohort identifier and not the file names, so both cohorts key every downstream artifact
                // the same way and share one build of it.
                { assert keys.size() == 2 },
                { assert keys.unique().size() == 1 },
            )
        }
    }

}
