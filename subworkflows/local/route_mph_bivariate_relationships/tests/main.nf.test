nextflow_workflow {

    name "Test Subworkflow ROUTE_MPH_BIVARIATE_RELATIONSHIPS"
    script "../main.nf"
    workflow "ROUTE_MPH_BIVARIATE_RELATIONSHIPS"
    config "./nextflow.config"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "route_mph_bivariate_relationships"
    tag "mph"
    tag "relationship"

    // A stub run renders the stub script, so this file asserts topology, cardinality, identity and the guarded
    // joins, and nothing about the rendered native arguments or the fitted numbers. Those belong to the
    // real-mode pipeline route test, which is where `ext.args` and MPH itself actually exist.
    options "-stub"

    def matrixIdentity = { key, plan_key, components ->
        [
            key: key,
            layer: 'base',
            artifact_type: plan_key ? 'mph_ldms' : 'mph_dense',
            settings: plan_key ? [format: 'mph_grm'] : [format: 'mph_grm', variant_universe: 'autosomes'],
            plan_key: plan_key,
            plan_settings: plan_key ? [ld_score_region_kb: 50, ld_bins: 2, maf_edges: [0, 0.5]] : null,
            components: components,
            variant_counts: [bim_rows: 2200, assigned: 2200, unassigned: 0],
        ]
    }

    // The validated relationship meta as `VALIDATE_GWAS_INPUT` hands it over: one row per selected method,
    // sharing one relationship identity, in the orientation the manifest declared.
    def requestMeta = { relationship_id, method, native_args = [] ->
        [
            id: "${method}--${relationship_id}".toString(),
            request_id: "${method}--${relationship_id}".toString(),
            relationship_id: relationship_id,
            method: method,
            relationship_methods: [method],
            cohort: 'example_cohort',
            matrix_kind: method.endsWith('_ldms') ? 'mph_ldms' : 'mph_dense',
            matrix_settings: method.endsWith('_ldms') ? [ld_score_region_kb: 50, ld_bins: 2, maf_edges: [0, 0.5]] : [:],
            left_analysis_id: 'example_qt',
            right_analysis_id: 'example_qt2',
            left_trait_id: 'QT',
            right_trait_id: 'QT2',
            left_trait_type: 'quantitative',
            right_trait_type: 'quantitative',
            left_is_binary: false,
            right_is_binary: false,
            native_args: native_args,
            request_options: [mph: [iterations: null, tolerance: null, random_vectors: null, seed: 7, save_memory: false]],
        ]
    }

    def relationshipMeta = { relationship_id ->
        [
            id: relationship_id,
            request_id: relationship_id,
            relationship_id: relationship_id,
            cohort: 'example_cohort',
            left_analysis_id: 'example_qt',
            right_analysis_id: 'example_qt2',
            left_trait_id: 'QT',
            right_trait_id: 'QT2',
        ]
    }

    def resources = { outputDir, name ->
        [
            bed: RELATIONAL.resource(outputDir, "${name}.bed", 'genotypes\n'),
            bim: RELATIONAL.resource(outputDir, "${name}.bim", '1\trs1\t0\t1\tA\tG\n'),
            fam: RELATIONAL.resource(outputDir, "${name}.fam", 'F1\tS001\t0\t0\t0\t-9\n'),
            phenotype: RELATIONAL.resource(outputDir, "${name}.pheno", 'F1\tS001\t0.5\t1.5\n'),
            noheader_qcovar: RELATIONAL.resource(outputDir, "${name}.noheader.qcovar", 'F1\tS001\t30\n'),
            noheader_catcovar: RELATIONAL.resource(outputDir, "${name}.noheader.catcovar", 'F1\tS001\t1\n'),
            qcovar: RELATIONAL.resource(outputDir, "${name}.qcovar", 'FID\tIID\tAGE\nF1\tS001\t30\n'),
            catcovar: RELATIONAL.resource(outputDir, "${name}.catcovar", 'FID\tIID\tSEX\nF1\tS001\t1\n'),
            dense_bin: RELATIONAL.resource(outputDir, "mph_dense.${name}.grm.bin", 'binary\n'),
            dense_iid: RELATIONAL.resource(outputDir, "mph_dense.${name}.grm.iid", 'S001\n'),
            ldms_bin_1: RELATIONAL.resource(outputDir, "mph_ldms.${name}__000001_ld01_maf01.grm.bin", 'binary\n'),
            ldms_iid_1: RELATIONAL.resource(outputDir, "mph_ldms.${name}__000001_ld01_maf01.grm.iid", 'S001\n'),
            ldms_bin_2: RELATIONAL.resource(outputDir, "mph_ldms.${name}__000002_ld02_maf01.grm.bin", 'binary\n'),
            ldms_iid_2: RELATIONAL.resource(outputDir, "mph_ldms.${name}__000002_ld02_maf01.grm.iid", 'S001\n'),
        ]
    }

    test("one relationship selecting both MPH tokens runs each of them once against its own matrix family") {

        when {
            def files = resources(outputDir, 'both')
            def dense = requestMeta('qt_qt2', 'mph_bivariate_reml')
            def ldms = requestMeta('qt_qt2', 'mph_bivariate_reml_ldms')
            workflow {
                """
                def dense = ${dense.inspect()}
                def ldms = ${ldms.inspect()}
                input[0] = channel.of(
                    [dense, [file('${files.bed}', checkIfExists: true)], file('${files.qcovar}', checkIfExists: true), file('${files.catcovar}', checkIfExists: true)],
                    [ldms, [file('${files.bed}', checkIfExists: true)], file('${files.qcovar}', checkIfExists: true), file('${files.catcovar}', checkIfExists: true)],
                )
                input[1] = channel.of([
                    ${relationshipMeta('qt_qt2').inspect()},
                    file('${files.phenotype}', checkIfExists: true),
                    file('${files.noheader_qcovar}', checkIfExists: true),
                    file('${files.noheader_catcovar}', checkIfExists: true),
                ])
                input[2] = channel.of([
                    ${relationshipMeta('qt_qt2').inspect()},
                    file('${files.qcovar}', checkIfExists: true),
                    file('${files.catcovar}', checkIfExists: true),
                ])
                input[3] = channel.of(
                    [dense, file('${files.bed}', checkIfExists: true), file('${files.bim}', checkIfExists: true), file('${files.fam}', checkIfExists: true)],
                    [ldms, file('${files.bed}', checkIfExists: true), file('${files.bim}', checkIfExists: true), file('${files.fam}', checkIfExists: true)],
                )
                input[4] = channel.of([
                    dense,
                    ${matrixIdentity('dense000001', null, [[ordinal: 1, name: 'all', plan_predictor_count: 2200]]).inspect()},
                    [file('${files.dense_bin}', checkIfExists: true), file('${files.dense_iid}', checkIfExists: true)],
                ])
                input[5] = channel.of([
                    ldms,
                    ${matrixIdentity('ldms000001', 'plan000001', [[ordinal: 1, name: 'ld01_maf01', plan_predictor_count: 1100], [ordinal: 2, name: 'ld02_maf01', plan_predictor_count: 1100]]).inspect()},
                    [
                        file('${files.ldms_bin_1}', checkIfExists: true),
                        file('${files.ldms_iid_1}', checkIfExists: true),
                        file('${files.ldms_bin_2}', checkIfExists: true),
                        file('${files.ldms_iid_2}', checkIfExists: true),
                    ],
                    ['mph_ldms.both__000001_ld01_maf01', 'mph_ldms.both__000002_ld02_maf01'],
                ])
                """
            }
        }

        then {
            def methods = workflow.out.bivariate_results.collect { record -> record[0].method }.sort()
            assertAll(
                { assert workflow.success },
                // One prepared pair reaches two requests, and each request runs the whole chain once. The
                // preparation is shared; the fits and the records are not.
                { assert TRACE.count(workflow, 'PREPARE_MPH_INPUTS') == 2 },
                { assert TRACE.count(workflow, 'MPH_REML') == 2 },
                { assert methods == ['mph_bivariate_reml', 'mph_bivariate_reml_ldms'] },
                // A multi-trait fit produces the correlation result, so every emit is populated for every
                // request rather than only for the stratified one.
                { assert workflow.out.bivariate_results.size() == 2 },
                { assert workflow.out.bivariate_correlations.size() == 2 },
                { assert workflow.out.bivariate_fixed.size() == 2 },
                { assert workflow.out.bivariate_iterations.size() == 2 },
                { assert workflow.out.bivariate_log.size() == 2 },
                // The emitted identity is the request identity the manifest determined, never the matrix key,
                // and none of the state this route minted for its own use survives into it.
                { assert workflow.out.bivariate_results.collect { record -> record[0].id }.sort() == ['mph_bivariate_reml--qt_qt2', 'mph_bivariate_reml_ldms--qt_qt2'] },
                { assert workflow.out.bivariate_results.every { record -> record[0].id == record[0].request_id } },
                { assert workflow.out.bivariate_results.every { record -> record[0].relationship_id == 'qt_qt2' } },
                { assert workflow.out.bivariate_results.every { record -> !record[0].containsKey('matrix_key') } },
                { assert workflow.out.bivariate_results.every { record -> !record[0].containsKey('mph_effective') } },
                { assert workflow.out.bivariate_results.every { record -> !record[0].containsKey('mph_trait_names') } },
                { assert workflow.out.bivariate_results.every { record -> !record[0].containsKey('mph_estimator') } },
            )
        }
    }

    test("a relationship selecting only GCTA pair methods never reaches this controller") {

        when {
            def files = resources(outputDir, 'gctaonly')
            def gcta = requestMeta('qt_qt2', 'gcta_bivariate_reml')
            workflow {
                """
                def gcta = ${gcta.inspect()}
                input[0] = channel.of([gcta, [file('${files.bed}', checkIfExists: true)], [], []])
                input[1] = channel.of([${relationshipMeta('qt_qt2').inspect()}, file('${files.phenotype}', checkIfExists: true), [], []])
                input[2] = channel.of([${relationshipMeta('qt_qt2').inspect()}, [], []])
                input[3] = channel.of([gcta, file('${files.bed}', checkIfExists: true), file('${files.bim}', checkIfExists: true), file('${files.fam}', checkIfExists: true)])
                input[4] = channel.empty()
                input[5] = channel.empty()
                """
            }
        }

        then {
            // Selection is the registry query, so a request whose entry declares another option family is not
            // this controller's work and must produce no task at all rather than an unmatched join.
            assertAll(
                { assert workflow.success },
                { assert TRACE.count(workflow, 'PREPARE_MPH_INPUTS') == 0 },
                { assert TRACE.count(workflow, 'MPH_REML') == 0 },
                { assert workflow.out.bivariate_results.size() == 0 },
            )
        }
    }

    test("a relationship declaring no pair covariates fits the model MPH synthesises an intercept for") {

        when {
            def files = resources(outputDir, 'nocovar')
            def dense = requestMeta('qt_qt2', 'mph_bivariate_reml')
            workflow {
                """
                def dense = ${dense.inspect()}
                input[0] = channel.of([dense, [file('${files.bed}', checkIfExists: true)], [], []])
                input[1] = channel.of([${relationshipMeta('qt_qt2').inspect()}, file('${files.phenotype}', checkIfExists: true), [], []])
                input[2] = channel.of([${relationshipMeta('qt_qt2').inspect()}, [], []])
                input[3] = channel.of([dense, file('${files.bed}', checkIfExists: true), file('${files.bim}', checkIfExists: true), file('${files.fam}', checkIfExists: true)])
                input[4] = channel.of([
                    dense,
                    ${matrixIdentity('dense000002', null, [[ordinal: 1, name: 'all', plan_predictor_count: 2200]]).inspect()},
                    [file('${files.dense_bin}', checkIfExists: true), file('${files.dense_iid}', checkIfExists: true)],
                ])
                input[5] = channel.empty()
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // Absence travels as `[]` all the way to the atom, which is a different model rather than an
                // empty column set: the serializer writes no covariate file, so MPH synthesises its intercept.
                { assert workflow.out.bivariate_results.size() == 1 },
                { assert workflow.out.bivariate_correlations.size() == 1 },
            )
        }
    }

    def guardedJoins = [
        [
            name: 'a selected MPH request with no matrix record',
            matrices: 'channel.empty()',
            genotypes: 'populated',
        ],
        [
            name: 'a selected MPH request with no PLINK 1 bundle',
            matrices: 'populated',
            genotypes: 'channel.empty()',
        ],
    ]

    guardedJoins.each { scenario ->
        test("${scenario.name} fails the run rather than vanishing") {

            when {
                def files = resources(outputDir, "guard_${scenario.name.replaceAll(/[^a-z]/, '')}")
                def dense = requestMeta('qt_qt2', 'mph_bivariate_reml')
                workflow {
                    """
                    def dense = ${dense.inspect()}
                    input[0] = channel.of([dense, [file('${files.bed}', checkIfExists: true)], [], []])
                    input[1] = channel.of([${relationshipMeta('qt_qt2').inspect()}, file('${files.phenotype}', checkIfExists: true), [], []])
                    input[2] = channel.of([${relationshipMeta('qt_qt2').inspect()}, [], []])
                    input[3] = ${scenario.genotypes == 'populated'
                        ? "channel.of([dense, file('${files.bed}', checkIfExists: true), file('${files.bim}', checkIfExists: true), file('${files.fam}', checkIfExists: true)])"
                        : scenario.genotypes}
                    input[4] = ${scenario.matrices == 'populated'
                        ? """channel.of([
                            dense,
                            ${matrixIdentity('dense000003', null, [[ordinal: 1, name: 'all', plan_predictor_count: 2200]]).inspect()},
                            [file('${files.dense_bin}', checkIfExists: true), file('${files.dense_iid}', checkIfExists: true)],
                        ])"""
                        : scenario.matrices}
                    input[5] = channel.empty()
                    """
                }
            }

            then {
                // The guarded joins are the whole reason every ancillary stream is re-keyed on the request
                // identity first: a `combine` would have dropped this request in silence, producing no task,
                // no result and no error.
                assertAll(
                    { assert !workflow.success },
                    { assert workflow.stdout.join('\n').contains('Join mismatch') || workflow.errorReport.contains('Join mismatch') },
                )
            }
        }
    }

    test("a matrix record for a request the relationship stream never declared fails the run") {

        when {
            def files = resources(outputDir, 'orphanmatrix')
            def dense = requestMeta('qt_qt2', 'mph_bivariate_reml')
            def orphan = requestMeta('qt_qt3', 'mph_bivariate_reml')
            workflow {
                """
                def dense = ${dense.inspect()}
                def orphan = ${orphan.inspect()}
                input[0] = channel.of([dense, [file('${files.bed}', checkIfExists: true)], [], []])
                input[1] = channel.of([${relationshipMeta('qt_qt2').inspect()}, file('${files.phenotype}', checkIfExists: true), [], []])
                input[2] = channel.of([${relationshipMeta('qt_qt2').inspect()}, [], []])
                input[3] = channel.of([dense, file('${files.bed}', checkIfExists: true), file('${files.bim}', checkIfExists: true), file('${files.fam}', checkIfExists: true)])
                input[4] = channel.of(
                    [
                        dense,
                        ${matrixIdentity('dense000004', null, [[ordinal: 1, name: 'all', plan_predictor_count: 2200]]).inspect()},
                        [file('${files.dense_bin}', checkIfExists: true), file('${files.dense_iid}', checkIfExists: true)],
                    ],
                    [
                        orphan,
                        ${matrixIdentity('dense000005', null, [[ordinal: 1, name: 'all', plan_predictor_count: 2200]]).inspect()},
                        [file('${files.dense_bin}', checkIfExists: true), file('${files.dense_iid}', checkIfExists: true)],
                    ],
                )
                input[5] = channel.empty()
                """
            }
        }

        then {
            assertAll(
                { assert !workflow.success },
                { assert workflow.stdout.join('\n').contains('Join mismatch') || workflow.errorReport.contains('Join mismatch') },
            )
        }
    }
}
