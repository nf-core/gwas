    test("homo_sapiens popgen - mixed per-fit routes") {
        when {
            workflow {
                """
                def base = params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/'
                def fits = [[id: 'standard'], [id: 'chunked']]
                input[0] = channel.fromList(fits).map { meta -> [meta, file(base + 'plink_simulated.bed'), file(base + 'plink_simulated.bim'), file(base + 'plink_simulated.fam')] }
                input[1] = channel.fromList(fits).map { meta -> [meta, file(base + 'plink_simulated_quantitative_phenoname.phe')] }
                input[2] = channel.fromList(fits).map { meta -> [meta, []] }
                input[3] = channel.fromList(fits).map { meta -> [meta, 1000] }
                input[4] = channel.fromList(fits).map { meta -> [meta, meta.id] }
                input[5] = channel.of([[id: 'standard'], []], [[id: 'chunked'], 5])
                """
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.predictions.collect { it[0] }.sort { it.id } == [[id: 'chunked'], [id: 'standard']] },
                { assert workflow.out.loco.collect { it[0] }.sort { it.id } == [[id: 'chunked'], [id: 'standard']] },
                { assert workflow.out.logs.countBy { it[0].id } == [standard: 1, chunked: 3] },
                {
                    assert snapshot(
                        workflow.out.predictions.collect { [it[0], path(it[1]).getFileName().toString()] }.sort { it[0].id },
                        workflow.out.logs.collect { [it[0], path(it[1]).getFileName().toString()] }.sort { it[0].id + it[1] }
                    ).match()
                }
            )
        }
    }
}
