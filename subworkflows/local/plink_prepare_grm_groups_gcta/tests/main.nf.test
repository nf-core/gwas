nextflow_workflow {

    name "Test the named-group GCTA matrix builder"
    script "../main.nf"
    config "./nextflow.config"
    workflow "PLINK_PREPARE_GRM_GROUPS_GCTA"
    tag "subworkflows"
    tag "subworkflows_nfcore"
    tag "subworkflows/plink_prepare_grm_groups_gcta"
    tag "subworkflows/plink_prepare_grm_gcta"
    tag "gcta"
    tag "groups"

    def taskCount = { execution, process_name ->
        execution.trace.succeeded().count { task -> task.name.split(/ \(/).first().tokenize(':').last().trim() == process_name }
    }

    // The shipped popgen trio is 200 samples by 220 variants on chromosome 1, with no monomorphic variant.
    // Everything keyed to those dimensions — the component plan, its group files and the multi-file manifest —
    // is generated from the trio rather than introducing duplicate fixture content.
    def POPGEN = { member -> "file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.${member}', checkIfExists: true)" }

    // The group table is independent of the scientific method that chose the SNP lists.
    def writePlan = { output_dir, prefix, strata ->
        def root = new File(new File(output_dir.toString()).parentFile, "inputs/${prefix}")
        root.mkdirs()
        def groups = strata.collect { stratum ->
            def target = new File(root, "${prefix}_snp_group_${stratum[0]}.txt")
            target.text = stratum[1].join('\n') + '\n'
            target
        }
        def header = ['group_id', 'group_filename']
        def rows = [strata, groups].transpose().withIndex().collect { pair, index ->
            [pair[0][0], pair[1].name].join('\t')
        }
        def manifest = new File(root, "${prefix}.strata.tsv")
        manifest.text = ([header.join('\t')] + rows).join('\n') + '\n'
        return [manifest: manifest, groups: groups]
    }

    // GCTA takes a multi-file list, not three paths, so the bundle's own basename is what the manifest names.
    def writeMultiFile = { output_dir, prefix ->
        def root = new File(new File(output_dir.toString()).parentFile, "inputs/${prefix}")
        root.mkdirs()
        def manifest = new File(root, "${prefix}.mbfile")
        manifest.text = 'plink_simulated\n'
        return manifest
    }

    def planInput = { meta, plan ->
        """[
                    ${meta},
                    file('${plan.manifest}', checkIfExists: true),
                    [${plan.groups.collect { group -> "file('${group}', checkIfExists: true)" }.join(', ')}],
                ]"""
    }

    def genotypeInput = { meta, multi_file ->
        """[
                    ${meta},
                    file('${multi_file}', checkIfExists: true),
                    ${POPGEN('bed')},
                    ${POPGEN('bim')},
                    ${POPGEN('fam')},
                ]"""
    }

    // The emitted family is one flat path list in component order, so the per-component grouping is recovered
    // by prefix rather than by slicing a fixed stride: `.grm.*` is whatever the merge step wrote.
    def filesByPrefix = { grm_files, grm_prefixes ->
        def names = grm_files.collect { entry -> new File(entry.toString()).name }
        return grm_prefixes.collect { prefix -> names.findAll { name -> name.startsWith("${prefix}.grm.") }.sort() }
    }

    test("a real two-group family follows the declared SNP-list order") {

        when {
            def multi_file = writeMultiFile(outputDir, 'popgen_family')
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                // The plan is derived from the fixture's own BIM inside an operator rather than shipped, so the
                // two group files are guaranteed to name variants this bundle actually carries. The split is a
                // plain halving of the BIM: what is under test is the fan-out and the ordered gather, not the
                // stratifier's quantile rule, which `plink_prepare_ldms_plan_gcta` covers.
                input[0] = channel.of([[id: 'popgen_family'], ${POPGEN('bim')}])
                    .map { record_meta, bim ->
                        def root = new File('${new File(outputDir.toString()).parentFile}/inputs/popgen_family')
                        root.mkdirs()
                        def variants = bim.readLines().findAll { line -> line.trim() }.collect { line -> line.split('\\t')[1] }
                        def keys = ['group_b', 'group_a']
                        def midpoint = variants.size().intdiv(2)
                        def halves = [variants[0..<midpoint], variants[midpoint..<variants.size()]]
                        def groups = [0, 1].collect { index ->
                            def target = new File(root, 'popgen_family_snp_group_' + keys[index] + '.txt')
                            target.text = halves[index].join('\\n') + '\\n'
                            target
                        }
                        def header = ['group_id', 'group_filename']
                        def rows = [0, 1].collect { index ->
                            [keys[index], groups[index].name].join('\\t')
                        }
                        def manifest = new File(root, 'popgen_family.strata.tsv')
                        manifest.text = ([header.join('\\t')] + rows).join('\\n') + '\\n'
                        tuple(record_meta, file(manifest.absolutePath, checkIfExists: true), groups.collect { group -> file(group.absolutePath, checkIfExists: true) })
                    }
                input[1] = channel.of(${genotypeInput("[id: 'popgen_family']", multi_file)})
                input[2] = channel.of([[id: 'popgen_family'], 1])
                """
            }
        }

        then {
            def family = workflow.out.grm_family.first()
            def grouped = filesByPrefix(family[1], family[2])
            def sizes = family[1].collectEntries { entry -> [new File(entry.toString()).name, new File(entry.toString()).length()] }
            assertAll(
                { assert workflow.success },
                { assert taskCount(workflow, 'GCTA_MAKEGRMPART') == 2 },
                { assert taskCount(workflow, 'CUSTOM_GCTAMERGEGRMPARTS') == 2 },
                // The declared group labels, not the internal scatter ordinal alone, name the native matrices.
                { assert family[2] == ['popgen_family__000001_group_b', 'popgen_family__000002_group_a'] },
                { assert grouped == [
                    ['popgen_family__000001_group_b.grm.N.bin', 'popgen_family__000001_group_b.grm.bin', 'popgen_family__000001_group_b.grm.id'],
                    ['popgen_family__000002_group_a.grm.N.bin', 'popgen_family__000002_group_a.grm.bin', 'popgen_family__000002_group_a.grm.id'],
                ] },
                // GCTA's dense GRM is a headerless row-major lower triangle of `float32`, so a complete matrix
                // over the 200 fixture samples is exactly `4*200*201/2` bytes. A stratum built from only half
                // the variants is still a full 200-by-200 matrix, which is what makes the family stackable.
                { assert sizes['popgen_family__000001_group_b.grm.bin'] == 4 * 200 * 201 / 2 },
                { assert sizes['popgen_family__000002_group_a.grm.bin'] == 4 * 200 * 201 / 2 },
                { assert sizes['popgen_family__000001_group_b.grm.N.bin'] == 4 * 200 * 201 / 2 },
                // The two strata cover disjoint halves of the BIM, so their matrices are genuinely different
                // rather than two names for the same construction.
                { assert path(family[1].find { entry -> entry.toString().endsWith('popgen_family__000001_group_b.grm.bin') }).md5
                    != path(family[1].find { entry -> entry.toString().endsWith('popgen_family__000002_group_a.grm.bin') }).md5 },
                { assert family[0] == [id: 'popgen_family'] },
                // GCTA's `--make-grm-part` accumulation was measured to be thread-invariant on this fixture
                // (`--thread-num` 1 and 4 gave one md5), so the family's byte content is snapshot-stable.
                { assert snapshot(workflow.out).match() },
            )
        }
    }

    test("one named group returns the same family contract - stub") {
        options "-stub"
        when {
            def plan = writePlan(outputDir, 'single_family', [['all', ['rs1']]])
            def multi_file = writeMultiFile(outputDir, 'single_family')
            workflow {
                """
                input[0] = channel.of(${planInput("[id: 'single_family']", plan)})
                input[1] = channel.of(${genotypeInput("[id: 'single_family']", multi_file)})
                input[2] = channel.of([[id: 'single_family'], 2])
                """
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.grm_family.first()[0] == [id: 'single_family'] },
                { assert workflow.out.grm_family.first()[2] == ['single_family__000001_all'] },
                { assert taskCount(workflow, 'GCTA_MAKEGRMPART') == 2 },
                { assert taskCount(workflow, 'CUSTOM_GCTAMERGEGRMPARTS') == 1 },
                { assert snapshot(workflow.out).match() },
            )
        }
    }

    test("one real group returns a complete matrix family") {
        when {
            def plan = writePlan(outputDir, 'single_real', [['all', ['snp1']]])
            def multi_file = writeMultiFile(outputDir, 'single_real')
            workflow {
                """
                input[0] = channel.of([[id: 'single_real'], ${POPGEN('bim')}]).map { meta, bim ->
                    def snps = bim.readLines().collect { row -> row.tokenize()[1] }
                    def group = new File('${plan.groups.first()}')
                    group.text = snps.join('\\n') + '\\n'
                    tuple(meta, file('${plan.manifest}', checkIfExists: true), [file(group.absolutePath, checkIfExists: true)])
                }
                input[1] = channel.of(${genotypeInput("[id: 'single_real']", multi_file)})
                input[2] = channel.of([[id: 'single_real'], 1])
                """
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.grm_family.first()[0] == [id: 'single_real'] },
                { assert workflow.out.grm_family.first()[2] == ['single_real__000001_all'] },
                { assert taskCount(workflow, 'GCTA_MAKEGRMPART') == 1 },
                { assert taskCount(workflow, 'CUSTOM_GCTAMERGEGRMPARTS') == 1 },
                { assert snapshot(workflow.out).match() },
            )
        }
    }

    test("a plan with no matching genotype bundle fails rather than being dropped - stub") {

        options "-stub"

        when {
            def plan = writePlan(outputDir, 'orphan_family', [['all', ['rs1']]])
            def multi_file = writeMultiFile(outputDir, 'orphan_family')
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of(${planInput("[id: 'orphan_family']", plan)})
                input[1] = channel.of(${genotypeInput("[id: 'other_family']", multi_file)})
                input[2] = channel.of([[id: 'orphan_family'], 1])
                """
            }
        }

        then {
            // Both joins are guarded in both directions. A plan with no bundle, or a bundle with no plan, means
            // the caller and this composition disagree about which families exist, and building fewer matrices
            // than were requested would leave a stratified estimator short a component with nothing in the
            // output to say so.
            assertAll(
                { assert !workflow.success },
                { assert taskCount(workflow, 'GCTA_MAKEGRMPART') == 0 },
            )
        }
    }
}
