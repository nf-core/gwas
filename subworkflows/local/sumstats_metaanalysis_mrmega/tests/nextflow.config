process {
    cpus   = 2
    memory = 2.GB
    withLabel: process_single {
        cpus   = 2
        memory = 2.GB
    }
    withLabel: process_low {
        cpus   = 2
        memory = 2.GB
    }
    withLabel: process_medium {
        cpus   = 2
        memory = 2.GB
    }
    withLabel: process_high {
        cpus   = 2
        memory = 2.GB
    }
    withName: MRMEGA {
        // Five fixture studies admit at most two axes; MR-MEGA's default of three would be refused.
        ext.args = '--pc 1'
    }
}
