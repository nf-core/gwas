nextflow_function {

    name "Test REGENIE prediction identity"
    script "../main.nf"
    tag "function"
    tag "regenie"
    tag "prediction"

    test("the route-local key covers fitted-model scientific inputs") {
        function "buildRegeniePredictionKey"

        when {
            function {
                """
                def fixtures = '${FIXTURES.base(projectDir)}results/fixtures/pheno_cov/'
                input[0] = 'prepared_view_a'
                input[1] = false
                input[2] = file(fixtures + 'example.pheno', checkIfExists: true)
                input[3] = file(fixtures + 'example.qcovar', checkIfExists: true)
                input[4] = 1000
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == 'df2499de7f9c' },
            )
        }
    }
}
