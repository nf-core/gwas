%%metro file: phenotype_in | TSV | Phenotype
%%metro file: covariates_in | TSV | Covariates
%%metro file: manifests_in | CTRL | Cohort + analysis manifests
%%metro file: harmonised_out | TSV.GZ | Harmonised GWAS
%%metro file: multiqc_out | HTML | MultiQC
%%metro line: plink2 | PLINK 2 | #0570b0
%%metro line: regenie | REGENIE | #2db572
%%metro line: gcta | GCTA | #756bb1
%%metro line: ldak | LDAK | #e6550d
%%metro line: ldak_filtered | LDAK + relatedness filter | #f28e2b
%%metro line: reporting | Shared products | #555555
%%metro legend: bl
%%metro compact_offsets: true
%%metro grid: preparation | 0,0,1,2
%%metro grid: association | 1,0,1,1
%%metro grid: gcta_heritability | 1,1,1,1
