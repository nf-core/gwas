graph LR
    subgraph preparation [Inputs and preparation]
        %%metro exit: right | plink2, regenie, gcta, ldak
        plink1_in[ ]
        vcf_in[ ]
        plink2_in[ ]
        phenotype_in[ ]
        covariates_in[ ]
        manifests_in[ ]
        plink1_import[PLINK 2 --make-pgen (PLINK 1 only)]
        vcf_import[PLINK 2 VCF import]
        normalise[Phenotype and covariate normalisation]
        makebed[PLINK 2 --make-bed]
        _genotypes_ready[hidden]
        _analysis_ready[hidden]

        plink1_in -->|plink2,regenie,gcta,ldak| plink1_import
        plink1_import -->|plink2,regenie,gcta,ldak| _genotypes_ready
        vcf_in -->|plink2,regenie,gcta,ldak| vcf_import
        vcf_import -->|plink2,regenie,gcta,ldak| _genotypes_ready
        plink2_in -->|plink2,regenie,gcta,ldak| _genotypes_ready

        phenotype_in -->|plink2,regenie,gcta,ldak| normalise
        covariates_in -->|plink2,regenie,gcta,ldak| normalise
        manifests_in -->|plink2,regenie,gcta,ldak| _analysis_ready
        _genotypes_ready -->|plink2,regenie,gcta,ldak| _analysis_ready
        normalise -->|plink2,regenie,gcta,ldak| _analysis_ready
        _analysis_ready -->|gcta,ldak| makebed
    end

    subgraph association [Association methods]
        %%metro entry: left | plink2, regenie, gcta, ldak
        %%metro exit: right | plink2, regenie, gcta, ldak
        plink2_glm[PLINK 2 --glm]
        regenie_step1[REGENIE Step 1]
        regenie_step2[REGENIE Step 2]
        gcta_grm[GCTA GRM]
        gcta_sparse[GCTA sparse GRM]
        fastgwa[GCTA fastGWA-MLM]
        ldak_thin[LDAK predictor selection]
        kvik_step1[LDAK-KVIK Step 1]
        kvik_step2[LDAK-KVIK Step 2]
        gwaslab[GWASLab harmonisation]

        _analysis_ready -->|plink2| plink2_glm
        _analysis_ready -->|regenie| regenie_step1
        regenie_step1 -->|regenie| regenie_step2
        makebed -->|gcta| gcta_grm
        gcta_grm -->|gcta| gcta_sparse
        gcta_sparse -->|gcta| fastgwa
        makebed -->|ldak| ldak_thin
        ldak_thin -->|ldak| kvik_step1
        kvik_step1 -->|ldak| kvik_step2

        plink2_glm -->|plink2| gwaslab
        regenie_step2 -->|regenie| gwaslab
        fastgwa -->|gcta| gwaslab
        kvik_step2 -->|ldak| gwaslab
    end

    subgraph gcta_heritability [GCTA heritability]
        %%metro entry: left | gcta
        %%metro exit: top | gcta
        gcta_dense[GCTA dense GRM]
        greml[GCTA GREML]
        gcta_ldms[GCTA LDMS GRMs]
        greml_ldms[GCTA GREML-LDMS]
        gcta_estimates[GCTA heritability estimates]

        makebed -->|gcta| gcta_dense
        gcta_dense -->|gcta| greml
        makebed -->|gcta| gcta_ldms
        gcta_ldms -->|gcta| greml_ldms
        greml -->|gcta| gcta_estimates
        greml_ldms -->|gcta| gcta_estimates
    end

    subgraph ldak_heritability [LDAK heritability]
        %%metro entry: left | ldak
        %%metro exit: right | ldak
        ldak_kinship[LDAK kinship]
        ldak_filter[LDAK relatedness filter / sub-GRM (optional)]
        ldak_reml[LDAK REML]
        ldak_adjust[LDAK adjust-GRM]
        ldak_he[LDAK Haseman-Elston]
        ldak_pcgc[LDAK PCGC]
        ldak_estimates[LDAK heritability estimates]
        _ldak_ready[hidden]

        makebed -->|ldak| ldak_kinship
        ldak_kinship -->|ldak_filtered| ldak_filter
        ldak_kinship -->|ldak| _ldak_ready
        ldak_filter -->|ldak_filtered| _ldak_ready
        _ldak_ready -->|ldak,ldak_filtered| ldak_reml
        _ldak_ready -->|ldak,ldak_filtered| ldak_adjust
        ldak_adjust -->|ldak,ldak_filtered| ldak_he
        ldak_adjust -->|ldak,ldak_filtered| ldak_pcgc
        ldak_reml -->|ldak,ldak_filtered| ldak_estimates
        ldak_he -->|ldak,ldak_filtered| ldak_estimates
        ldak_pcgc -->|ldak,ldak_filtered| ldak_estimates
    end

    subgraph products [Products and reporting]
        %%metro entry: left | gcta, ldak, reporting
        harmonised_out[ ]
        reporting[Run metadata, method summaries and logs]
        multiqc[MultiQC]
        multiqc_out[ ]
        _reporting_1[hidden]
        _reporting_2[hidden]
        _reporting_3[hidden]
        _reporting_4[hidden]

        gwaslab -->|reporting| harmonised_out
        reporting -->|reporting| _reporting_1
        _reporting_1 -->|reporting| _reporting_2
        _reporting_2 -->|reporting| _reporting_3
        _reporting_3 -->|reporting| _reporting_4
        _reporting_4 -->|reporting| multiqc
        gcta_estimates -->|gcta| multiqc
        ldak_estimates -->|ldak| multiqc
        multiqc -->|reporting| multiqc_out
    end
