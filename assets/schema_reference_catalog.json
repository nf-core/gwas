{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/gwas/master/assets/schema_reference_catalog.json",
    "title": "nf-core/gwas pipeline - reference catalog schema",
    "description": "Schema for request-selectable LDSC and LDAK reference bundles.",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "ldsc": {
            "type": "object",
            "description": "Named standalone LDSC reference bundles.",
            "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "genome_build",
                    "ancestry",
                    "variant_id_system",
                    "hapmap3_snplist",
                    "reference_ld_scores",
                    "regression_weights"
                ],
                "properties": {
                    "genome_build": { "type": "string", "enum": ["GRCh37", "GRCh38"] },
                    "ancestry": { "type": "string", "pattern": "^\\S+$" },
                    "variant_id_system": { "type": "string", "pattern": "^\\S+$" },
                    "hapmap3_snplist": { "type": "string", "format": "file-path", "exists": true },
                    "reference_ld_scores": { "type": "string", "format": "file-path", "exists": true },
                    "regression_weights": { "type": "string", "format": "file-path", "exists": true },
                    "hapmap3_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
                    "reference_ld_scores_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
                    "regression_weights_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
                }
            }
        },
        "ldak": {
            "type": "object",
            "description": "Named LDAK tagging bundles.",
            "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["genome_build", "ancestry", "variant_id_system", "model", "tagging_file"],
                "properties": {
                    "genome_build": { "type": "string", "enum": ["GRCh37", "GRCh38"] },
                    "ancestry": { "type": "string", "pattern": "^\\S+$" },
                    "variant_id_system": { "type": "string", "pattern": "^\\S+$" },
                    "model": {
                        "type": "string",
                        "enum": ["BLD-LDAK", "Baseline-LD-v2.2", "LDAK-Thin", "Uniform-GCTA", "Human-Default"]
                    },
                    "tagging_file": { "type": "string", "format": "file-path", "exists": true },
                    "tagging_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
                }
            }
        }
    }
}
